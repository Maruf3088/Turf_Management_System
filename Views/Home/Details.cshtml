@model turf_management_system.DTOs.Turf.TurfResponseDto
@{
    ViewData["Title"] = Model.Name + " - Details";
    var mainImage = Model.MainImageUrl ?? "/images/turf-placeholder.jpg";
}

<!-- Hero Section -->
<section class="turf-hero">
    <div id="turfCarousel" class="carousel slide carousel-fade h-100" data-bs-ride="carousel">
        <div class="carousel-indicators">
            @for (int i = 0; i < Model.Images.Count; i++)
            {
                <button type="button" data-bs-target="#turfCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
            }
        </div>
        <div class="carousel-inner h-100">
            @if (Model.Images.Any())
            {
                @foreach (var img in Model.Images)
                {
                    <div class="carousel-item h-100 @(img.IsMain ? "active" : "")">
                        <img src="@img.ImageUrl" class="d-block w-100 h-100 object-fit-cover" alt="@Model.Name">
                    </div>
                }
            }
            else
            {
                <div class="carousel-item active h-100">
                    <img src="/images/turf-placeholder.jpg" class="d-block w-100 h-100 object-fit-cover" alt="Placeholder">
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#turfCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#turfCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>

    <div class="hero-overlay">
        <div class="container h-100 d-flex flex-column justify-content-end pb-5">
            <div class="animate-up">
                <div class="d-flex gap-2 mb-3">
                    <span class="badge bg-accent text-dark px-3 py-2 fw-bold text-uppercase">@Model.SportType</span>
                    <span class="badge bg-white text-dark px-3 py-2 fw-bold text-uppercase">@Model.TurfSize</span>
                </div>
                <h1 class="display-1 text-white fw-bold mb-2">@Model.Name</h1>
                <p class="text-white-50 fs-5 mb-0"><i class="fas fa-map-marker-alt me-2"></i>@Model.Location, @Model.City</p>
            </div>
        </div>
    </div>
</section>

<!-- Info Bar -->
<div class="info-bar sticky-top shadow-sm animate-up">
    <div class="container d-flex justify-content-between align-items-center h-100">
        <div class="d-flex gap-4 info-items">
            <div class="info-item">
                <span class="label">Price</span>
                <span class="value">৳@Model.PricePerHour<small>/hr</small></span>
            </div>
            <div class="info-item d-none d-md-block">
                <span class="label">Sport</span>
                <span class="value">@Model.SportType</span>
            </div>
            <div class="info-item d-none d-md-block">
                <span class="label">Rating</span>
                <span class="value text-accent"><i class="fas fa-star me-1"></i>4.8</span>
            </div>
        </div>
        <a href="#booking-section" class="btn btn-accent px-4 py-2 fw-bold">Book Now</a>
    </div>
</div>

<div class="container mt-5 pt-3">
    <div class="row g-5">
        <!-- Main Content -->
        <div class="col-lg-8 animate-up">
            <div class="mb-5">
                <h3 class="display-font mb-4">About the Turf</h3>
                <p class="text-muted fs-5 leading-relaxed">@Model.Description</p>
            </div>

            <div class="mb-5">
                <h3 class="display-font mb-4">Amenities</h3>
                <div class="d-flex flex-wrap gap-3">
                    @if (!string.IsNullOrEmpty(Model.Amenities))
                    {
                        @foreach (var amenity in Model.Amenities.Split(','))
                        {
                            <div class="amenity-chip">
                                @{
                                    var icon = amenity.Trim().ToLower() switch {
                                        "parking" => "fa-parking",
                                        "washroom" => "fa-restroom",
                                        "lighting" => "fa-lightbulb",
                                        "cafeteria" => "fa-coffee",
                                        _ => "fa-check-circle"
                                    };
                                }
                                <i class="fas @icon me-2 text-primary"></i>
                                <span>@amenity.Trim()</span>
                            </div>
                        }
                    }
                </div>
            </div>

            <div id="booking-section" class="mb-5 pt-4">
                <h3 class="display-font mb-4">Available Slots</h3>
                <div class="card p-4 border-0 bg-white">
                    <div class="d-flex gap-2 overflow-x-auto pb-3 mb-4" id="day-tabs">
                        @for (int i = 0; i < 7; i++)
                        {
                            var date = DateTime.Today.AddDays(i);
                            <button class="btn btn-day @(i == 0 ? "active" : "")" 
                                    onclick="loadAvailableSlots('@date.ToString("yyyy-MM-dd")', this)">
                                <span class="day">@date.ToString("ddd")</span>
                                <span class="date">@date.Day</span>
                            </button>
                        }
                    </div>

                    <div id="slots-container" class="row g-3">
                        <!-- Slots will be loaded here via AJAX -->
                        <div class="text-center py-4">
                            <span class="spinner-border text-primary"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-5">
                <h3 class="display-font mb-4">Location</h3>
                <div class="rounded-4 overflow-hidden shadow-sm" style="height: 400px; background: #eee;">
                    <!-- Placeholder for Map -->
                    <div class="h-100 d-flex flex-column align-items-center justify-content-center text-muted">
                        <i class="fas fa-map-marked-alt fa-3x mb-3"></i>
                        <p>Interactive Map Integration Coming Soon</p>
                        <p class="small">@Model.Location, @Model.City</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar / Booking Card -->
        <div class="col-lg-4">
            <div class="sticky-sidebar">
                <div class="card p-4 border-0 shadow-lg">
                    <h4 class="display-font mb-4">Reserve Your Slot</h4>
                    
                    <form id="booking-form">
                        <input type="hidden" name="TurfId" value="@Model.Id" />
                        <input type="hidden" name="SlotId" id="selected-slot-id" required />
                        
                        <div class="mb-4">
                            <label class="form-label fw-bold small text-uppercase ls-1">Selected Date</label>
                            <input type="text" id="display-date" class="form-control bg-light" readonly value="@DateTime.Today.ToString("MMM dd, yyyy")" />
                            <input type="hidden" name="BookingDate" id="booking-date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>

                        <div id="selection-summary" style="display: none;">
                            <div class="p-3 bg-light rounded-3 mb-4 border-start border-4 border-accent">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted small">Time Slot</span>
                                    <span class="fw-bold" id="summary-time">--</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted small">Price per Hour</span>
                                    <span class="fw-bold text-primary">৳@Model.PricePerHour</span>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold small text-uppercase ls-1">Special Request</label>
                                <textarea name="SpecialRequest" class="form-control" rows="2" placeholder="Any requests?"></textarea>
                            </div>

                            <div class="border-top pt-3 mb-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fs-5 fw-bold">Total Amount</span>
                                    <span class="fs-4 fw-bold text-primary" id="summary-total">৳0</span>
                                </div>
                            </div>
                        </div>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <button type="submit" id="btn-proceed" class="btn btn-primary w-100 py-3 fw-bold" disabled>
                                Proceed to Book
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-primary w-100 py-3 fw-bold">
                                Login to Book
                            </a>
                        }
                    </form>

                    <div class="mt-4 pt-4 border-top">
                        <div class="d-flex align-items-center">
                            <div class="avatar-sm me-3">@Model.OwnerName[0]</div>
                            <div>
                                <p class="mb-0 fw-bold">@Model.OwnerName</p>
                                <p class="mb-0 text-muted small">Verified Turf Owner</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .turf-hero { height: 520px; position: relative; overflow: hidden; }
        .hero-overlay {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(to bottom, transparent, rgba(0,0,0,0.8));
            pointer-events: none;
        }

        .info-bar { 
            background: white; 
            height: 80px; 
            z-index: 1020; 
            top: 70px; /* Offset for main navbar */
        }
        .info-item .label { display: block; font-size: 11px; text-transform: uppercase; color: var(--color-text-muted); font-weight: 600; }
        .info-item .value { font-size: 18px; font-weight: 700; color: var(--color-primary); }

        .amenity-chip {
            background: white;
            border: 1px solid var(--color-border);
            padding: 10px 20px;
            border-radius: 50px;
            display: flex;
            align-items: center;
            font-size: 14px;
            font-weight: 500;
        }

        .btn-day {
            min-width: 70px;
            height: 80px;
            background: white;
            border: 1px solid var(--color-border);
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }
        .btn-day.active { background: var(--color-primary); border-color: var(--color-primary); color: white; }
        .btn-day .day { font-size: 12px; font-weight: bold; text-transform: uppercase; margin-bottom: 4px; }
        .btn-day .date { font-size: 20px; font-weight: 800; }

        /* Premium Slot Card Layout */
        .slot-card {
            background: #ffffff;
            border: 2px solid #e2e8f0;
            border-radius: 16px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }
        .slot-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; height: 4px;
            background: transparent;
            transition: all 0.3s;
        }

        /* Available Style */
        .slot-card.available {
            border-color: #b9f6ca;
            background: #f0fdf4;
        }
        .slot-card.available::before {
            background: #00e676;
        }
        .slot-card.available:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 20px -8px rgba(0, 230, 118, 0.25);
            border-color: #00e676;
        }
        .slot-card.available .slot-badge {
            background: #e8f5e9;
            color: #2e7d32;
            border: 1px solid #c8e6c9;
        }

        /* Selected Style (Active selection by current user) */
        .slot-card.selected, .slot-card.active {
            border-color: #ffb300 !important;
            background: #fff8e1 !important;
            transform: scale(1.02);
            box-shadow: 0 8px 16px -4px rgba(255, 179, 0, 0.3) !important;
        }
        .slot-card.selected::before, .slot-card.active::before {
            background: #ffb300 !important;
        }
        .slot-card.selected .slot-badge, .slot-card.active .slot-badge {
            background: #ffb300;
            color: #ffffff;
            border: 1px solid #ffb300;
            font-weight: 700;
        }

        /* In Progress Style (Reserved/locked by another user) */
        .slot-card.in-progress {
            border-color: #ffe082;
            background: #fffde7;
            cursor: not-allowed;
            opacity: 0.85;
        }
        .slot-card.in-progress::before {
            background: #f57f17;
        }
        .slot-card.in-progress .slot-badge {
            background: #fffde7;
            color: #f57f17;
            border: 1px solid #fff59d;
        }

        /* Booked Style */
        .slot-card.booked {
            border-color: #ffcdd2;
            background: #ffebee;
            cursor: not-allowed;
            opacity: 0.75;
        }
        .slot-card.booked::before {
            background: #d32f2f;
        }
        .slot-card.booked .slot-badge {
            background: #ffebee;
            color: #c62828;
            border: 1px solid #ffcdd2;
        }

        /* Blocked (Unavailable) Style */
        .slot-card.blocked {
            border-color: #cfd8dc;
            background: #eceff1;
            cursor: not-allowed;
            opacity: 0.6;
        }
        .slot-card.blocked::before {
            background: #37474f;
        }
        .slot-card.blocked .slot-badge {
            background: #eceff1;
            color: #37474f;
            border: 1px solid #b0bec5;
        }

        .slot-card.disabled {
            pointer-events: none;
        }

        /* Inner Slot Elements */
        .slot-time {
            font-weight: 700;
            font-size: 14px;
            color: #1a202c;
            margin-bottom: 6px;
        }
        .slot-shift {
            font-size: 11px;
            font-weight: 600;
            color: #718096;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 10px;
        }
        .slot-price {
            font-size: 20px;
            font-weight: 800;
            color: #1a3c34;
            margin-bottom: 12px;
        }
        .slot-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 6px 12px;
            border-radius: 30px;
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            align-self: center;
            width: fit-content;
            margin: 0 auto;
        }

        .sticky-sidebar { position: sticky; top: 170px; }

        .avatar-sm {
            width: 44px; height: 44px;
            background: var(--color-primary-light);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 18px;
        }

        .ls-1 { letter-spacing: 0.05em; }
        .leading-relaxed { line-height: 1.8; }
    </style>
}

@section Scripts {
    <script>
        const turfPrice = @Model.PricePerHour;
        
        async function loadAvailableSlots(date, btn) {
            // Update active state
            if (btn) {
                document.querySelectorAll('.btn-day').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
            }

            const container = document.getElementById('slots-container');
            container.innerHTML = `
                <div class="col-12 text-center py-5">
                    <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;"></div>
                    <p class="text-muted animate-pulse">Synchronizing with live calendar...</p>
                </div>
            `;
            
            document.getElementById('booking-date').value = date;
            document.getElementById('display-date').value = new Date(date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            
            // Reset selection state
            document.getElementById('selected-slot-id').value = '';
            document.getElementById('selection-summary').style.display = 'none';
            document.getElementById('btn-proceed').disabled = true;

            try {
                // Ensure correct relative URL and parameters
                const response = await fetch(`/api/bookings/slots/@Model.Id?date=${date}`);
                if (!response.ok) throw new Error('Network response was not ok');
                
                const result = await response.json();
                
                if (result.success) {
                    container.innerHTML = '';
                    const slots = result.data || [];
                    
                    if (slots.length === 0) {
                        container.innerHTML = `
                            <div class="col-12 text-center py-5 bg-light rounded-4">
                                <i class="fas fa-calendar-times fa-3x text-muted mb-3 opacity-25"></i>
                                <h5 class="text-muted">No Slots Available</h5>
                                <p class="small mb-0">The turf might be closed or fully booked on this date.</p>
                            </div>
                        `;
                    } else {
                        slots.forEach(slot => {
                            // Status mapping: 0=Available, 1=Selected, 2=InProgress, 3=Booked, 4=Unavailable
                            const status = slot.status;
                            let statusText = 'Available';
                            let cssClass = 'available';
                            let statusIcon = '<i class="fas fa-check-circle me-1"></i>';
                            let clickHandler = `selectSlot(this, '${slot.slotId}', '${slot.startTimeDisplay} – ${slot.endTimeDisplay}', ${slot.price})`;

                            if (status === 1) { // Selected
                                statusText = 'Selected';
                                cssClass = 'selected';
                                statusIcon = '<i class="fas fa-star me-1"></i>';
                            } else if (status === 2) { // InProgress
                                statusText = 'In Progress';
                                cssClass = 'disabled in-progress';
                                statusIcon = '<i class="fas fa-spinner fa-spin me-1"></i>';
                                clickHandler = '';
                            } else if (status === 3) { // Booked
                                statusText = 'Booked';
                                cssClass = 'disabled booked';
                                statusIcon = '<i class="fas fa-ban me-1"></i>';
                                clickHandler = '';
                            } else if (status === 4) { // Unavailable
                                statusText = 'Blocked';
                                cssClass = 'disabled blocked';
                                statusIcon = '<i class="fas fa-minus-circle me-1"></i>';
                                clickHandler = '';
                            }

                            const col = document.createElement('div');
                            col.className = 'col-md-3 col-sm-4 col-6';
                            col.innerHTML = `
                                <div class="slot-card ${cssClass}" onclick="${clickHandler}" data-slot-id="${slot.slotId}">
                                    <div class="slot-time">${slot.startTimeDisplay} – ${slot.endTimeDisplay}</div>
                                    <div class="slot-shift">${slot.pricingVariant}</div>
                                    <div class="slot-price">৳${Math.round(slot.price)}</div>
                                    <div class="slot-badge">${statusIcon} ${statusText}</div>
                                </div>
                            `;
                            container.appendChild(col);
                        });
                    }
                } else {
                    throw new Error(result.message || 'Failed to load slots');
                }
            } catch (error) {
                console.error('Slot loading error:', error);
                container.innerHTML = `
                    <div class="col-12 text-center py-5">
                        <div class="alert alert-danger d-inline-block">
                            <i class="fas fa-exclamation-triangle me-2"></i> Failed to sync slots. 
                            <button class="btn btn-link btn-sm p-0 ms-2" onclick="loadAvailableSlots('${date}')">Try Again</button>
                        </div>
                    </div>
                `;
                toastr.error('Synchronization failed. Please check your connection.');
            }
        }

        function selectSlot(el, id, timeRange, price) {
            document.querySelectorAll('.slot-card').forEach(p => {
                p.classList.remove('active');
                p.classList.remove('selected');
            });
            el.classList.add('active');
            el.classList.add('selected');
            
            document.getElementById('selected-slot-id').value = id;
            document.getElementById('summary-time').innerText = timeRange;
            document.getElementById('summary-total').innerText = '৳' + price.toLocaleString();
            
            document.getElementById('selection-summary').style.display = 'block';
            document.getElementById('btn-proceed').disabled = false;
        }

        document.getElementById('booking-form').addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = document.getElementById('btn-proceed');
            const originalHtml = btn.innerHTML;
            
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Locking Slot...';

            const payload = {
                TurfId: "@Model.Id",
                SlotId: document.getElementById('selected-slot-id').value,
                BookingDate: document.getElementById('booking-date').value,
                SpecialRequest: this.querySelector('[name="SpecialRequest"]').value
            };

            try {
                const response = await fetch('/api/bookings/lock', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                if (result.success) {
                    toastr.success('Success! Slot reserved for 5 minutes.');
                    // Redirect to payment/confirmation as per routing
                    setTimeout(() => {
                        window.location.href = `/Booking/Confirmation/${result.bookingId || result.BookingId}`;
                    }, 800);
                } else {
                    toastr.error(result.message || 'Reservation failed. Slot might have been taken.');
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                    // Auto-refresh slots
                    loadAvailableSlots(payload.BookingDate);
                }
            } catch (error) {
                toastr.error('A system error occurred. Please refresh and try again.');
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        });

        // Initial Load
        loadAvailableSlots('@DateTime.Today.ToString("yyyy-MM-dd")');
    </script>
}
