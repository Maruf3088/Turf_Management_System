@model turf_management_system.Models.ViewModels.OwnerProfileVM
@{
    ViewData["Title"] = Model.BusinessName + " – Owner Profile";
    var initial = string.IsNullOrEmpty(Model.OwnerName) ? "?" : Model.OwnerName[0].ToString().ToUpper();
    var totalTurfs = Model.Turfs.Count;
}

@section Styles {
<style>
    /* ── Hero ──────────────────────────────────────────── */
    .owner-hero {
        background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%);
        padding: 80px 0 60px;
        position: relative;
        overflow: hidden;
    }
    .owner-hero::before {
        content: '';
        position: absolute;
        top: -60px; right: -60px;
        width: 350px; height: 350px;
        background: radial-gradient(circle, rgba(201,168,76,0.18) 0%, transparent 70%);
        border-radius: 50%;
    }
    .owner-hero::after {
        content: '';
        position: absolute;
        bottom: -80px; left: -40px;
        width: 280px; height: 280px;
        background: radial-gradient(circle, rgba(44,178,188,0.12) 0%, transparent 70%);
        border-radius: 50%;
    }

    /* ── Avatar ─────────────────────────────────────────── */
    .owner-avatar {
        width: 110px; height: 110px;
        border-radius: 50%;
        background: linear-gradient(135deg, #E5BA44, #C9A84C);
        color: #0f1c18;
        font-size: 2.8rem;
        font-weight: 900;
        display: flex; align-items: center; justify-content: center;
        border: 4px solid rgba(255,255,255,0.2);
        box-shadow: 0 8px 32px rgba(201,168,76,0.35);
        flex-shrink: 0;
    }

    /* ── Status Badge ───────────────────────────────────── */
    .status-pill {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 5px 14px;
        border-radius: 50px;
        font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .status-pill.active   { background: rgba(34,197,94,0.15);  color: #22c55e; border: 1px solid rgba(34,197,94,0.3); }
    .status-pill.inactive { background: rgba(239,68,68,0.15);  color: #ef4444; border: 1px solid rgba(239,68,68,0.3); }

    /* ── Stat Boxes ─────────────────────────────────────── */
    .stat-box {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 14px;
        padding: 18px 28px;
        text-align: center;
        backdrop-filter: blur(6px);
        transition: transform 0.25s, background 0.25s;
    }
    .stat-box:hover { transform: translateY(-3px); background: rgba(255,255,255,0.1); }
    .stat-value { font-size: 2rem; font-weight: 900; color: #E5BA44; line-height: 1; }
    .stat-label { font-size: 0.72rem; color: rgba(255,255,255,0.55); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 4px; }

    /* ── Info Card ──────────────────────────────────────── */
    .info-card {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.07);
        padding: 28px;
        border: 1px solid rgba(0,0,0,0.06);
    }
    .info-row { display: flex; align-items: center; gap: 14px; padding: 14px 0; border-bottom: 1px solid #f1f5f9; }
    .info-row:last-child { border-bottom: none; padding-bottom: 0; }
    .info-icon-box {
        width: 42px; height: 42px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }

    /* ── Turf Cards ─────────────────────────────────────── */
    .turf-card {
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        transition: transform 0.28s cubic-bezier(0.16,1,0.3,1), box-shadow 0.28s;
        border: 1px solid rgba(0,0,0,0.06);
        position: relative;
        background: #fff;
        height: 100%;
    }
    .turf-card:hover { transform: translateY(-6px); box-shadow: 0 16px 40px rgba(0,0,0,0.13); }

    .turf-card-img-wrap {
        position: relative;
        overflow: hidden;
        height: 220px;
    }
    .turf-card-img-wrap img {
        width: 100%; height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }
    .turf-card:hover .turf-card-img-wrap img { transform: scale(1.06); }

    .turf-img-overlay {
        position: absolute; inset: 0;
        background: linear-gradient(to bottom, transparent 40%, rgba(0,0,0,0.65) 100%);
    }
    .turf-badge-overlay {
        position: absolute;
        top: 12px; right: 12px;
        background: rgba(0,0,0,0.55);
        color: #fff;
        border-radius: 50px;
        padding: 4px 12px;
        font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
        backdrop-filter: blur(4px);
    }
    .blocked-banner {
        position: absolute;
        bottom: 0; left: 0; right: 0;
        background: rgba(220,38,38,0.85);
        color: #fff;
        text-align: center;
        font-size: 0.78rem; font-weight: 700; text-transform: uppercase;
        padding: 8px;
        backdrop-filter: blur(2px);
        letter-spacing: 0.08em;
    }

    .turf-card-body { padding: 18px 20px; }
    .turf-name { font-size: 1.05rem; font-weight: 800; color: #1e293b; margin-bottom: 4px; }
    .turf-location { font-size: 0.8rem; color: #64748b; margin-bottom: 10px; }
    .turf-price-badge {
        display: inline-block;
        background: linear-gradient(135deg, #fef3c7, #fde68a);
        color: #92400e;
        border-radius: 8px;
        padding: 4px 10px;
        font-size: 0.78rem; font-weight: 700;
        border: 1px solid #fcd34d;
    }

    .btn-visit {
        background: linear-gradient(135deg, #E5BA44, #C9A84C);
        border: none; color: #0f1c18 !important;
        font-weight: 700; font-size: 0.8rem;
        border-radius: 10px;
        padding: 8px 18px;
        transition: all 0.25s;
    }
    .btn-visit:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(201,168,76,0.35); }

    /* ── Empty State ────────────────────────────────────── */
    .empty-state {
        background: #f8fafc;
        border-radius: 18px;
        border: 2px dashed #e2e8f0;
        padding: 64px 40px;
        text-align: center;
    }
    .blocked-owner-alert {
        background: linear-gradient(135deg, #fef2f2, #fff);
        border: 2px solid #fca5a5;
        border-radius: 16px;
        padding: 20px 24px;
    }
</style>
}

<!-- ══════════════════════════════════════════════════════ -->
<!--  OWNER HERO                                           -->
<!-- ══════════════════════════════════════════════════════ -->
<section class="owner-hero">
    <div class="container position-relative" style="z-index:2;">
        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center gap-4">
            <!-- Avatar -->
            <div class="owner-avatar">@initial</div>

            <!-- Info -->
            <div class="flex-grow-1 text-white">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="status-pill @(Model.IsActive ? "active" : "inactive")">
                        <i class="fas fa-circle fa-xs"></i>
                        @(Model.IsActive ? "Active Venue Partner" : "Temporarily Closed")
                    </span>
                    <span class="badge bg-white bg-opacity-10 text-white border border-white border-opacity-25 px-3 py-1" style="font-size:0.72rem;">
                        <i class="fas fa-calendar-check me-1 text-warning"></i>
                        Member since @Model.MemberSince.Year
                    </span>
                </div>

                <h1 class="display-5 fw-black mb-1" style="font-family:'Outfit',sans-serif; letter-spacing:-0.5px;">@Model.BusinessName</h1>
                <p class="text-white-50 mb-3 fs-5">by @Model.OwnerName</p>

                @if (!string.IsNullOrEmpty(Model.BusinessAddress))
                {
                    <p class="text-white-50 small mb-0">
                        <i class="fas fa-map-marker-alt me-2 text-warning"></i>@Model.BusinessAddress
                    </p>
                }
            </div>

            <!-- Stat boxes -->
            <div class="d-flex gap-3 flex-shrink-0">
                <div class="stat-box">
                    <div class="stat-value">@totalTurfs</div>
                    <div class="stat-label">Active Venues</div>
                </div>
                <div class="stat-box">
                    <div class="stat-value">
                        <i class="fas fa-shield-halved" style="font-size:1.5rem;"></i>
                    </div>
                    <div class="stat-label">Verified Owner</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ══════════════════════════════════════════════════════ -->
<!--  MAIN CONTENT                                         -->
<!-- ══════════════════════════════════════════════════════ -->
<div class="container py-5">
    <div class="row g-4">

        <!-- LEFT SIDEBAR — Contact Info -->
        <div class="col-lg-3">
            <div class="info-card mb-3">
                <h6 class="fw-bold text-uppercase text-muted mb-3" style="font-size:0.72rem; letter-spacing:0.1em;">
                    <i class="fas fa-address-card me-2 text-warning"></i>Owner Details
                </h6>

                <div class="info-row">
                    <div class="info-icon-box" style="background:#fef3c7;">
                        <i class="fas fa-building text-warning"></i>
                    </div>
                    <div>
                        <div class="text-muted" style="font-size:0.72rem;">Business Name</div>
                        <div class="fw-bold text-dark" style="font-size:0.9rem;">@Model.BusinessName</div>
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-icon-box" style="background:#eff6ff;">
                        <i class="fas fa-user text-primary"></i>
                    </div>
                    <div>
                        <div class="text-muted" style="font-size:0.72rem;">Contact Person</div>
                        <div class="fw-bold text-dark" style="font-size:0.9rem;">@Model.OwnerName</div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.ContactNumber))
                {
                    <div class="info-row">
                        <div class="info-icon-box" style="background:#f0fdf4;">
                            <i class="fas fa-phone text-success"></i>
                        </div>
                        <div>
                            <div class="text-muted" style="font-size:0.72rem;">Phone</div>
                            <div class="fw-bold text-dark" style="font-size:0.9rem;">@Model.ContactNumber</div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.BusinessAddress))
                {
                    <div class="info-row">
                        <div class="info-icon-box" style="background:#fdf4ff;">
                            <i class="fas fa-location-dot text-purple" style="color:#a855f7;"></i>
                        </div>
                        <div>
                            <div class="text-muted" style="font-size:0.72rem;">Address</div>
                            <div class="fw-semibold text-dark" style="font-size:0.85rem;">@Model.BusinessAddress</div>
                        </div>
                    </div>
                }

                <div class="info-row">
                    <div class="info-icon-box" style="background:#fff7ed;">
                        <i class="fas fa-calendar text-orange" style="color:#f97316;"></i>
                    </div>
                    <div>
                        <div class="text-muted" style="font-size:0.72rem;">Member Since</div>
                        <div class="fw-bold text-dark" style="font-size:0.9rem;">@Model.MemberSince.ToString("MMM yyyy")</div>
                    </div>
                </div>
            </div>

            @if (!Model.IsActive)
            {
                <div class="blocked-owner-alert">
                    <div class="d-flex align-items-start gap-2">
                        <i class="fas fa-ban text-danger mt-1"></i>
                        <div>
                            <p class="fw-bold text-danger mb-1" style="font-size:0.85rem;">Owner Deactivated</p>
                            <p class="text-muted mb-0" style="font-size:0.78rem;">This owner's account is currently under an administrative hold. Booking is disabled.</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- RIGHT COLUMN — Turfs Grid -->
        <div class="col-lg-9">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h2 class="fw-black mb-1" style="font-family:'Outfit',sans-serif;">
                        <i class="fas fa-layer-group me-2 text-warning"></i>Listed Venues
                    </h2>
                    <p class="text-muted mb-0 small">@totalTurfs @(totalTurfs == 1 ? "turf" : "turfs") listed by this owner</p>
                </div>
                <a asp-controller="Home" asp-action="AllTurfs" class="btn btn-outline-secondary btn-sm rounded-3">
                    <i class="fas fa-search me-1"></i> Browse All Turfs
                </a>
            </div>

            @if (!Model.Turfs.Any())
            {
                <div class="empty-state">
                    <i class="fas fa-futbol fa-4x text-muted mb-4 opacity-25"></i>
                    <h4 class="fw-bold text-muted">No Active Venues</h4>
                    <p class="text-muted small">This owner hasn't listed any approved turfs yet.</p>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var turf in Model.Turfs)
                    {
                        var mainImg = turf.MainImageUrl ?? turf.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl
                                       ?? turf.Images.FirstOrDefault()?.ImageUrl
                                       ?? "/images/turf-placeholder.jpg";
                        var sportIcon = turf.SportType?.ToLower() switch {
                            "cricket"   => "fa-baseball-bat-ball",
                            "badminton" => "fa-table-tennis-paddle-ball",
                            _           => "fa-futbol"
                        };
                        <div class="col-md-6 col-xl-4">
                            <div class="turf-card">
                                <!-- Image -->
                                <div class="turf-card-img-wrap">
                                    <img src="@mainImg" alt="@turf.Name" />
                                    <div class="turf-img-overlay"></div>
                                    <span class="turf-badge-overlay">
                                        <i class="fas @sportIcon me-1"></i>@turf.SportType
                                    </span>
                                    @if (turf.IsBlocked)
                                    {
                                        <div class="blocked-banner">
                                            <i class="fas fa-lock me-1"></i>CLOSED / BLOCKED
                                        </div>
                                    }
                                </div>

                                <!-- Body -->
                                <div class="turf-card-body">
                                    <!-- Image thumbnails strip (if multiple) -->
                                    @if (turf.Images.Count > 1)
                                    {
                                        <div class="d-flex gap-1 mb-3 overflow-hidden" style="border-radius:8px;">
                                            @foreach (var img in turf.Images.Take(4))
                                            {
                                                <img src="@img.ImageUrl" alt="" 
                                                     style="width:48px; height:36px; object-fit:cover; border-radius:6px; border:2px solid @(img.IsMain ? "#E5BA44" : "transparent");" />
                                            }
                                            @if (turf.Images.Count > 4)
                                            {
                                                <div style="width:48px; height:36px; border-radius:6px; background:#f1f5f9; display:flex; align-items:center; justify-content:center; font-size:0.7rem; color:#64748b; font-weight:700;">
                                                    +@(turf.Images.Count - 4)
                                                </div>
                                            }
                                        </div>
                                    }

                                    <div class="turf-name">@turf.Name</div>
                                    <div class="turf-location">
                                        <i class="fas fa-map-marker-alt me-1 text-danger"></i>@turf.Location, @turf.City
                                    </div>

                                    <div class="d-flex align-items-center justify-content-between mt-2">
                                        <span class="turf-price-badge">
                                            <i class="fas fa-tag me-1"></i>৳@turf.PricePerHour/hr
                                        </span>
                                        @if (!turf.IsBlocked)
                                        {
                                            <a asp-controller="Home" asp-action="Details" asp-route-id="@turf.Id" class="btn-visit">
                                                View Details <i class="fas fa-arrow-right ms-1"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size:0.7rem;">
                                                <i class="fas fa-ban me-1"></i>Unavailable
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</div>
