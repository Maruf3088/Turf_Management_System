@{
    Layout = "_TurfOwnerLayout";
    ViewData["Title"] = "Turf Bookings";
}

<div class="animate-up">
    <div class="row mb-5 align-items-center">
        <div class="col-md-6">
            <h1 class="display-font">Turf Bookings</h1>
            <p class="text-muted">Monitor and manage player reservations for your turfs.</p>
        </div>
        <div class="col-md-6 text-md-end">
            <div class="d-inline-block text-start" style="width: 250px;">
                <label class="small fw-bold text-uppercase ls-1 text-muted">Select Turf</label>
                <select id="turf-selector" class="form-select border-0 shadow-sm" onchange="loadBookings()">
                    <!-- Options loaded via AJAX -->
                    <option value="">All My Turfs</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Tab Filters -->
    <div class="d-flex gap-2 mb-4 overflow-x-auto pb-2">
        <button class="btn btn-tab active" onclick="setStatusFilter(null, this)">All</button>
        <button class="btn btn-tab" onclick="setStatusFilter(0, this)">Pending</button>
        <button class="btn btn-tab" onclick="setStatusFilter(1, this)">Confirmed</button>
        <button class="btn btn-tab" onclick="setStatusFilter(4, this)">Completed</button>
        <button class="btn btn-tab" onclick="setStatusFilter(3, this)">Cancelled</button>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Player</th>
                        <th>Turf</th>
                        <th>Date & Time</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody id="bookings-tbody">
                    <tr><td colspan="6" class="text-center py-5"><span class="spinner-border text-primary"></span></td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    <nav class="mt-4" id="pagination-nav" style="display: none;">
        <ul class="pagination justify-content-center gap-2" id="pagination-list">
        </ul>
    </nav>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 p-4 pb-0">
                <h5 class="display-font">Reject Booking</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted small">Please provide a reason for rejecting this booking. This will be visible to the player.</p>
                <textarea id="reject-reason" class="form-control" rows="3" placeholder="e.g. Turf maintenance scheduled for this slot."></textarea>
            </div>
            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btn-confirm-reject" class="btn btn-danger rounded-pill px-4">Confirm Reject</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .btn-tab {
            background: white;
            border: 1px solid var(--color-border);
            border-radius: 50px;
            padding: 8px 24px;
            font-weight: 500;
            color: var(--color-text-muted);
            white-space: nowrap;
        }
        .btn-tab.active {
            background: var(--color-primary);
            color: white;
            border-color: var(--color-primary);
        }

        .avatar-initials {
            width: 40px; height: 40px;
            background: var(--color-bg);
            color: var(--color-primary);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-weight: bold; font-size: 14px;
        }

        .badge-status {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
        }
        .status-0 { background: #FEF3C7; color: #92400E; }
        .status-1 { background: #DCFCE7; color: #166534; }
        .status-2 { background: #FEE2E2; color: #991B1B; }
        .status-3 { background: #F3F4F6; color: #374151; }
        .status-4 { background: #DBEAFE; color: #1E40AF; }

        .ls-1 { letter-spacing: 0.05em; }
    </style>
}

@section Scripts {
    <script>
        let currentStatus = null;
        let currentPage = 1;
        let activeBookingId = null;

        async function loadMyTurfs() {
            const selector = document.getElementById('turf-selector');
            const response = await fetch('/api/turfs/my-turfs');
            const result = await response.json();
            
            if (result.success) {
                result.data.forEach(t => {
                    const opt = document.createElement('option');
                    opt.value = t.id;
                    opt.innerText = t.name;
                    selector.appendChild(opt);
                });
            }
        }

        async function loadBookings() {
            const tbody = document.getElementById('bookings-tbody');
            tbody.innerHTML = '<tr><td colspan="6" class="text-center py-5"><span class="spinner-border text-primary"></span></td></tr>';
            
            const turfId = document.getElementById('turf-selector').value;
            let url = turfId 
                ? \`/api/bookings/turf/\${turfId}?pageNumber=\${currentPage}&pageSize=10\`
                : \`/api/bookings/my?pageNumber=\${currentPage}&pageSize=10\`; // Fallback to a different endpoint if no turf selected or handle differently
            
            // Note: In a real app, I'd need an endpoint like api/bookings/owner/all
            // For now, let's assume we fetch for the selected turf or handle the logic
            
            if (currentStatus !== null) url += \`&status=\${currentStatus}\`;

            try {
                const response = await fetch(url);
                const result = await response.json();
                
                if (result.success) {
                    renderBookings(result.data.items);
                    renderPagination(result.data);
                }
            } catch (error) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center py-5 text-danger">Error loading bookings.</td></tr>';
            }
        }

        function renderBookings(items) {
            const tbody = document.getElementById('bookings-tbody');
            if (!items || items.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center py-5 text-muted">No bookings found for this criteria.</td></tr>';
                return;
            }

            tbody.innerHTML = items.map(b => \`
                <tr>
                    <td class="ps-4">
                        <div class="d-flex align-items-center">
                            <div class="avatar-initials me-3">\${b.userName[0]}</div>
                            <div>
                                <div class="fw-bold">\${b.userName}</div>
                                <div class="text-muted small">#\${b.id.substring(0, 8).toUpperCase()}</div>
                            </div>
                        </div>
                    </td>
                    <td class="fw-medium">\${b.turfName}</td>
                    <td>
                        <div class="fw-bold">\${new Date(b.bookingDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</div>
                        <div class="text-muted small">\${formatTime(b.startTime)} - \${formatTime(b.endTime)}</div>
                    </td>
                    <td class="fw-bold text-primary">৳\${b.totalAmount}</td>
                    <td>
                        <span class="badge-status status-\${b.status}">\${b.statusText}</span>
                    </td>
                    <td class="text-end pe-4">
                        <div class="d-flex gap-2 justify-content-end">
                            \${b.status === 0 ? \`
                                <button class="btn btn-sm btn-success rounded-pill px-3" onclick="confirmBooking('\${b.id}')">Confirm</button>
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="openRejectModal('\${b.id}')">Reject</button>
                            \` : ''}
                            <button class="btn btn-sm btn-light rounded-circle"><i class="fas fa-ellipsis-v"></i></button>
                        </div>
                    </td>
                </tr>
            \`).join('');
        }

        function renderPagination(data) {
            const nav = document.getElementById('pagination-nav');
            const list = document.getElementById('pagination-list');
            
            if (data.totalPages <= 1) {
                nav.style.display = 'none';
                return;
            }

            nav.style.display = 'block';
            let html = '';
            for (let i = 1; i <= data.totalPages; i++) {
                html += \`
                    <li class="page-item \${i === data.pageNumber ? 'active' : ''}">
                        <button class="btn btn-sm shadow-sm \${i === data.pageNumber ? 'btn-primary' : 'btn-white'}" onclick="goToPage(\${i})">\${i}</button>
                    </li>
                \`;
            }
            list.innerHTML = html;
        }

        function setStatusFilter(status, btn) {
            document.querySelectorAll('.btn-tab').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentStatus = status;
            currentPage = 1;
            loadBookings();
        }

        function goToPage(page) {
            currentPage = page;
            loadBookings();
        }

        function formatTime(timeStr) {
            const [h, m] = timeStr.split(':');
            const hour = parseInt(h);
            const ampm = hour >= 12 ? 'PM' : 'AM';
            const h12 = hour % 12 || 12;
            return \`\${h12}:\${m} \${ampm}\`;
        }

        async function confirmBooking(id) {
            if (!confirm('Confirm this booking?')) return;
            const response = await fetch(\`/api/bookings/\${id}/confirm\`, { method: 'PATCH' });
            const result = await response.json();
            if (result.success) loadBookings();
            else alert(result.message);
        }

        function openRejectModal(id) {
            activeBookingId = id;
            document.getElementById('reject-reason').value = '';
            const modal = new bootstrap.Modal(document.getElementById('rejectModal'));
            modal.show();
        }

        document.getElementById('btn-confirm-reject').addEventListener('click', async function() {
            const reason = document.getElementById('reject-reason').value;
            if (!reason) return alert('Please provide a reason');

            this.disabled = true;
            this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing...';

            try {
                const response = await fetch(\`/api/bookings/\${activeBookingId}/reject\`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(reason)
                });

                const result = await response.json();
                if (result.success) {
                    bootstrap.Modal.getInstance(document.getElementById('rejectModal')).hide();
                    loadBookings();
                } else {
                    alert(result.message);
                }
            } catch (error) {
                alert('Error rejecting booking');
            } finally {
                this.disabled = false;
                this.innerText = 'Confirm Reject';
            }
        });

        // Initial Load
        loadMyTurfs().then(() => loadBookings());
    </script>
}
