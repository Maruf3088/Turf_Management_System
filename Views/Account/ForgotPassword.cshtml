@model turf_management_system.Models.ViewModels.ForgotPasswordVM
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="split-layout-wrapper d-flex min-vh-100">
    <!-- Left Side: Visual/Branding (Hidden on mobile) -->
    <div class="brand-side d-none d-lg-flex flex-column justify-content-between position-relative overflow-hidden w-50">
        <div class="brand-bg-image"></div>
        <div class="brand-overlay"></div>
        
        <div class="position-relative z-3 p-5">
            <h3 class="text-white fw-bold display-font">
                <i class="fas fa-leaf text-success me-2"></i> Turf Management
            </h3>
        </div>
        
        <div class="position-relative z-3 p-5 text-white animate-up-slow">
            <div class="glass-badge mb-4 d-inline-block px-3 py-1 rounded-pill small fw-bold tracking-widest text-uppercase">
                Secure Access
            </div>
            <h1 class="display-4 fw-extrabold mb-4 display-font">Regain Access to <br/>Your Account.</h1>
            <p class="lead text-white-50 mb-0" style="max-width: 400px;">
                Enter your email to receive a secure OTP to reset your password and get back to managing your turfs effortlessly.
            </p>
        </div>
    </div>

    <!-- Right Side: Form -->
    <div class="form-side w-100 w-lg-50 d-flex align-items-center justify-content-center bg-white position-relative">
        
        <!-- Subtle background shapes -->
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>

        <div class="form-container px-4 px-md-5 w-100 position-relative z-3" style="max-width: 500px;">
            <div class="text-center mb-5 animate-up">
                <div class="icon-circle mx-auto mb-4 bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center rounded-circle">
                    <i class="fas fa-fingerprint fa-2x"></i>
                </div>
                <h2 class="fw-bold mb-2 text-dark display-font">Forgot Password</h2>
                <p class="text-muted">No worries, we'll send you an OTP.</p>
            </div>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert custom-alert-danger border-0 text-danger mb-4 rounded-4 p-4 shadow-sm animate-in">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-exclamation-triangle fa-2x"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="mb-1 fw-bold">Delivery Failed</h6>
                            <p class="mb-0 small opacity-75">@ViewBag.ErrorMessage</p>
                        </div>
                    </div>
                </div>
                <div class="text-center mt-4">
                    <a asp-action="ForgotPassword" class="btn btn-modern-dark w-100 py-3 fw-bold rounded-4">
                        Try Again
                    </a>
                </div>
            }
            else
            {
                <form asp-action="ForgotPassword" method="post" class="animate-up" style="animation-delay: 0.1s;">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-4 p-3 bg-danger bg-opacity-10 rounded-3"></div>

                    <div class="form-floating mb-4 custom-floating-input">
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" autofocus />
                        <label asp-for="Email"><i class="fas fa-envelope me-2 text-muted"></i>Email address</label>
                        <span asp-validation-for="Email" class="text-danger small mt-2 d-block ms-1"></span>
                    </div>

                    <div class="d-grid mb-4">
                        <button type="submit" class="btn btn-modern-success btn-lg py-3 fw-bold rounded-4 shadow-sm">
                            Send OTP <i class="fas fa-arrow-right ms-2 transition-icon"></i>
                        </button>
                    </div>

                    <div class="text-center mt-5">
                        <a asp-action="Login" class="text-decoration-none text-muted fw-semibold hover-text-dark transition-all">
                            <i class="fas fa-arrow-left me-2"></i> Back to log in
                        </a>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Hide default navbar/footer for this specific page if we want full takeover */
        header, footer { display: none !important; }
        
        main[role="main"] {
            padding: 0 !important;
            margin: 0 !important;
            max-width: 100% !important;
        }
        
        .container {
            max-width: 100% !important;
            padding: 0 !important;
        }

        .split-layout-wrapper {
            margin: 0;
            padding: 0;
            width: 100vw;
            overflow-x: hidden;
        }

        /* Brand Side Styles */
        .brand-bg-image {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: url('https://images.unsplash.com/photo-1575361204480-aadea25e6e68?auto=format&fit=crop&q=80&w=1920');
            background-size: cover;
            background-position: center;
            transform: scale(1.05);
            transition: transform 10s ease;
        }
        
        .brand-side:hover .brand-bg-image {
            transform: scale(1);
        }

        .brand-overlay {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(135deg, rgba(15,23,42,0.95) 0%, rgba(16,185,129,0.85) 100%);
        }

        .glass-badge {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            letter-spacing: 2px;
        }

        /* Form Side Styles */
        .form-side {
            min-height: 100vh;
        }

        .icon-circle {
            width: 72px;
            height: 72px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        
        .icon-circle:hover {
            transform: translateY(-5px) scale(1.05);
            box-shadow: 0 10px 25px rgba(25, 135, 84, 0.2);
        }

        /* Modern Floating Input */
        .custom-floating-input .form-control {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 1rem 1.25rem;
            height: auto;
            font-size: 1rem;
            font-weight: 500;
            color: #1e293b;
            background-color: #f8fafc;
            transition: all 0.3s ease;
        }
        
        .custom-floating-input .form-control:focus {
            background-color: #fff;
            border-color: #10b981;
            box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.1);
        }
        
        .custom-floating-input label {
            padding: 1rem 1.25rem;
            color: #64748b;
            font-weight: 500;
        }

        /* Buttons */
        .btn-modern-success {
            background: #10b981;
            color: white;
            border: none;
            transition: all 0.3s ease;
        }
        
        .btn-modern-success:hover {
            background: #059669;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(16, 185, 129, 0.2) !important;
        }
        
        .btn-modern-success:hover .transition-icon {
            transform: translateX(5px);
        }

        .btn-modern-dark {
            background: #0f172a;
            color: white;
            border: none;
            transition: all 0.3s ease;
        }
        
        .btn-modern-dark:hover {
            background: #1e293b;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(15, 23, 42, 0.15) !important;
        }

        /* Abstract Shapes */
        .shape {
            position: absolute;
            filter: blur(60px);
            z-index: 1;
            opacity: 0.5;
            border-radius: 50%;
            animation: float 10s infinite ease-in-out alternate;
        }
        .shape-1 {
            width: 300px; height: 300px;
            background: #d1fae5;
            top: -100px; right: -100px;
        }
        .shape-2 {
            width: 400px; height: 400px;
            background: #f1f5f9;
            bottom: -150px; left: -150px;
            animation-delay: -5s;
        }

        /* Alerts */
        .custom-alert-success {
            background: #ecfdf5;
            border: 1px solid #a7f3d0 !important;
        }
        .custom-alert-danger {
            background: #fef2f2;
            border: 1px solid #fecaca !important;
        }

        /* Animations */
        .animate-up {
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        .animate-up-slow {
            opacity: 0;
            transform: translateY(30px);
            animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        .animate-in {
            animation: fadeInScale 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        
        .transition-icon {
            transition: transform 0.3s ease;
        }
        .transition-all {
            transition: all 0.3s ease;
        }
        .hover-text-dark:hover {
            color: #0f172a !important;
        }

        @@keyframes fadeInUp {
            to { opacity: 1; transform: translateY(0); }
        }
        @@keyframes fadeInScale {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }
        @@keyframes float {
            0% { transform: translate(0, 0); }
            100% { transform: translate(30px, 30px); }
        }
        
        @@media (min-width: 992px) {
            .w-lg-50 { width: 50% !important; }
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
