@model turf_management_system.Models.Domain.Booking
@{
    ViewData["Title"] = "Payment Submitted";
}

<div class="container py-5 text-center" style="max-width:600px;">
    <div class="mb-4">
        <i class="fas fa-hourglass-half fa-5x text-warning mb-3"></i>
        <h2 class="fw-bold text-warning">Payment Under Verification</h2>
        <p class="text-muted lead">Your payment has been submitted successfully. The turf owner will verify it shortly.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 text-start mb-4">
        <div class="card-body p-4">
            @if (ViewBag.Bookings != null)
            {
                var bookingsList = ViewBag.Bookings as List<turf_management_system.Models.Domain.Booking>;
                @for (int i = 0; i < bookingsList.Count; i++)
                {
                    var b = bookingsList[i];
                    <div class="@(i > 0 ? "mt-3 pt-3 border-top" : "")">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Booking ID</span>
                            <strong class="text-primary">#@b.Id.ToString()[..8].ToUpper()</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Turf</span>
                            <strong>@b.Turf?.Name</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Date</span>
                            <strong>@b.BookingDate.ToString("dd MMM yyyy")</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Time</span>
                            <strong>@b.StartTime.ToString(@"hh\:mm") – @b.EndTime.ToString(@"hh\:mm")</strong>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Booking ID</span>
                    <strong class="text-primary">#@Model.Id.ToString()[..8].ToUpper()</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Turf</span>
                    <strong>@Model.Turf?.Name</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Date</span>
                    <strong>@Model.BookingDate.ToString("dd MMM yyyy")</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Time</span>
                    <strong>@Model.StartTime.ToString(@"hh\:mm") – @Model.EndTime.ToString(@"hh\:mm")</strong>
                </div>
            }
        </div>
    </div>

    <div class="alert alert-info rounded-3">
        <i class="fas fa-bell me-2"></i>You will receive a notification once your booking is confirmed.
    </div>

    <div class="d-flex gap-3 justify-content-center">
        <a asp-action="MyBookings" class="btn btn-outline-secondary rounded-3 px-4">
            <i class="fas fa-list me-2"></i>My Bookings
        </a>
        <a asp-action="Browse" class="btn btn-success rounded-3 px-4">
            <i class="fas fa-search me-2"></i>Browse Turfs
        </a>
    </div>
</div>
