@using turf_management_system.DTOs.Turf
@model IEnumerable<TurfListItemDto>
@{
    ViewData["Title"] = "Your Game, Our Turf";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container h-100">
        <div class="row h-100 align-items-center">
            <div class="col-lg-6 text-white animate-up">
                <span class="badge bg-accent text-dark px-3 py-2 mb-4 fw-bold text-uppercase ls-1">Premium Sports Venues</span>
                <h1 class="display-2 fw-bold mb-4">Your Game,<br><span class="text-accent">Our Turf.</span></h1>
                <p class="fs-5 text-white-50 mb-5 pe-lg-5">Discover and book the finest sports turfs in your city. Real-time availability, instant confirmation, and premium amenities.</p>
                <div class="d-flex gap-3">
                    <a asp-action="AllTurfs" class="btn btn-accent btn-lg px-5 py-3 fw-bold">Book a Turf</a>
                    <a href="#featured" class="btn btn-outline-light btn-lg px-5 py-3 fw-bold">Explore Fields</a>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block">
                <div class="hero-image-wrapper animate-up" style="animation-delay: 0.2s;">
                    <img src="https://images.unsplash.com/photo-1574629810360-7efbbe195018?auto=format&fit=crop&q=80&w=1200" alt="Turf" class="img-fluid rounded-5 shadow-2xl">
                    <div class="floating-card p-4 rounded-4 shadow-lg animate-up" style="animation-delay: 0.4s;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-circle bg-success-light">
                                <i class="fas fa-check text-success"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">Instant Booking</h6>
                                <p class="mb-0 text-muted small">No more waiting calls</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="py-5 bg-white border-bottom">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-3 col-6">
                <div class="p-3">
                    <h2 class="display-font text-primary mb-1">50+</h2>
                    <p class="text-muted small text-uppercase fw-bold ls-1">Premium Turfs</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3">
                    <h2 class="display-font text-primary mb-1">10k+</h2>
                    <p class="text-muted small text-uppercase fw-bold ls-1">Happy Players</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3">
                    <h2 class="display-font text-primary mb-1">24/7</h2>
                    <p class="text-muted small text-uppercase fw-bold ls-1">Availability</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3">
                    <h2 class="display-font text-primary mb-1">100%</h2>
                    <p class="text-muted small text-uppercase fw-bold ls-1">Secure Payments</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Turfs -->
<section class="py-120 bg-light" id="featured">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-5">
            <div class="animate-up">
                <h6 class="text-primary text-uppercase fw-bold ls-1 mb-2">Editor's Choice</h6>
                <h2 class="display-4 fw-bold mb-0">Featured Turfs</h2>
            </div>
            <a asp-action="AllTurfs" class="btn btn-outline-primary rounded-pill px-4 py-2 animate-up">View All <i class="fas fa-arrow-right ms-2"></i></a>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                @foreach (var turf in Model)
                {
                    <div class="col-md-4 animate-up">
                        <div class="card h-100 overflow-hidden border-0 shadow-sm">
                            <div class="position-relative">
                                <img src="@(turf.MainImageUrl ?? "/images/turf-placeholder.jpg")" class="card-img-top" style="height: 240px; object-fit: cover;" alt="@turf.Name">
                                <div class="position-absolute bottom-0 start-0 m-3">
                                    <span class="badge bg-white text-dark rounded-pill px-3 py-2 shadow-sm fw-bold">৳@turf.PricePerHour/hr</span>
                                </div>
                            </div>
                            <div class="card-body p-4">
                                <h4 class="fw-bold mb-2">@turf.Name</h4>
                                <p class="text-muted small mb-4"><i class="fas fa-map-marker-alt me-2 text-primary"></i> @turf.City</p>
                                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                    <span class="badge bg-light text-primary px-3 py-2">@turf.SportType</span>
                                    <a asp-action="Details" asp-route-id="@turf.Id" class="btn btn-primary btn-sm rounded-pill px-4">Book Now</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <p class="text-muted">No featured turfs available right now. Check back later!</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="py-120 bg-primary text-white position-relative overflow-hidden">
    <div class="cta-circles"></div>
    <div class="container position-relative z-1">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8 animate-up">
                <h2 class="display-3 fw-bold mb-4">Are you a Turf Owner?</h2>
                <p class="fs-5 text-white-50 mb-5">Join our network of premium sports venues and grow your business with our state-of-the-art management system.</p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-accent btn-lg px-5 py-3 fw-bold">Partner with Us</a>
                    <a href="#" class="btn btn-outline-light btn-lg px-5 py-3 fw-bold">Learn More</a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .hero-section {
            height: 750px;
            background: linear-gradient(rgba(26,60,52,0.8), rgba(26,60,52,0.8)), url('https://images.unsplash.com/photo-1556056504-517cf0121f3c?ixlib=rb-1.2.1&auto=format&fit=crop&w=1920&q=80');
            background-size: cover;
            background-position: center;
            position: relative;
        }

        .hero-image-wrapper { position: relative; padding-left: 50px; }
        .hero-image-wrapper img { border: 10px solid rgba(255,255,255,0.1); }
        
        .floating-card {
            position: absolute;
            bottom: -30px;
            left: 0;
            background: white;
            width: 250px;
            z-index: 10;
        }

        .icon-circle {
            width: 50px; height: 50px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px;
        }
        .bg-success-light { background: #DCFCE7; }

        .py-120 { padding: 120px 0; }
        
        .ls-1 { letter-spacing: 0.1em; }
        
        .cta-circles {
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            width: 800px; height: 800px;
            background: radial-gradient(circle, rgba(201,168,76,0.1) 0%, transparent 70%);
            pointer-events: none;
        }

        .shadow-2xl { box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5); }
    </style>
}
