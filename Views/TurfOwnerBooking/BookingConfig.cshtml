@model turf_management_system.Models.Domain.TurfBookingConfig
@{
    ViewData["Title"] = $"Booking Config — {ViewBag.TurfName}";
    Layout = "_TurfOwnerLayout";
}

<div class="container-fluid py-4" style="max-width:800px;">
    <div class="d-flex align-items-center mb-4">
        <a asp-controller="TurfOwner" asp-action="MyTurfs" class="btn btn-outline-secondary me-3 rounded-pill">
            <i class="fas fa-arrow-left"></i>
        </a>
        <div>
            <h4 class="fw-bold mb-0">Booking Configuration</h4>
            <p class="text-muted mb-0">@ViewBag.TurfName</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3"><i class="fas fa-check me-2"></i>@TempData["Success"]</div>
    }

    <form asp-action="SaveBookingConfig" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="TurfId">

        <!-- Available Days -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header border-0 bg-transparent px-4 pt-4 pb-2">
                <h6 class="fw-bold mb-0"><i class="fas fa-calendar me-2 text-success"></i>Available Days</h6>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="row g-2">
                    @{
                        var days = new[] { ("Sun", 0, 1), ("Mon", 1, 2), ("Tue", 2, 4), ("Wed", 3, 8), ("Thu", 4, 16), ("Fri", 5, 32), ("Sat", 6, 64) };
                    }
                    @foreach (var (name, idx, bit) in days)
                    {
                        var isChecked = (Model.AvailableDaysMask & bit) != 0;
                        <div class="col-auto">
                            <div class="day-toggle @(isChecked ? "active" : "")" onclick="toggleDay(this, @bit)">
                                @name
                            </div>
                        </div>
                    }
                </div>
                <input type="hidden" name="AvailableDaysMask" id="daysMask" value="@Model.AvailableDaysMask">
            </div>
        </div>

        <!-- Operating Hours & Slot Duration -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header border-0 bg-transparent px-4 pt-4 pb-2">
                <h6 class="fw-bold mb-0"><i class="fas fa-clock me-2 text-success"></i>Operating Hours</h6>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Opening Time</label>
                        <input type="time" name="OpeningTime" class="form-control" value="@Model.OpeningTime.ToString(@"hh\:mm")" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Closing Time</label>
                        <input type="time" name="ClosingTime" class="form-control" value="@Model.ClosingTime.ToString(@"hh\:mm")" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Slot Duration (minutes)</label>
                        <select name="SlotDurationMinutes" class="form-select">
                            @{ var dur = Model.SlotDurationMinutes; }
                            @if(dur==30){<option value="30" selected>30 min</option>}else{<option value="30">30 min</option>}
                            @if(dur==60){<option value="60" selected>60 min (1 hour)</option>}else{<option value="60">60 min (1 hour)</option>}
                            @if(dur==90){<option value="90" selected>90 min</option>}else{<option value="90">90 min</option>}
                            @if(dur==120){<option value="120" selected>120 min (2 hours)</option>}else{<option value="120">120 min (2 hours)</option>}
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Max Advance Booking</label>
                        <select name="MaxAdvanceBookingDays" class="form-select">
                            @{ var adv = Model.MaxAdvanceBookingDays; }
                            @if(adv==3){<option value="3" selected>3 days</option>}else{<option value="3">3 days</option>}
                            @if(adv==7){<option value="7" selected>7 days</option>}else{<option value="7">7 days</option>}
                            @if(adv==14){<option value="14" selected>14 days</option>}else{<option value="14">14 days</option>}
                            @if(adv==30){<option value="30" selected>30 days</option>}else{<option value="30">30 days</option>}
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment Rules -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header border-0 bg-transparent px-4 pt-4 pb-2">
                <h6 class="fw-bold mb-0"><i class="fas fa-money-bill me-2 text-success"></i>Payment Rules</h6>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="RequireFullPayment" id="fullPayment" value="true"
                                   @(Model.RequireFullPayment ? "checked" : "")>
                            <label class="form-check-label fw-bold" for="fullPayment">Require Full Payment</label>
                        </div>
                        <small class="text-muted">If off, partial advance payment is accepted.</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Advance Payment %</label>
                        <input type="number" name="AdvancePaymentPercent" class="form-control"
                               value="@Model.AdvancePaymentPercent" min="1" max="100" step="1">
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">Accepted Methods</label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="AcceptBkash" value="true" id="bkash"
                                       @(Model.AcceptBkash ? "checked" : "")>
                                <label class="form-check-label fw-bold" style="color:#e2136e" for="bkash">bKash</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="AcceptNagad" value="true" id="nagad"
                                       @(Model.AcceptNagad ? "checked" : "")>
                                <label class="form-check-label fw-bold" style="color:#f56b00" for="nagad">Nagad</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="AcceptRocket" value="true" id="rocket"
                                       @(Model.AcceptRocket ? "checked" : "")>
                                <label class="form-check-label fw-bold" style="color:#8e24aa" for="rocket">Rocket</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cancellation Rules -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header border-0 bg-transparent px-4 pt-4 pb-2">
                <h6 class="fw-bold mb-0"><i class="fas fa-undo me-2 text-success"></i>Cancellation Policy</h6>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="CancellationAllowed" id="cancelAllowed" value="true"
                                   @(Model.CancellationAllowed ? "checked" : "")>
                            <label class="form-check-label fw-bold" for="cancelAllowed">Allow Cancellations</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Refund %</label>
                        <input type="number" name="RefundPercent" class="form-control"
                               value="@Model.RefundPercent" min="0" max="100" step="1">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Cancellation Deadline (hours)</label>
                        <input type="number" name="CancellationDeadlineHours" class="form-control"
                               value="@Model.CancellationDeadlineHours" min="0">
                    </div>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-success btn-lg w-100 rounded-3 fw-bold shadow-sm">
            <i class="fas fa-save me-2"></i>Save Configuration
        </button>
    </form>
</div>

<style>
.day-toggle { width:55px; height:55px; display:flex; align-items:center; justify-content:center; border-radius:50%; border:2px solid #dee2e6; cursor:pointer; font-weight:700; transition:all .2s; user-select:none; }
.day-toggle.active { background:#198754; color:white; border-color:#198754; }
.day-toggle:hover { border-color:#198754; }
</style>

@section Scripts {
<script>
let mask = @Model.AvailableDaysMask;
function toggleDay(el, bit) {
    el.classList.toggle('active');
    if (el.classList.contains('active')) mask |= bit;
    else mask &= ~bit;
    document.getElementById('daysMask').value = mask;
}
</script>
}
