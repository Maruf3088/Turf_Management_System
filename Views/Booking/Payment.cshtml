@model turf_management_system.Models.Domain.Booking
@using turf_management_system.Models.Domain
@{
    ViewData["Title"] = "Complete Payment";
    var config = ViewBag.Config as TurfBookingConfig;
    var requiredAmount = (decimal)ViewBag.RequiredAmount;
    var lockExpiresAt = (DateTime)ViewBag.LockExpiresAt;
}

<!-- Hero Section Breakout Container -->
<div class="full-width-breakout hero-wrapper position-relative overflow-hidden mb-5">
    <div class="stadium-lights-backdrop"></div>
    <div class="hero-dark-overlay"></div>
    
    <div class="container position-relative h-100 z-3 text-white">
        <div class="row align-items-center py-5">
            <div class="col-lg-8 animate-up">
                <span class="badge bg-gold text-dark px-3 py-2 mb-3 fw-bold text-uppercase tracking-wider rounded-pill shadow-sm">
                    Secure Checkout
                </span>
                <h1 class="display-4 fw-extrabold mb-3 tracking-tight display-font text-white">
                    Complete Payment
                </h1>
                <p class="fs-5 text-light-gray mb-4 fw-light">
                    Finalize your reservation safely and securely with our trusted payment partners.
                </p>
                <div class="d-flex align-items-center bg-white bg-opacity-10 rounded-pill p-1 pe-4 border border-light d-inline-flex">
                    <div class="bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 45px; height: 45px;">
                        <i class="fas fa-hourglass-half"></i>
                    </div>
                    <div>
                        <span class="d-block text-white-50 small text-uppercase fw-bold ls-1" style="font-size: 0.7rem;">Time Remaining</span>
                        <span id="countdown" class="fw-bold fs-5 font-monospace text-gold">--:--</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5" style="margin-top: -60px; position: relative; z-index: 10; max-width: 900px;">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center animate-up">
            <i class="fas fa-exclamation-triangle fa-lg me-3"></i>@TempData["Error"]
        </div>
    }

    <div class="row g-4">
        <!-- Left Column: Payment Form -->
        <div class="col-lg-7 order-2 order-lg-1 animate-up" style="animation-delay: 0.1s;">
            <div class="card border-0 shadow-2xl rounded-4 bg-white overflow-hidden h-100">
                <div class="card-header bg-white border-bottom px-4 py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-mobile-alt text-success me-2"></i>Select Payment Method</h5>
                </div>
                <div class="card-body p-4">
                    <form id="paymentForm" asp-action="SubmitPayment" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookingId" value="@Model.Id">
                        <input type="hidden" name="bookingIds" value="@ViewBag.BookingIds">
                        <input type="hidden" name="paymentType" value="@(config != null && !config.RequireFullPayment ? "Partial" : "Full")">

                        <div class="row g-3 mb-4">
                            @if (config == null || config.AcceptBkash)
                            {
                                <div class="col-4">
                                    <label class="d-block h-100">
                                        <input type="radio" name="paymentMethod" value="Bkash" class="d-none payment-radio" @(config?.AcceptBkash != false ? "checked" : "")>
                                        <div class="payment-method-card rounded-4 p-3 text-center h-100 d-flex flex-column justify-content-center" data-method="Bkash">
                                            <div style="color:#e2136e; font-size:1.5rem; font-weight:900;" class="mb-1">bKash</div>
                                            <small class="text-muted d-block" style="font-size: 0.7rem;">Send Money</small>
                                        </div>
                                    </label>
                                </div>
                            }
                            @if (config == null || config.AcceptNagad)
                            {
                                <div class="col-4">
                                    <label class="d-block h-100">
                                        <input type="radio" name="paymentMethod" value="Nagad" class="d-none payment-radio">
                                        <div class="payment-method-card rounded-4 p-3 text-center h-100 d-flex flex-column justify-content-center" data-method="Nagad">
                                            <div style="color:#f56b00; font-size:1.5rem; font-weight:900;" class="mb-1">Nagad</div>
                                            <small class="text-muted d-block" style="font-size: 0.7rem;">Send Money</small>
                                        </div>
                                    </label>
                                </div>
                            }
                            @if (config == null || config.AcceptRocket)
                            {
                                <div class="col-4">
                                    <label class="d-block h-100">
                                        <input type="radio" name="paymentMethod" value="Rocket" class="d-none payment-radio">
                                        <div class="payment-method-card rounded-4 p-3 text-center h-100 d-flex flex-column justify-content-center" data-method="Rocket">
                                            <div style="color:#8e24aa; font-size:1.5rem; font-weight:900;" class="mb-1">Rocket</div>
                                            <small class="text-muted d-block" style="font-size: 0.7rem;">Send Money</small>
                                        </div>
                                    </label>
                                </div>
                            }
                        </div>

                        <div class="bg-light rounded-4 p-4 mb-4 border border-light position-relative">
                            <span class="position-absolute top-0 start-0 translate-middle badge rounded-circle bg-dark text-white p-2 border border-white border-2">
                                <i class="fas fa-info"></i>
                            </span>
                            <h6 class="fw-bold mb-3 mt-1 ms-2">Manual Payment Steps</h6>
                            <ol class="mb-0 text-muted small ps-4">
                                <li class="mb-2">Open your mobile banking app</li>
                                <li class="mb-2">Select <strong class="text-dark">Send Money</strong></li>
                                <li class="mb-2">Send <strong class="text-success fw-bold">৳@requiredAmount.ToString("F2")</strong> to: <strong id="merchantNumber" class="text-dark bg-white px-2 py-1 rounded shadow-sm ms-1 border font-monospace">01XXXXXXXXX</strong></li>
                                <li>Enter the transaction ID below</li>
                            </ol>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-uppercase small ls-1 text-muted">Payment Amount (৳)</label>
                            <input type="number" id="formAmount" name="amount" class="form-control form-control-lg bg-light border-0 shadow-none px-4" 
                                   value="@requiredAmount" min="@requiredAmount" step="0.01" required style="border-radius: 12px; font-weight: 600;">
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-uppercase small ls-1 text-muted">Transaction ID <span class="text-danger">*</span></label>
                            <input type="text" id="formTxId" name="transactionId" class="form-control form-control-lg bg-light border-0 shadow-none px-4" 
                                   placeholder="e.g. TXN8FG3K9..." required maxlength="100" style="border-radius: 12px; font-family: monospace;">
                        </div>

                        <div class="d-flex flex-column gap-3 mt-5">
                            <button type="button" class="btn btn-gold btn-lg rounded-pill fw-bold py-3 shadow-md border-0 w-100" onclick="openSimulatedGateway()">
                                <i class="fas fa-bolt me-2"></i>Pay Instantly (Gateway)
                            </button>
                            <button type="submit" class="btn btn-light btn-lg rounded-pill fw-bold py-3 border text-dark w-100 hover-dark-border">
                                Submit Manual Verification
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Column: Booking Summary -->
        <div class="col-lg-5 order-1 order-lg-2 animate-up" style="animation-delay: 0.2s;">
            <div class="card border-0 shadow-lg rounded-4 bg-dark text-white overflow-hidden h-100 position-sticky" style="top: 100px;">
                <div class="card-header bg-transparent border-bottom border-secondary px-4 py-4">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-receipt text-gold me-2"></i>Order Summary</h5>
                </div>
                <div class="card-body p-4">
                    @if (ViewBag.Bookings != null)
                    {
                        var bookingsList = ViewBag.Bookings as List<Booking>;
                        @for (int i = 0; i < bookingsList.Count; i++)
                        {
                            var b = bookingsList[i];
                            <div class="@(i > 0 ? "mt-4 pt-4 border-top border-secondary" : "")">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-white-50">Turf</span>
                                    <span class="fw-bold">@b.Turf.Name</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-white-50">Location</span>
                                    <span class="fw-bold text-end">@b.Turf.City</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-white-50">Date</span>
                                    <span class="fw-bold">@b.BookingDate.ToString("dd MMM yyyy")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-white-50">Time</span>
                                    <span class="fw-bold">@b.StartTime.ToString(@"hh\:mm") – @b.EndTime.ToString(@"hh\:mm")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-white-50">Duration</span>
                                    <span class="fw-bold">@b.TotalHours hrs</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-white-50">Turf</span>
                            <span class="fw-bold text-end">@Model.Turf.Name</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-white-50">Location</span>
                            <span class="fw-bold text-end">@Model.Turf.City</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-white-50">Date</span>
                            <span class="fw-bold">@Model.BookingDate.ToString("dd MMM yyyy")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-white-50">Time</span>
                            <span class="fw-bold">@Model.StartTime.ToString(@"hh\:mm") – @Model.EndTime.ToString(@"hh\:mm")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-white-50">Duration</span>
                            <span class="fw-bold">@Model.TotalHours hrs</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-white-50">Booking ID</span>
                            <span class="fw-bold font-monospace text-gold">#@Model.Id.ToString()[..8].ToUpper()</span>
                        </div>
                    }
                </div>
                <div class="card-footer bg-transparent border-top border-secondary p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-white-50">Total Amount</span>
                        <span class="fw-bold fs-5">৳@((ViewBag.TotalAmount as decimal? ?? Model.TotalAmount).ToString("F2"))</span>
                    </div>
                    
                    <div class="bg-white bg-opacity-10 rounded-4 p-3 mt-2">
                        @if (config != null && !config.RequireFullPayment)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-white fw-bold">Advance Required (@config.AdvancePaymentPercent%)</span>
                                <span class="fw-bold text-gold fs-4">৳@requiredAmount.ToString("F2")</span>
                            </div>
                            <div class="small text-white-50 text-end">Remaining ৳@(((ViewBag.TotalAmount as decimal? ?? Model.TotalAmount) - requiredAmount).ToString("F2")) payable at venue.</div>
                        }
                        else
                        {
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-white fw-bold">Amount Due</span>
                                <span class="fw-bold text-gold fs-4">৳@requiredAmount.ToString("F2")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Simulated Gateway Modal -->
<div class="modal fade" id="gatewayModal" data-bs-backdrop="static" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content border-0 overflow-hidden shadow-2xl" id="gatewayModalContent" style="border-radius: 24px; transition: all 0.3s ease;">
            <!-- Gateway Branding Header -->
            <div class="p-4 text-center text-white position-relative" id="gatewayHeader" style="background: #e2136e; transition: background-color 0.3s;">
                <div class="position-absolute top-0 end-0 p-3">
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 60px; height: 60px;">
                    <i class="fas fa-wallet fa-2x" id="gatewayIcon" style="color: #e2136e;"></i>
                </div>
                <h4 class="fw-extrabold mb-1 display-font" id="gatewayTitle">bKash Checkout</h4>
                <p class="mb-0 small opacity-75" id="gatewaySubtitle">Secure Gateway Simulation</p>
            </div>
            
            <div class="modal-body p-4 bg-white">
                <div class="text-center mb-4 pb-3 border-bottom">
                    <span class="text-muted small text-uppercase ls-1 fw-bold d-block mb-1">Amount to Pay</span>
                    <h1 class="fw-extrabold text-dark mb-0 font-monospace display-5 tracking-tight">৳@requiredAmount.ToString("F0")</h1>
                </div>

                <!-- Step 1: Wallet Number -->
                <div id="stepWallet">
                    <div class="mb-4">
                        <label class="form-label fw-bold text-muted small text-uppercase ls-1 mb-2 d-block text-center">Mobile Wallet Number</label>
                        <input type="text" id="gatewayWalletNumber" class="form-control form-control-lg bg-light border-0 shadow-none text-center fs-3 font-monospace py-3" placeholder="01XXXXXXXXX" style="border-radius: 16px; letter-spacing: 2px;" maxlength="11">
                    </div>
                    <button class="btn btn-lg w-100 text-white fw-bold py-3 shadow-sm" id="gatewayWalletNextBtn" onclick="goToPinStep()" style="border-radius: 16px; background: #e2136e; border: none; font-size: 1.1rem;">
                        Proceed Securely
                    </button>
                </div>

                <!-- Step 2: PIN entry -->
                <div id="stepPin" class="d-none">
                    <div class="mb-4 text-center">
                        <label class="form-label fw-bold text-muted small text-uppercase ls-1 mb-2 d-block">Enter 5-digit PIN</label>
                        <input type="password" id="gatewayPin" class="form-control form-control-lg bg-light border-0 shadow-none text-center display-6 font-monospace py-3" placeholder="•••••" style="border-radius: 16px; letter-spacing: 8px;" maxlength="5">
                        <small class="text-muted d-block mt-3 bg-light p-2 rounded-3"><i class="fas fa-shield-alt text-success me-1"></i>Security Simulation: Enter any 5 digits.</small>
                    </div>
                    <button class="btn btn-lg w-100 text-white fw-bold py-3 shadow-sm" id="gatewayConfirmBtn" onclick="processSimulatedPayment()" style="border-radius: 16px; background: #e2136e; border: none; font-size: 1.1rem;">
                        Confirm Payment
                    </button>
                </div>

                <!-- Step 3: Loading -->
                <div id="stepLoading" class="d-none text-center py-5">
                    <div class="spinner-border mb-4" id="gatewaySpinner" style="width: 4rem; height: 4rem; color: #e2136e; border-width: 0.3em;" role="status"></div>
                    <h4 class="fw-bold text-dark mb-2">Processing...</h4>
                    <p class="text-muted small mb-0">Please do not close this window</p>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light justify-content-center py-3">
                <span class="text-muted small fw-bold"><i class="fas fa-lock text-success me-1"></i> Secured by TurfMaster Pay</span>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Breakout CSS */
        .full-width-breakout {
            width: 100vw;
            position: relative;
            left: 50%;
            right: 50%;
            margin-left: -50vw;
            margin-right: -50vw;
        }

        .hero-wrapper {
            background: #0f1c18;
            padding: 60px 0 120px;
        }

        .stadium-lights-backdrop {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(135deg, rgba(26,60,52,0.95), rgba(15,28,24,0.98)), 
                        url('https://images.unsplash.com/photo-1556056504-517cf0121f3c?auto=format&fit=crop&q=80&w=1920');
            background-size: cover;
            background-position: center;
            opacity: 0.9;
        }

        .hero-dark-overlay {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: radial-gradient(circle at center, rgba(201,168,76,0.15), transparent 70%);
            pointer-events: none;
        }

        .text-gold {
            color: #C9A84C !important;
        }
        
        .bg-gold {
            background-color: #C9A84C !important;
        }

        .btn-gold {
            background: linear-gradient(135deg, #E5BA44, #C9A84C);
            border: none;
            color: #0f1c18 !important;
            transition: all 0.3s;
        }

        .btn-gold:hover {
            background: linear-gradient(135deg, #F0CC5F, #B8952F);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(201,168,76,0.4) !important;
        }

        .shadow-2xl {
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15) !important;
        }

        .ls-1 {
            letter-spacing: 1px;
        }
        
        .hover-dark-border {
            transition: all 0.2s;
        }
        .hover-dark-border:hover {
            border-color: #212529 !important;
            background-color: #f8f9fa;
        }
        
        .animate-up {
            animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            opacity: 0;
            transform: translateY(20px);
        }
        
        @@keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .payment-method-card { 
            border: 2px solid #f8f9fa; 
            background-color: #f8f9fa;
            cursor: pointer; 
            transition: all .3s cubic-bezier(0.16, 1, 0.3, 1); 
            position: relative;
            overflow: hidden;
            z-index: 1;
        }
        .payment-method-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.6), rgba(255,255,255,0));
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: -1;
        }
        .payment-method-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.08);
            border-color: #e5e0d8;
        }
        .payment-method-card:hover::before {
            opacity: 1;
        }
        .payment-method-card.selected { 
            border-color: var(--color-primary) !important; 
            background: #fff !important; 
            box-shadow: 0 12px 28px rgba(26,60,52,0.15);
        }
        .payment-method-card.selected::after {
            content: '\f058';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            position: absolute;
            top: 12px;
            right: 12px;
            color: var(--color-primary);
            font-size: 1.1rem;
        }
    </style>
}

@section Scripts {
<script>
    // ── Countdown Timer ───────────────────────────────────────────────────────
    const lockExpires = new Date('@lockExpiresAt.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ssZ")');
    function updateCountdown() {
        const remaining = Math.max(0, lockExpires - new Date());
        const mins = Math.floor(remaining / 60000);
        const secs = Math.floor((remaining % 60000) / 1000);
        document.getElementById('countdown').textContent = `${mins}:${secs.toString().padStart(2,'0')}`;
        if (remaining <= 0) {
            document.getElementById('countdown').textContent = '0:00';
            document.getElementById('countdown').classList.add('text-danger');
            document.getElementById('countdown').classList.remove('text-gold');
            alert('Your slot reservation has expired. You will be redirected to My Bookings.');
            window.location.href = '/Booking/MyBookings';
        }
    }
    setInterval(updateCountdown, 1000);
    updateCountdown();

    // ── Payment Method Cards ──────────────────────────────────────────────────
    const merchantNumbers = { Bkash: '01712-345678', Nagad: '01812-345678', Rocket: '01912-345678' };
    const brandColors = { Bkash: '#e2136e', Nagad: '#f56b00', Rocket: '#8e24aa' };
    const brandNames = { Bkash: 'bKash Checkout', Nagad: 'Nagad Checkout', Rocket: 'Rocket Checkout' };
    
    let activeMethod = 'Bkash';

    document.querySelectorAll('.payment-radio').forEach(radio => {
        radio.addEventListener('change', function() {
            document.querySelectorAll('.payment-method-card').forEach(c => c.classList.remove('selected'));
            this.parentElement.querySelector('.payment-method-card').classList.add('selected');
            document.getElementById('merchantNumber').textContent = merchantNumbers[this.value] || '01XXXXXXXXX';
            activeMethod = this.value;
        });
        if (radio.checked) {
            radio.parentElement.querySelector('.payment-method-card').classList.add('selected');
            document.getElementById('merchantNumber').textContent = merchantNumbers[radio.value] || '01XXXXXXXXX';
            activeMethod = radio.value;
        }
    });

    document.querySelectorAll('.payment-method-card').forEach(card => {
        card.addEventListener('click', function() {
            const radio = this.closest('label').querySelector('input[type="radio"]');
            radio.checked = true;
            radio.dispatchEvent(new Event('change'));
        });
    });

    // ── Simulated Checkout Gateway ───────────────────────────────────────────
    let gatewayModal = null;

    function openSimulatedGateway() {
        // Reset Steps
        document.getElementById('stepWallet').classList.remove('d-none');
        document.getElementById('stepPin').classList.add('d-none');
        document.getElementById('stepLoading').classList.add('d-none');
        
        // Reset input fields
        document.getElementById('gatewayWalletNumber').value = '';
        document.getElementById('gatewayPin').value = '';

        // Configure theme based on selected method
        const brandColor = brandColors[activeMethod] || '#e2136e';
        const brandName = brandNames[activeMethod] || 'bKash Checkout';

        document.getElementById('gatewayHeader').style.backgroundColor = brandColor;
        document.getElementById('gatewayIcon').style.color = brandColor;
        document.getElementById('gatewaySpinner').style.color = brandColor;
        document.getElementById('gatewayTitle').textContent = brandName;
        document.getElementById('gatewayWalletNextBtn').style.backgroundColor = brandColor;
        document.getElementById('gatewayConfirmBtn').style.backgroundColor = brandColor;

        gatewayModal = new bootstrap.Modal(document.getElementById('gatewayModal'));
        gatewayModal.show();
    }

    function goToPinStep() {
        const wallet = document.getElementById('gatewayWalletNumber').value.trim();
        if (wallet.length !== 11 || isNaN(wallet)) {
            alert('Please enter a valid 11-digit mobile wallet number!');
            return;
        }
        document.getElementById('stepWallet').classList.add('d-none');
        document.getElementById('stepPin').classList.remove('d-none');
    }

    function processSimulatedPayment() {
        const pin = document.getElementById('gatewayPin').value.trim();
        if (pin.length < 4 || isNaN(pin)) {
            alert('Please enter a valid PIN to confirm checkout!');
            return;
        }

        document.getElementById('stepPin').classList.add('d-none');
        document.getElementById('stepLoading').classList.remove('d-none');

        // Simulate 2s processing delay
        setTimeout(() => {
            const methodPrefix = activeMethod === 'Bkash' ? 'BK' : activeMethod === 'Nagad' ? 'NG' : 'RC';
            const randomSuffix = Math.random().toString(36).substring(2, 10).toUpperCase();
            const txId = `SIM_${methodPrefix}_${randomSuffix}`;

            // Populate form and append isFake variable
            document.getElementById('formTxId').value = txId;
            
            const form = document.getElementById('paymentForm');
            
            // Append isFake hidden input
            const isFakeInput = document.createElement('input');
            isFakeInput.type = 'hidden';
            isFakeInput.name = 'isFake';
            isFakeInput.value = 'true';
            form.appendChild(isFakeInput);

            // Close gateway and submit
            gatewayModal.hide();
            form.submit();
        }, 2000);
    }
</script>
}
