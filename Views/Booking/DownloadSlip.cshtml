@model turf_management_system.Models.Domain.Booking
@using turf_management_system.Models.Domain
@{
    Layout = null; // No layout for print view
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Booking Slip - @Model.Id.ToString()[..8].ToUpper()</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- External Libraries for PDF and Image generation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    
    <style>
        body { background-color: #f8f9fa; font-family: 'Inter', sans-serif; }
        .slip-container {
            max-width: 600px;
            margin: 40px auto;
            background: #fff;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            border: 2px dashed #ccc;
        }
        .turf-logo {
            width: 60px;
            height: 60px;
            background: #1A3C34;
            color: #C9A84C;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            margin: 0 auto 15px;
        }
        .header-title { text-align: center; margin-bottom: 30px; border-bottom: 2px solid #eee; padding-bottom: 20px; }
        .detail-row { display: flex; justify-content: space-between; margin-bottom: 12px; border-bottom: 1px dashed #eee; padding-bottom: 8px; }
        .detail-label { color: #6c757d; font-weight: 500; }
        .detail-value { font-weight: 600; color: #212529; text-align: right; }
        .footer-note { text-align: center; margin-top: 30px; color: #6c757d; font-size: 0.9rem; }
        
        /* Make sure background colors render properly in PDF/Image */
        .bg-light { background-color: #f8f9fa !important; -webkit-print-color-adjust: exact; }
        .text-success { color: #198754 !important; -webkit-print-color-adjust: exact; }
        .text-danger { color: #dc3545 !important; -webkit-print-color-adjust: exact; }
        .text-primary { color: #0d6efd !important; -webkit-print-color-adjust: exact; }
        .text-dark { color: #212529 !important; -webkit-print-color-adjust: exact; }

        @@media print {
            body { background-color: #fff; }
            .slip-container { box-shadow: none; margin: 0; padding: 15px; max-width: 100%; border: none; transform: scale(0.95); transform-origin: top center; }
            .no-print { display: none !important; }
        }
        
        #loadingOverlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(255,255,255,0.8);
            z-index: 9999;
            align-items: center;
            justify-content: center;
            flex-direction: column;
        }
    </style>
</head>
<body>
    <div id="loadingOverlay">
        <div class="spinner-border text-success" role="status" style="width: 3rem; height: 3rem;"></div>
        <h5 class="mt-3 fw-bold">Generating File...</h5>
    </div>

    <div class="container">
        <div class="text-center mt-4 no-print d-flex flex-wrap justify-content-center gap-2">
            <button onclick="downloadPDF()" class="btn btn-danger btn-lg shadow-sm rounded-pill px-4">
                <i class="fas fa-file-pdf me-2"></i> Download PDF
            </button>
            <button onclick="downloadImage()" class="btn btn-success btn-lg shadow-sm rounded-pill px-4">
                <i class="fas fa-file-image me-2"></i> Download Image
            </button>
            <button onclick="window.print()" class="btn btn-dark btn-lg shadow-sm rounded-pill px-4">
                <i class="fas fa-print me-2"></i> Print
            </button>
            <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg shadow-sm rounded-pill px-4">
                Back
            </a>
        </div>

        <div class="slip-container" id="slipContent">
            <div class="header-title">
                <div class="turf-logo"><i class="fas fa-futbol"></i></div>
                <h3 class="fw-bold text-dark mb-1">@Model.Turf?.Name</h3>
                <p class="text-muted mb-0"><i class="fas fa-map-marker-alt me-1"></i>@Model.Turf?.City</p>
            </div>

            <div class="text-center mb-4">
                <h5 class="fw-bold text-uppercase text-secondary mb-3">Booking Slip</h5>
                @{
                    var qrDueAmount = Model.TotalAmount - Model.AmountPaid;
                    var qrText = $"Booking ID: {Model.Id}\n" +
                                 $"Name: {Model.User?.FullName}\n" +
                                 $"Turf: {Model.Turf?.Name}\n" +
                                 $"Date: {Model.BookingDate:dd MMM yyyy}\n" +
                                 $"Time: {Model.StartTime:hh\\:mm} - {Model.EndTime:hh\\:mm}\n" +
                                 $"Status: {Model.Status}\n" +
                                 $"Due: BDT {qrDueAmount}";
                    var qrUrlEncoded = Uri.EscapeDataString(qrText);
                }
                <!-- QR Code containing full details -->
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=@qrUrlEncoded" alt="QR Code" class="img-thumbnail shadow-sm p-2 mb-2" crossorigin="anonymous" />
                <p class="small text-muted font-monospace">Scan to View Details</p>
            </div>

            <div class="detail-row">
                <span class="detail-label">Booking ID</span>
                <span class="detail-value text-primary fs-5">#@Model.Id.ToString()[..8].ToUpper()</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Customer Name</span>
                <span class="detail-value">@Model.User?.FullName</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Booking Status</span>
                <span class="detail-value text-success">@Model.Status</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Date</span>
                <span class="detail-value">@Model.BookingDate.ToString("dd MMM yyyy")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Time Slot</span>
                <span class="detail-value">@Model.StartTime.ToString(@"hh\:mm") – @Model.EndTime.ToString(@"hh\:mm")</span>
            </div>
            
            <h6 class="fw-bold mt-4 mb-3 text-dark border-bottom pb-2"><i class="fas fa-wallet me-2"></i>Payment Summary</h6>
            <div class="detail-row bg-light p-2 rounded">
                <span class="detail-label">Total Amount</span>
                <span class="detail-value">৳@Model.TotalAmount.ToString("F2")</span>
            </div>
            <div class="detail-row bg-light p-2 rounded">
                <span class="detail-label">Amount Paid (Advance)</span>
                <span class="detail-value text-success">৳@Model.AmountPaid.ToString("F2")</span>
            </div>
            <div class="detail-row bg-light p-2 rounded border-0">
                <span class="detail-label">Due Amount (To pay at Turf)</span>
                @{
                    var dueAmount = Model.TotalAmount - Model.AmountPaid;
                }
                <span class="detail-value text-danger fs-5 fw-bold">৳@dueAmount.ToString("F2")</span>
            </div>

            <div class="mt-4 pt-3 border-top border-dashed">
                <h6 class="fw-bold text-dark mb-2"><i class="fas fa-info-circle me-1"></i> Turf Instructions & Rules</h6>
                <ul class="text-muted small ps-3 mb-0" style="font-size: 0.85rem; line-height: 1.6;">
                    <li>Please arrive at least 10 minutes prior to your booked slot.</li>
                    <li>Ensure you wear appropriate non-marking sports shoes/boots.</li>
                    <li>Any due amount must be cleared at the front desk before entry.</li>
                    <li>The time slot is strictly enforced; delayed starts will not extend closing time.</li>
                    <li>Show this QR code or Booking ID to the staff for quick verification.</li>
                </ul>
            </div>

            <div class="footer-note">
                <strong>Thank you for booking with us!</strong>
            </div>
        </div>
    </div>

    <script>
        const slipId = '@Model.Id.ToString()[..8].ToUpper()';
        const fileName = 'TurfBookingSlip_' + slipId;

        function showLoading() {
            document.getElementById('loadingOverlay').style.display = 'flex';
        }

        function hideLoading() {
            document.getElementById('loadingOverlay').style.display = 'none';
        }

        // PDF Generation
        function downloadPDF() {
            showLoading();
            const element = document.getElementById('slipContent');
            
            // Adjust styles temporarily for better PDF rendering
            element.style.boxShadow = 'none';
            element.style.margin = '0';
            element.style.border = 'none';
            
            const opt = {
                margin:       5,
                filename:     fileName + '.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true, scrollY: 0 },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' },
                pagebreak:    { mode: ['avoid-all', 'css', 'legacy'] }
            };

            // Generate and download
            html2pdf().set(opt).from(element).save().then(() => {
                // Restore styles
                element.style.boxShadow = '';
                element.style.margin = '';
                element.style.border = '';
                hideLoading();
            }).catch(err => {
                console.error('PDF Generation Error:', err);
                hideLoading();
                alert("There was an error generating the PDF.");
            });
        }

        // Image Generation
        function downloadImage() {
            showLoading();
            const element = document.getElementById('slipContent');
            
            html2canvas(element, {
                scale: 2,
                useCORS: true,
                backgroundColor: "#ffffff"
            }).then(canvas => {
                const imgData = canvas.toDataURL("image/png");
                const link = document.createElement('a');
                link.download = fileName + '.png';
                link.href = imgData;
                link.click();
                hideLoading();
            }).catch(err => {
                console.error('Image Generation Error:', err);
                hideLoading();
                alert("There was an error generating the image.");
            });
        }

        // Auto-download PDF when page loads (optional, based on request)
        // If we want it to automatically download without clicking, we can uncomment this:
        /*
        window.onload = function() {
            setTimeout(function() {
                downloadPDF();
            }, 1000); // 1 sec delay to ensure images load
        };
        */
    </script>
</body>
</html>
