@model turf_management_system.Models.ViewModels.RegisterVM
@{
    ViewData["Title"] = "Join TurfMaster";
}

<!-- Hero Section Breakout Container -->
<div class="full-width-breakout hero-wrapper position-relative overflow-hidden min-vh-100 py-5">
    <div class="stadium-lights-backdrop"></div>
    <div class="hero-dark-overlay"></div>
    
    <div class="container position-relative z-3 text-white">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-md-8 col-lg-7 animate-up">
                <div class="card border-0 shadow-2xl rounded-4 bg-dark bg-opacity-75 backdrop-blur-md overflow-hidden my-5">
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-5">
                            <div class="mx-auto mb-4 bg-gold-gradient rounded-circle d-flex align-items-center justify-content-center shadow-lg" style="width: 80px; height: 80px;">
                                <i class="fas fa-user-plus fa-2x text-dark"></i>
                            </div>
                            <h2 class="display-font fw-extrabold tracking-tight mb-2 text-white">Join TurfMaster</h2>
                            <p class="text-light-gray fw-light">Create your account to start playing or managing</p>
                        </div>

                        <form asp-action="Register" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger small mb-4 p-3 bg-danger bg-opacity-10 rounded-3 border border-danger border-opacity-25"></div>

                            <div class="row g-4 mb-4">
                                <div class="col-md-6">
                                    <label asp-for="FullName" class="form-label fw-bold small text-uppercase ls-1 text-gold">Full Name</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white bg-opacity-10 border-0 text-white-50"><i class="fas fa-user"></i></span>
                                        <input asp-for="FullName" class="form-control bg-white bg-opacity-10 border-0 text-white shadow-none px-3 py-3" placeholder="John Doe" />
                                    </div>
                                    <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label fw-bold small text-uppercase ls-1 text-gold">Email Address</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white bg-opacity-10 border-0 text-white-50"><i class="fas fa-envelope"></i></span>
                                        <input asp-for="Email" class="form-control bg-white bg-opacity-10 border-0 text-white shadow-none px-3 py-3" placeholder="name@example.com" />
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Password" class="form-label fw-bold small text-uppercase ls-1 text-gold">Password</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white bg-opacity-10 border-0 text-white-50"><i class="fas fa-key"></i></span>
                                        <input asp-for="Password" type="password" class="form-control bg-white bg-opacity-10 border-0 text-white shadow-none px-3 py-3" placeholder="••••••••" />
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="ConfirmPassword" class="form-label fw-bold small text-uppercase ls-1 text-gold">Confirm Password</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white bg-opacity-10 border-0 text-white-50"><i class="fas fa-check"></i></span>
                                        <input asp-for="ConfirmPassword" type="password" class="form-control bg-white bg-opacity-10 border-0 text-white shadow-none px-3 py-3" placeholder="••••••••" />
                                    </div>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="PhoneNumber" class="form-label fw-bold small text-uppercase ls-1 text-gold">Phone Number</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white bg-opacity-10 border-0 text-white-50"><i class="fas fa-phone"></i></span>
                                        <input asp-for="PhoneNumber" class="form-control bg-white bg-opacity-10 border-0 text-white shadow-none px-3 py-3" placeholder="+880..." />
                                    </div>
                                    <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="RoleId" class="form-label fw-bold small text-uppercase ls-1 text-gold">I am a...</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white bg-opacity-10 border-0 text-white-50"><i class="fas fa-user-tag"></i></span>
                                        <select asp-for="RoleId" class="form-select bg-transparent border-0 text-white shadow-none px-3 py-3 custom-select" id="roleSelect"
                                                asp-items="@(new SelectList(ViewBag.Roles, "RoleId", "RoleName"))" style="background-color: transparent;">
                                            <option value="" class="text-white-50">-- Select Purpose --</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="RoleId" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <div id="turfOwnerFields" style="display: none;" class="mt-4 mb-4">
                                <div class="p-4 bg-black bg-opacity-25 rounded-4 border border-light border-opacity-10 border-dashed">
                                    <h5 class="fw-bold mb-4 text-gold"><i class="fas fa-briefcase me-2"></i>Business Profile</h5>
                                    <div class="row g-4">
                                        <div class="col-md-12">
                                            <label asp-for="BusinessName" class="form-label fw-bold small text-uppercase ls-1 text-white-50">Business Name</label>
                                            <input asp-for="BusinessName" class="form-control bg-white bg-opacity-10 border-0 text-white px-3 py-3" placeholder="Elite Sports Arena" />
                                            <span asp-validation-for="BusinessName" class="text-danger small mt-1 d-block"></span>
                                        </div>
                                        <div class="col-md-12">
                                            <label asp-for="BusinessAddress" class="form-label fw-bold small text-uppercase ls-1 text-white-50">Business Address</label>
                                            <input asp-for="BusinessAddress" class="form-control bg-white bg-opacity-10 border-0 text-white px-3 py-3" placeholder="123 Green Way, Dhaka" />
                                            <span asp-validation-for="BusinessAddress" class="text-danger small mt-1 d-block"></span>
                                        </div>
                                        <div class="col-md-12">
                                            <label asp-for="NationalIdNumber" class="form-label fw-bold small text-uppercase ls-1 text-white-50">National ID Number (NID)</label>
                                            <input asp-for="NationalIdNumber" class="form-control bg-white bg-opacity-10 border-0 text-white px-3 py-3" placeholder="e.g. 1234567890" />
                                            <span asp-validation-for="NationalIdNumber" class="text-danger small mt-1 d-block"></span>
                                            <small class="text-white-50 d-block mt-2"><i class="fas fa-shield-alt text-success me-1"></i> Required for Turf Owner KYC verification.</small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-grid mt-5 mb-4">
                                <button type="submit" class="btn btn-gold btn-lg py-3 fw-bold rounded-pill shadow-md text-dark">
                                    Create My Account <i class="fas fa-rocket ms-2"></i>
                                </button>
                            </div>

                            <div class="text-center">
                                <p class="text-light-gray mb-0 small">Already have an account? <a asp-action="Login" class="text-white fw-bold text-decoration-none border-bottom border-2 border-gold pb-1 custom-link">Sign In Instead</a></p>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Breakout CSS */
        .full-width-breakout {
            width: 100vw;
            position: relative;
            left: 50%;
            right: 50%;
            margin-left: -50vw;
            margin-right: -50vw;
        }

        .hero-wrapper {
            background: #0f1c18;
            margin-top: -80px; /* Offset for navbar */
        }

        .stadium-lights-backdrop {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(135deg, rgba(26,60,52,0.90), rgba(15,28,24,0.95)), 
                        url('https://images.unsplash.com/photo-1518605368461-1ee712c9b4e6?auto=format&fit=crop&q=80&w=1920');
            background-size: cover;
            background-position: center;
        }

        .hero-dark-overlay {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: radial-gradient(circle at center, rgba(201,168,76,0.1), transparent 60%);
            pointer-events: none;
        }

        .backdrop-blur-md {
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255,255,255,0.1) !important;
        }

        .text-gold { color: #C9A84C !important; }
        .border-gold { border-color: #C9A84C !important; }
        .text-light-gray { color: #cbd5e1; }
        
        .bg-gold-gradient {
            background: linear-gradient(135deg, #E5BA44, #C9A84C);
        }

        .btn-gold {
            background: linear-gradient(135deg, #E5BA44, #C9A84C);
            border: none;
            transition: all 0.3s;
        }

        .btn-gold:hover {
            background: linear-gradient(135deg, #F0CC5F, #B8952F);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(201,168,76,0.3) !important;
        }

        .custom-link {
            transition: all 0.3s ease;
        }
        
        .custom-link:hover {
            color: #F0CC5F !important;
            opacity: 0.8;
        }

        .shadow-2xl {
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5) !important;
        }

        .ls-1 { letter-spacing: 1px; }
        .border-dashed { border-style: dashed !important; border-width: 2px !important; }
        
        .form-control::placeholder {
            color: rgba(255,255,255,0.3);
        }
        
        .form-control:focus, .form-select:focus {
            background-color: rgba(255,255,255,0.15) !important;
            color: white;
            border-color: transparent;
            box-shadow: 0 0 0 0.25rem rgba(201,168,76,0.25);
        }

        .input-group-text {
            border-top-left-radius: 12px;
            border-bottom-left-radius: 12px;
        }
        
        .form-control, .form-select {
            border-top-right-radius: 12px;
            border-bottom-right-radius: 12px;
        }

        select.custom-select {
            /* Fallback */
        }

        /* Select2 Dark Theme Custom Styling */
        .select2-container .select2-selection--single {
            height: calc(3.5rem + 2px);
            border: none;
            background-color: rgba(255, 255, 255, 0.1) !important;
            border-top-right-radius: 12px;
            border-bottom-right-radius: 12px;
            display: flex;
            align-items: center;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: #fff !important;
            font-size: 1rem;
            line-height: inherit;
            padding-left: 1rem;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 100%;
            right: 15px;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow b {
            border-color: #C9A84C transparent transparent transparent;
        }
        .select2-dropdown {
            background-color: #0f1c18;
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            overflow: hidden;
        }
        .select2-container--default .select2-results__option {
            color: #fff;
            padding: 12px 15px;
        }
        .select2-container--default .select2-results__option--highlighted[aria-selected] {
            background-color: #C9A84C;
            color: #0f1c18;
        }
        .select2-container--default .select2-search--dropdown .select2-search__field {
            background-color: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            color: white;
            border-radius: 6px;
        }

        .animate-up {
            animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            opacity: 0;
            transform: translateY(20px);
        }
        
        @@keyframes fadeInUp {
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            var roles = @Html.Raw(Json.Serialize(ViewBag.Roles));

            $('#roleSelect').select2({
                placeholder: "-- Select Purpose --",
                minimumResultsForSearch: Infinity, /* Hide search bar for small list */
                width: '100%'
            });

            $('#roleSelect').on('change', function() {
                var selectedRoleId = $(this).val();
                var selectedRole = roles.find(r => r.roleId == selectedRoleId);
                
                if (selectedRole && selectedRole.roleName === "TurfOwner") {
                    $('#turfOwnerFields').slideDown();
                } else {
                    $('#turfOwnerFields').slideUp();
                }
            });

            // Trigger on load if validation failed and it was TurfOwner
            $('#roleSelect').trigger('change');
        });
    </script>
}
