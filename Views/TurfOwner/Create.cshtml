@model turf_management_system.DTOs.Turf.CreateTurfDto
@{
    Layout = "_TurfOwnerLayout";
    ViewData["Title"] = "Turf Creation Wizard";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <!-- Wizard Header -->
            <div class="card border-0 shadow-sm mb-4 overflow-hidden">
                <div class="card-body p-0">
                    <div class="wizard-steps d-flex">
                        <div class="wizard-step active" id="step1-indicator">
                            <span class="step-num">1</span>
                            <span class="step-title">Turf Info</span>
                        </div>
                        <div class="wizard-step" id="step2-indicator">
                            <span class="step-num">2</span>
                            <span class="step-title">Gallery</span>
                        </div>
                        <div class="wizard-step" id="step3-indicator">
                            <span class="step-num">3</span>
                            <span class="step-title">Availability</span>
                        </div>
                        <div class="wizard-step" id="step4-indicator">
                            <span class="step-num">4</span>
                            <span class="step-title">Review</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 1: Turf Info -->
            <div class="wizard-content" id="step1-container">
                <div class="card border-0 shadow-sm animate__animated animate__fadeIn">
                    <div class="card-header bg-white py-3 border-0">
                        <h4 class="mb-0 fw-bold"><i class="fas fa-info-circle text-primary me-2"></i> Step 1: Basic Information</h4>
                        <p class="text-muted small mb-0">Fill in the core details of your turf.</p>
                    </div>
                    <div class="card-body p-4">
                        <form id="form-step1" class="needs-validation" novalidate>
                            <div class="row g-4">
                                <div class="col-md-8">
                                    <label class="form-label fw-bold">Turf Name <span class="text-danger">*</span></label>
                                    <input type="text" name="name" class="form-control form-control-lg" required placeholder="e.g. Dream Arena" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Sport Type <span class="text-danger">*</span></label>
                                    <select name="sportType" class="form-select form-select-lg" required>
                                        <option value="">Select...</option>
                                        <option value="Football">Football</option>
                                        <option value="Cricket">Cricket</option>
                                        <option value="Basketball">Basketball</option>
                                        <option value="Badminton">Badminton</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">City <span class="text-danger">*</span></label>
                                    <input type="text" name="city" class="form-control" required placeholder="e.g. Dhaka" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Base Price per Hour (৳) <span class="text-danger">*</span></label>
                                    <input type="number" name="pricePerHour" class="form-control" required placeholder="1500" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Morning Price per Hour (৳) <span class="text-danger">*</span></label>
                                    <input type="number" name="morningPricePerHour" class="form-control" required placeholder="1200" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Evening Price per Hour (৳) <span class="text-danger">*</span></label>
                                    <input type="number" name="eveningPricePerHour" class="form-control" required placeholder="1800" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Turf Size <span class="text-danger">*</span></label>
                                    <input type="text" name="turfSize" class="form-control" required placeholder="e.g. 120ft x 80ft or 5v5" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Indoor / Outdoor <span class="text-danger">*</span></label>
                                    <div class="d-flex gap-3">
                                        <div class="form-check border p-2 px-3 rounded-3 flex-fill text-center">
                                            <input class="form-check-input d-none" type="radio" name="indoorOutdoor" id="radioIndoor" value="Indoor" required>
                                            <label class="form-check-label w-100 pointer" for="radioIndoor">Indoor</label>
                                        </div>
                                        <div class="form-check border p-2 px-3 rounded-3 flex-fill text-center">
                                            <input class="form-check-input d-none" type="radio" name="indoorOutdoor" id="radioOutdoor" value="Outdoor" required>
                                            <label class="form-check-label w-100 pointer" for="radioOutdoor">Outdoor</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label fw-bold">Full Address <span class="text-danger">*</span></label>
                                    <textarea name="location" class="form-control" rows="2" required placeholder="Detailed location to help users find you..."></textarea>
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label fw-bold">Description</label>
                                    <textarea name="description" class="form-control" rows="4" placeholder="Mention rules, amenities, lighting etc..."></textarea>
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label fw-bold">Amenities</label>
                                    <input type="text" name="amenities" class="form-control" placeholder="Parking, Washroom, Night Lights, Cafeteria (comma separated)" />
                                </div>
                            </div>
                            <div class="d-flex justify-content-end mt-5">
                                <button type="submit" class="btn btn-primary px-5 py-3 rounded-pill fw-bold" id="btn-step1-next">
                                    Next: Upload Gallery <i class="fas fa-arrow-right ms-2"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Step 2: Gallery -->
            <div class="wizard-content d-none" id="step2-container">
                <div class="card border-0 shadow-sm animate__animated animate__fadeIn">
                    <div class="card-header bg-white py-3 border-0">
                        <h4 class="mb-0 fw-bold"><i class="fas fa-images text-primary me-2"></i> Step 2: Turf Gallery</h4>
                        <p class="text-muted small mb-0">High-quality photos attract 3x more bookings.</p>
                    </div>
                    <div class="card-body p-4">
                        <div class="upload-zone p-5 text-center border-dashed rounded-4 mb-4" id="drop-zone">
                            <i class="fas fa-cloud-upload-alt fa-3x text-primary mb-3"></i>
                            <h5 class="fw-bold">Drag and drop images here</h5>
                            <p class="text-muted">or click to browse from your computer</p>
                            <input type="file" id="file-input" multiple accept="image/*" class="d-none" />
                            <button type="button" class="btn btn-outline-primary px-4 mt-2" onclick="$('#file-input').click()">Browse Files</button>
                            <p class="small text-muted mt-3">JPG, PNG, WebP (Max 5MB per file)</p>
                        </div>

                        <div id="gallery-preview" class="row g-3">
                            <!-- Previews injected here -->
                        </div>

                        <div class="d-flex justify-content-between mt-5">
                            <button type="button" class="btn btn-outline-secondary px-5 py-3 rounded-pill fw-bold" onclick="prevStep(1)">
                                <i class="fas fa-arrow-left me-2"></i> Back
                            </button>
                            <button type="button" class="btn btn-primary px-5 py-3 rounded-pill fw-bold" id="btn-step2-next">
                                Next: Set Availability <i class="fas fa-arrow-right ms-2"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 3: Availability -->
            <div class="wizard-content d-none" id="step3-container">
                <div class="card border-0 shadow-sm animate__animated animate__fadeIn">
                    <div class="card-header bg-white py-3 border-0">
                        <h4 class="mb-0 fw-bold"><i class="fas fa-calendar-alt text-primary me-2"></i> Step 3: Availability & Payments</h4>
                        <p class="text-muted small mb-0">Configure when you are open and how you accept payments.</p>
                    </div>
                    <div class="card-body p-4">
                        <form id="form-step3">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <div class="p-3 border rounded-4">
                                        <h6 class="fw-bold mb-3">Operating Hours</h6>
                                        <div class="row g-2 mb-3">
                                            <div class="col-6">
                                                <label class="form-label small">Opening Time</label>
                                                <input type="time" name="openingTime" class="form-control" value="06:00" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small">Closing Time</label>
                                                <input type="time" name="closingTime" class="form-control" value="22:00" />
                                            </div>
                                        </div>
                                        <label class="form-label small">Slot Duration</label>
                                        <select name="slotDurationMinutes" class="form-select">
                                            <option value="30">30 Minutes</option>
                                            <option value="60" selected>1 Hour</option>
                                            <option value="90">1.5 Hours</option>
                                            <option value="120">2 Hours</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 border rounded-4">
                                        <h6 class="fw-bold mb-3">Booking Rules</h6>
                                        <label class="form-label small">Advance Booking Limit (Days)</label>
                                        <input type="number" name="maxAdvanceBookingDays" class="form-control mb-3" value="7" />
                                        
                                        <div class="form-check form-switch mb-2">
                                            <input class="form-check-input" type="checkbox" name="requireFullPayment" id="checkFullPay">
                                            <label class="form-check-label fw-bold" for="checkFullPay">Require Full Payment for booking</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="p-3 border rounded-4">
                                        <h6 class="fw-bold mb-3">Accepted Payment Methods</h6>
                                        <div class="d-flex flex-wrap gap-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="acceptBkash" id="payBkash" checked>
                                                <label class="form-check-label" for="payBkash">bKash</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="acceptNagad" id="payNagad" checked>
                                                <label class="form-check-label" for="payNagad">Nagad</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="acceptRocket" id="payRocket" checked>
                                                <label class="form-check-label" for="payRocket">Rocket</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="p-3 border rounded-4">
                                        <h6 class="fw-bold mb-3">Available Days</h6>
                                        <div class="d-flex flex-wrap gap-3" id="days-selector">
                                            <button type="button" class="btn btn-outline-primary active" data-day="1">Sun</button>
                                            <button type="button" class="btn btn-outline-primary active" data-day="2">Mon</button>
                                            <button type="button" class="btn btn-outline-primary active" data-day="4">Tue</button>
                                            <button type="button" class="btn btn-outline-primary active" data-day="8">Wed</button>
                                            <button type="button" class="btn btn-outline-primary active" data-day="16">Thu</button>
                                            <button type="button" class="btn btn-outline-primary active" data-day="32">Fri</button>
                                            <button type="button" class="btn btn-outline-primary active" data-day="64">Sat</button>
                                        </div>
                                        <input type="hidden" name="availableDaysMask" value="127" />
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between mt-5">
                                <button type="button" class="btn btn-outline-secondary px-5 py-3 rounded-pill fw-bold" onclick="prevStep(2)">
                                    <i class="fas fa-arrow-left me-2"></i> Back
                                </button>
                                <button type="submit" class="btn btn-primary px-5 py-3 rounded-pill fw-bold" id="btn-step3-next">
                                    Next: Final Review <i class="fas fa-arrow-right ms-2"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Step 4: Finish -->
            <div class="wizard-content d-none" id="step4-container">
                <div class="card border-0 shadow-sm animate__animated animate__fadeIn">
                    <div class="card-header bg-white py-3 border-0">
                        <h4 class="mb-0 fw-bold"><i class="fas fa-check-circle text-success me-2"></i> Step 4: Final Review</h4>
                        <p class="text-muted small mb-0">Review your turf details before publishing.</p>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4">
                            <div class="col-md-7">
                                <h5 class="fw-bold border-bottom pb-2 mb-3">Turf Details</h5>
                                <div id="summary-info">
                                    <!-- Summary injected here -->
                                </div>
                            </div>
                            <div class="col-md-5">
                                <h5 class="fw-bold border-bottom pb-2 mb-3">Media</h5>
                                <div id="summary-gallery" class="row g-2">
                                    <!-- Gallery injected here -->
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-warning mt-5 rounded-4 border-0 shadow-sm d-flex align-items-center">
                            <i class="fas fa-exclamation-triangle fa-2x me-3"></i>
                            <div>
                                <h6 class="fw-bold mb-1">Ready to Publish?</h6>
                                <p class="mb-0 small">Once published, our team will review your turf. Approved turfs are immediately visible to customers.</p>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-5">
                            <button type="button" class="btn btn-outline-secondary px-5 py-3 rounded-pill fw-bold" onclick="prevStep(3)">
                                <i class="fas fa-arrow-left me-2"></i> Back
                            </button>
                            <div class="d-flex gap-3">
                                <button type="button" class="btn btn-light px-4 py-3 rounded-pill fw-bold" id="btn-save-draft">Save as Draft</button>
                                <button type="button" class="btn btn-success px-5 py-3 rounded-pill fw-bold" id="btn-publish">
                                    Publish Turf <i class="fas fa-rocket ms-2"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <style>
        .wizard-steps { border-radius: 12px; }
        .wizard-step {
            flex: 1;
            padding: 20px;
            text-align: center;
            background: #f8f9fa;
            position: relative;
            transition: all 0.3s;
            cursor: pointer;
            border-right: 1px solid #eee;
        }
        .wizard-step:last-child { border-right: none; }
        .wizard-step.active { background: #fff; color: var(--bs-primary); }
        .wizard-step.completed { background: #e9ecef; }
        .wizard-step.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: var(--bs-primary);
        }
        .step-num {
            width: 28px;
            height: 28px;
            display: inline-block;
            background: #dee2e6;
            color: #495057;
            border-radius: 50%;
            line-height: 28px;
            font-weight: bold;
            margin-bottom: 5px;
            font-size: 14px;
        }
        .wizard-step.active .step-num { background: var(--bs-primary); color: #fff; }
        .wizard-step.completed .step-num { background: #198754; color: #fff; }
        .step-title { display: block; font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; }
        
        .upload-zone { border: 2px dashed #dee2e6; transition: all 0.2s; cursor: pointer; }
        .upload-zone:hover { border-color: var(--bs-primary); background: rgba(var(--bs-primary-rgb), 0.05); }
        .pointer { cursor: pointer; }
        .border-dashed { border-style: dashed !important; }
        
        .gallery-item { position: relative; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
        .gallery-item img { width: 100%; height: 160px; object-fit: cover; }
        .gallery-remove { position: absolute; top: 8px; right: 8px; background: rgba(255,255,255,0.9); border-radius: 50%; width: 28px; height: 28px; border: none; color: #dc3545; }
        .gallery-remove:hover { background: #dc3545; color: #fff; }

        .form-check-input:checked + .form-check-label { color: var(--bs-primary); font-weight: bold; }
        .form-check.border:has(.form-check-input:checked) { border-color: var(--bs-primary) !important; background: rgba(var(--bs-primary-rgb), 0.05); }

        #days-selector .btn { border-radius: 50px; min-width: 60px; }
        #days-selector .btn.active { background-color: var(--bs-primary); color: white; }
    </style>
}

@section Scripts {
    <script>
        'use strict';

        // ── State ─────────────────────────────────────────────────────────────────
        let currentTurfId = null;
        let galleryImages = [];

        // ── Utilities ─────────────────────────────────────────────────────────────
        const parseRes = (r) => ({
            success: r?.success ?? r?.Success ?? false,
            message: r?.message || r?.Message || 'Unexpected error.',
            data: r?.data ?? r?.Data ?? null
        });

        function getServerError(responseJson, httpStatus) {
            if (!responseJson) return `HTTP ${httpStatus} error. Please try again.`;
            // ASP.NET Core validation errors: { errors: { "Field": ["msg"] } }
            if (responseJson.errors) {
                const firstKey = Object.keys(responseJson.errors)[0];
                const msgs = responseJson.errors[firstKey];
                return Array.isArray(msgs) ? msgs[0] : String(msgs);
            }
            return responseJson.message || responseJson.Message || responseJson.title || `HTTP ${httpStatus} error.`;
        }

        function setLoading(btn, loading, originalHtml) {
            if (loading) {
                btn.dataset.original = btn.innerHTML;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving…';
                btn.disabled = true;
            } else {
                btn.innerHTML = originalHtml || btn.dataset.original || btn.innerHTML;
                btn.disabled = false;
            }
        }

        // ── Wizard Navigation ─────────────────────────────────────────────────────
        function showStep(step) {
            document.querySelectorAll('.wizard-content').forEach(el => el.classList.add('d-none'));
            document.getElementById(`step${step}-container`).classList.remove('d-none');
            document.querySelectorAll('.wizard-step').forEach((el, i) => {
                el.classList.remove('active', 'completed');
                if (i + 1 < step) el.classList.add('completed');
                if (i + 1 === step) el.classList.add('active');
            });
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function prevStep(step) { showStep(step); }

        // ══════════════════════════════════════════════════════════════════════════
        // STEP 1 — Basic Info
        // THE ROOT CAUSE FIX: serializeArray() returns ALL values as strings.
        // pricePerHour: "1500" (string) → System.Text.Json CANNOT deserialize to
        // decimal → 400 Bad Request → form never advances to step 2.
        // Fix: build payload manually with correct JS types.
        // ══════════════════════════════════════════════════════════════════════════
        document.getElementById('form-step1').addEventListener('submit', async function (e) {
            e.preventDefault();
            const btn = document.getElementById('btn-step1-next');
            setLoading(btn, true);

            // Build payload with CORRECT TYPES (not strings from serializeArray)
            const payload = {
                name:          this.querySelector('[name="name"]').value.trim(),
                sportType:     this.querySelector('[name="sportType"]').value,
                city:          this.querySelector('[name="city"]').value.trim(),
                pricePerHour:  parseFloat(this.querySelector('[name="pricePerHour"]').value) || 0,
                morningPricePerHour: parseFloat(this.querySelector('[name="morningPricePerHour"]').value) || 0,
                eveningPricePerHour: parseFloat(this.querySelector('[name="eveningPricePerHour"]').value) || 0,
                turfSize:      this.querySelector('[name="turfSize"]').value.trim() || null,
                indoorOutdoor: (this.querySelector('[name="indoorOutdoor"]:checked') || {}).value || null,
                location:      this.querySelector('[name="location"]').value.trim(),
                description:   this.querySelector('[name="description"]').value.trim() || null,
                amenities:     this.querySelector('[name="amenities"]').value.trim() || null
            };

            // Client-side guard
            if (!payload.name)         { toastr.warning('Turf name is required.');        setLoading(btn, false); return; }
            if (!payload.sportType)    { toastr.warning('Sport type is required.');       setLoading(btn, false); return; }
            if (!payload.city)         { toastr.warning('City is required.');             setLoading(btn, false); return; }
            if (payload.pricePerHour <= 0) { toastr.warning('Enter a valid base price.');     setLoading(btn, false); return; }
            if (payload.morningPricePerHour <= 0) { toastr.warning('Enter a valid morning price.'); setLoading(btn, false); return; }
            if (payload.eveningPricePerHour <= 0) { toastr.warning('Enter a valid evening price.'); setLoading(btn, false); return; }
            if (!payload.location)     { toastr.warning('Full address is required.');    setLoading(btn, false); return; }

            try {
                const response = await fetch('/api/turfs', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(payload)
                });

                let result;
                try { result = await response.json(); } catch { result = null; }

                if (response.ok) {
                    const res = parseRes(result);
                    if (res.success && res.data) {
                        currentTurfId = res.data.id || res.data.Id;
                        toastr.success('Basic info saved! Now upload some photos.');
                        showStep(2);
                    } else {
                        toastr.error(res.message);
                    }
                } else {
                    toastr.error(getServerError(result, response.status));
                    console.error('[Step1] Server error:', response.status, result);
                }
            } catch (err) {
                console.error('[Step1] Fetch error:', err);
                toastr.error('Connection error. Please check your network and try again.');
            } finally {
                setLoading(btn, false);
            }
        });

        // ══════════════════════════════════════════════════════════════════════════
        // STEP 2 — Gallery / Image Upload
        // ══════════════════════════════════════════════════════════════════════════
        const dropZone   = document.getElementById('drop-zone');
        const fileInput  = document.getElementById('file-input');

        dropZone.addEventListener('click',     () => fileInput.click());
        dropZone.addEventListener('dragover',  e  => { e.preventDefault(); dropZone.classList.add('bg-light'); });
        dropZone.addEventListener('dragleave', ()  => dropZone.classList.remove('bg-light'));
        dropZone.addEventListener('drop',      e  => {
            e.preventDefault();
            dropZone.classList.remove('bg-light');
            uploadFiles(e.dataTransfer.files);
        });
        fileInput.addEventListener('change', function () { uploadFiles(this.files); });

        document.getElementById('btn-step2-next').addEventListener('click', () => showStep(3));

        async function uploadFiles(files) {
            if (!currentTurfId) {
                toastr.error('Please complete Step 1 first!');
                return;
            }
            for (const file of Array.from(files)) {
                if (file.size > 5 * 1024 * 1024) {
                    toastr.warning(`${file.name} exceeds 5 MB — skipped.`);
                    continue;
                }
                const isMain    = galleryImages.length === 0;
                const uploadBtn = document.getElementById('btn-step2-next');
                const origHtml  = uploadBtn.innerHTML;
                uploadBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Uploading…';
                uploadBtn.disabled  = true;

                const fd = new FormData();
                fd.append('image', file);         // must match [FromForm] IFormFile image

                try {
                    const response = await fetch(
                        `/api/turfs/${currentTurfId}/images?isMain=${isMain}`,
                        {
                            method:  'POST',
                            headers: { 'X-Requested-With': 'XMLHttpRequest' },
                            body:    fd
                            // DO NOT set Content-Type — browser sets multipart boundary automatically
                        }
                    );

                    let result;
                    try { result = await response.json(); } catch { result = null; }

                    if (response.ok && parseRes(result).success) {
                        toastr.success(`${file.name} uploaded!`);
                        await refreshGallery();
                    } else {
                        toastr.error(getServerError(result, response.status));
                        console.error('[Upload] Error:', response.status, result);
                    }
                } catch (err) {
                    console.error('[Upload] Fetch error:', err);
                    toastr.error(`Failed to upload ${file.name}. Check network.`);
                } finally {
                    uploadBtn.innerHTML = origHtml;
                    uploadBtn.disabled  = false;
                }
            }
        }

        async function refreshGallery() {
            if (!currentTurfId) return;
            try {
                const response = await fetch(`/api/turfs/${currentTurfId}`);
                const result   = await response.json();
                const res      = parseRes(result);
                if (res.success && res.data) {
                    galleryImages = res.data.images || [];
                    renderGallery(galleryImages);
                }
            } catch (err) {
                console.error('[Gallery] Refresh error:', err);
            }
        }

        function renderGallery(images) {
            const container = document.getElementById('gallery-preview');
            container.innerHTML = '';
            images.forEach(img => {
                const url    = img.imageUrl || img.ImageUrl || '';
                const id     = img.id       || img.Id;
                const isMain = img.isMain   || img.IsMain;
                const col    = document.createElement('div');
                col.className = 'col-md-3 col-sm-6';
                col.innerHTML = `
                    <div class="gallery-item ${isMain ? 'border border-primary border-4 shadow' : ''}">
                        <img src="${url}" style="width:100%;height:150px;object-fit:cover;" class="rounded" alt="Turf image" />
                        <button type="button" class="gallery-remove btn btn-sm btn-danger" onclick="deleteImage('${id}')">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                        ${isMain ? '<div class="bg-primary text-white text-center small py-1 rounded-bottom fw-bold">Primary Photo</div>' : ''}
                    </div>`;
                container.appendChild(col);
            });
        }

        async function deleteImage(imageId) {
            try {
                const response = await fetch(`/api/turfs/images/${imageId}`, {
                    method:  'DELETE',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const result = await response.json();
                if (parseRes(result).success) {
                    galleryImages = galleryImages.filter(i => (i.id || i.Id) !== imageId);
                    await refreshGallery();
                    toastr.success('Image removed.');
                } else {
                    toastr.error('Failed to delete image.');
                }
            } catch (err) {
                toastr.error('Connection error while deleting.');
            }
        }

        // ══════════════════════════════════════════════════════════════════════════
        // STEP 3 — Booking Config
        // ══════════════════════════════════════════════════════════════════════════
        document.querySelectorAll('#days-selector .btn').forEach(btn => {
            btn.addEventListener('click', function () {
                this.classList.toggle('active');
                updateDaysMask();
            });
        });

        function updateDaysMask() {
            let mask = 0;
            document.querySelectorAll('#days-selector .btn.active').forEach(b => {
                mask += parseInt(b.dataset.day, 10) || 0;
            });
            document.querySelector('[name="availableDaysMask"]').value = mask;
        }

        document.getElementById('form-step3').addEventListener('submit', async function (e) {
            e.preventDefault();
            const btn = document.getElementById('btn-step3-next');
            setLoading(btn, true);

            const payload = {
                openingTime:          this.querySelector('[name="openingTime"]').value,
                closingTime:          this.querySelector('[name="closingTime"]').value,
                slotDurationMinutes:  parseInt(this.querySelector('[name="slotDurationMinutes"]').value, 10),
                maxAdvanceBookingDays:parseInt(this.querySelector('[name="maxAdvanceBookingDays"]').value, 10),
                requireFullPayment:   this.querySelector('[name="requireFullPayment"]').checked,
                acceptBkash:          this.querySelector('[name="acceptBkash"]').checked,
                acceptNagad:          this.querySelector('[name="acceptNagad"]').checked,
                acceptRocket:         this.querySelector('[name="acceptRocket"]').checked,
                availableDaysMask:    parseInt(this.querySelector('[name="availableDaysMask"]').value, 10) || 127
            };

            try {
                const response = await fetch(`/api/turfs/${currentTurfId}/booking-config`, {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body:    JSON.stringify(payload)
                });

                let result;
                try { result = await response.json(); } catch { result = null; }

                if (response.ok && parseRes(result).success) {
                    toastr.success('Booking rules saved! Time slots auto-generated.');
                    showStep(4);
                    loadSummary();
                } else {
                    toastr.error(getServerError(result, response.status));
                    console.error('[Step3] Error:', response.status, result);
                }
            } catch (err) {
                console.error('[Step3] Fetch error:', err);
                toastr.error('Connection error while saving booking rules.');
            } finally {
                setLoading(btn, false);
            }
        });

        // ══════════════════════════════════════════════════════════════════════════
        // STEP 4 — Review & Publish
        // ══════════════════════════════════════════════════════════════════════════
        async function loadSummary() {
            if (!currentTurfId) return;
            try {
                const response = await fetch(`/api/turfs/${currentTurfId}`);
                const result   = await response.json();
                const res      = parseRes(result);
                if (res.success && res.data) {
                    const t = res.data;
                    document.getElementById('summary-info').innerHTML = `
                        <div class="row g-3">
                            <div class="col-6"><p class="small text-muted mb-0">Turf Name</p><p class="fw-bold text-primary">${t.name}</p></div>
                            <div class="col-6"><p class="small text-muted mb-0">Sport</p><p class="fw-bold">${t.sportType}</p></div>
                            <div class="col-6"><p class="small text-muted mb-0">City</p><p class="fw-bold">${t.city}</p></div>
                            <div class="col-6"><p class="small text-muted mb-0">Base Rate</p><p class="fw-bold text-success">৳ ${t.pricePerHour}/hr</p></div>
                            <div class="col-6"><p class="small text-muted mb-0">Morning Rate</p><p class="fw-bold text-success">৳ ${t.morningPricePerHour}/hr</p></div>
                            <div class="col-6"><p class="small text-muted mb-0">Evening Rate</p><p class="fw-bold text-success">৳ ${t.eveningPricePerHour}/hr</p></div>
                            <div class="col-12"><p class="small text-muted mb-0">Location</p><p class="small">${t.location}</p></div>
                        </div>`;

                    const gall = document.getElementById('summary-gallery');
                    gall.innerHTML = '';
                    (t.images || []).forEach(img => {
                        const url = img.imageUrl || img.ImageUrl;
                        const div = document.createElement('div');
                        div.className = 'col-4 col-md-3';
                        div.innerHTML = `<img src="${url}" class="img-fluid rounded border shadow-sm" style="height:80px;object-fit:cover;" />`;
                        gall.appendChild(div);
                    });

                    if (!t.images || t.images.length === 0) {
                        gall.innerHTML = '<div class="col-12 text-muted small">No images uploaded.</div>';
                    }
                }
            } catch (err) {
                console.error('[Summary] Load error:', err);
            }
        }

        document.getElementById('btn-publish').addEventListener('click', async function () {
            const btn = this;
            setLoading(btn, true);
            try {
                const response = await fetch(`/api/turfs/${currentTurfId}/publish`, {
                    method:  'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                let result;
                try { result = await response.json(); } catch { result = null; }

                if (response.ok && parseRes(result).success) {
                    await Swal.fire({
                        title: 'Submitted for Review!',
                        text:  'Your turf has been submitted. It will be visible to customers once our admin team approves it.',
                        icon:  'success',
                        confirmButtonColor: '#1A3C34',
                        confirmButtonText:  'Go to My Turfs'
                    });
                    window.location.href = '/TurfOwner/MyTurfs';
                } else {
                    toastr.error(getServerError(result, response.status));
                    setLoading(btn, false);
                }
            } catch (err) {
                console.error('[Publish] Error:', err);
                toastr.error('Connection error while publishing.');
                setLoading(btn, false);
            }
        });

        document.getElementById('btn-save-draft').addEventListener('click', function () {
            toastr.info('Progress saved. You can continue later from My Turfs.');
            setTimeout(() => { window.location.href = '/TurfOwner/MyTurfs'; }, 1200);
        });

        // Add toastr & SweetAlert2 if not already in layout
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <link  rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        if (typeof toastr !== 'undefined') {
            toastr.options = { closeButton: true, progressBar: true, positionClass: 'toast-top-right', timeOut: 4000 };
        }
    </script>
}
