@model turf_management_system.Models.Domain.Payment
@using turf_management_system.Models.Domain
@{
    ViewData["Title"] = "Verify Payment";
    Layout = "_TurfOwnerLayout";
}

<div class="container-fluid py-4" style="max-width: 800px;">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="PendingPayments" class="btn btn-outline-secondary me-3 rounded-pill">
            <i class="fas fa-arrow-left"></i>
        </a>
        <div>
            <h4 class="fw-bold mb-0">Verify Payment</h4>
            <p class="text-muted mb-0">Transaction ID: @Model.TransactionId</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column: Payment Details -->
        <div class="col-md-7">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header border-0 bg-transparent px-4 pt-4">
                    <h6 class="fw-bold mb-0">Submission Info</h6>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Customer</span>
                        <span class="fw-bold">@Model.User?.FullName</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Method</span>
                        <span class="badge bg-@(Model.PaymentMethod == PaymentMethod.Bkash ? "danger" : Model.PaymentMethod == PaymentMethod.Nagad ? "warning" : "info") px-3">
                            @Model.PaymentMethod
                        </span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Amount Submitted</span>
                        <span class="fw-bold text-success fs-5">৳@Model.Amount.ToString("F2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Transaction ID</span>
                        <span class="fw-bold text-primary">@Model.TransactionId</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Time Submitted</span>
                        <span class="fw-bold">@Model.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                    </div>
                    <hr>
                    <div class="bg-light p-3 rounded-3">
                        <h6 class="fw-bold small text-uppercase text-muted mb-2">Instructions for Owner</h6>
                        <ul class="small mb-0 ps-3">
                            <li>Check your <strong>@Model.PaymentMethod</strong> merchant app or SMS for TxID: <strong>@Model.TransactionId</strong></li>
                            <li>Verify the amount matches <strong>৳@Model.Amount.ToString("F2")</strong></li>
                            <li>If everything is correct, click <strong>Verify & Confirm</strong></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Booking Context -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header border-0 bg-transparent px-4 pt-4">
                    <h6 class="fw-bold mb-0">Booking Context</h6>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label class="text-muted small d-block">Turf</label>
                        <span class="fw-bold">@Model.Booking?.Turf?.Name</span>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small d-block">Schedule</label>
                        <span class="fw-bold">@Model.Booking?.BookingDate.ToString("dd MMM yyyy")</span>
                        <div class="small">@Model.Booking?.StartTime.ToString(@"hh\:mm") – @Model.Booking?.EndTime.ToString(@"hh\:mm")</div>
                    </div>
                    <div class="mb-0">
                        <label class="text-muted small d-block">Total Booking Fee</label>
                        <span class="fw-bold">৳@Model.Booking?.TotalAmount.ToString("F2")</span>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-grid gap-2">
                <form asp-action="ConfirmPayment" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="paymentId" value="@Model.Id">
                    <button type="submit" class="btn btn-success btn-lg w-100 rounded-3 fw-bold shadow-sm">
                        <i class="fas fa-check-circle me-2"></i>Verify & Confirm
                    </button>
                </form>
                
                <button type="button" class="btn btn-outline-danger btn-lg rounded-3 fw-bold" 
                        data-bs-toggle="modal" data-bs-target="#rejectModal">
                    <i class="fas fa-times me-2"></i>Reject Payment
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Reject Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RejectPayment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="paymentId" value="@Model.Id">
                <div class="modal-body">
                    <div class="alert alert-warning small rounded-3 mb-3">
                        <i class="fas fa-exclamation-triangle me-2"></i>Rejecting a payment will notify the user and ask them to resubmit or contact support.
                    </div>
                    <label class="form-label fw-bold">Reason for Rejection <span class="text-danger">*</span></label>
                    <textarea name="reason" class="form-control" rows="3" required 
                              placeholder="e.g. Transaction ID not found in our records, amount mismatch..."></textarea>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-3 px-4 fw-bold">Reject Now</button>
                </div>
            </form>
        </div>
    </div>
</div>
