@model turf_management_system.Models.Domain.Booking
@using turf_management_system.Models.Domain
@{
    ViewData["Title"] = "Complete Payment";
    var config = ViewBag.Config as TurfBookingConfig;
    var requiredAmount = (decimal)ViewBag.RequiredAmount;
    var lockExpiresAt = (DateTime)ViewBag.LockExpiresAt;
}

<div class="container py-4" style="max-width:700px;">
    <!-- Countdown Timer Banner -->
    <div class="alert alert-warning border-0 rounded-4 d-flex align-items-center shadow-sm mb-4">
        <i class="fas fa-hourglass-half fa-2x me-3 text-warning"></i>
        <div>
            <strong>Slot Reserved!</strong> Complete payment within
            <span id="countdown" class="fw-bold text-danger fs-5">5:00</span>
            or your reservation will be released.
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Booking Summary -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-success text-white rounded-top-4 border-0 p-4">
            <h5 class="mb-0 fw-bold"><i class="fas fa-receipt me-2"></i>Booking Summary</h5>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-6">
                    <div class="text-muted small">Turf</div>
                    <div class="fw-bold">@Model.Turf.Name</div>
                </div>
                <div class="col-6">
                    <div class="text-muted small">Location</div>
                    <div class="fw-bold">@Model.Turf.City</div>
                </div>
                <div class="col-6">
                    <div class="text-muted small">Date</div>
                    <div class="fw-bold">@Model.BookingDate.ToString("dd MMM yyyy")</div>
                </div>
                <div class="col-6">
                    <div class="text-muted small">Time</div>
                    <div class="fw-bold">@Model.StartTime.ToString(@"hh\:mm") – @Model.EndTime.ToString(@"hh\:mm")</div>
                </div>
                <div class="col-6">
                    <div class="text-muted small">Duration</div>
                    <div class="fw-bold">@Model.TotalHours hrs</div>
                </div>
                <div class="col-6">
                    <div class="text-muted small">Booking ID</div>
                    <div class="fw-bold text-primary">#@Model.Id.ToString()[..8].ToUpper()</div>
                </div>
            </div>
            <hr>
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted">Total Amount</span>
                <span class="fw-bold fs-5">৳@Model.TotalAmount.ToString("F2")</span>
            </div>
            @if (config != null && !config.RequireFullPayment)
            {
                <div class="d-flex justify-content-between align-items-center mt-1">
                    <span class="text-muted">Advance Required (@config.AdvancePaymentPercent%)</span>
                    <span class="fw-bold text-success fs-4">৳@requiredAmount.ToString("F2")</span>
                </div>
                <small class="text-muted">Remaining ৳@((Model.TotalAmount - requiredAmount).ToString("F2")) payable at venue.</small>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center mt-1">
                    <span class="text-muted">Amount Due</span>
                    <span class="fw-bold text-success fs-4">৳@requiredAmount.ToString("F2")</span>
                </div>
            }
        </div>
    </div>

    <!-- Payment Form -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-4"><i class="fas fa-mobile-alt me-2 text-success"></i>Mobile Payment</h5>

            <form asp-action="SubmitPayment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" value="@Model.Id">
                <input type="hidden" name="paymentType" value="@(config != null && !config.RequireFullPayment ? "Partial" : "Full")">

                <!-- Payment Method Selection -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Select Payment Method</label>
                    <div class="row g-2">
                        @if (config == null || config.AcceptBkash)
                        {
                            <div class="col-4">
                                <label class="d-block">
                                    <input type="radio" name="paymentMethod" value="Bkash" class="d-none payment-radio" @(config?.AcceptBkash != false ? "checked" : "")>
                                    <div class="payment-method-card rounded-3 border-2 p-3 text-center" data-method="Bkash">
                                        <div style="color:#e2136e; font-size:1.5rem; font-weight:900;">bKash</div>
                                        <small class="text-muted">Send Money</small>
                                    </div>
                                </label>
                            </div>
                        }
                        @if (config == null || config.AcceptNagad)
                        {
                            <div class="col-4">
                                <label class="d-block">
                                    <input type="radio" name="paymentMethod" value="Nagad" class="d-none payment-radio">
                                    <div class="payment-method-card rounded-3 border-2 p-3 text-center" data-method="Nagad">
                                        <div style="color:#f56b00; font-size:1.5rem; font-weight:900;">Nagad</div>
                                        <small class="text-muted">Send Money</small>
                                    </div>
                                </label>
                            </div>
                        }
                        @if (config == null || config.AcceptRocket)
                        {
                            <div class="col-4">
                                <label class="d-block">
                                    <input type="radio" name="paymentMethod" value="Rocket" class="d-none payment-radio">
                                    <div class="payment-method-card rounded-3 border-2 p-3 text-center" data-method="Rocket">
                                        <div style="color:#8e24aa; font-size:1.5rem; font-weight:900;">Rocket</div>
                                        <small class="text-muted">Send Money</small>
                                    </div>
                                </label>
                            </div>
                        }
                    </div>
                </div>

                <!-- Instructions -->
                <div class="alert alert-info rounded-3 mb-4">
                    <h6 class="fw-bold mb-2"><i class="fas fa-info-circle me-1"></i>Payment Instructions</h6>
                    <ol class="mb-0 small">
                        <li>Open your mobile banking app</li>
                        <li>Select <strong>Send Money</strong></li>
                        <li>Send <strong>৳@requiredAmount.ToString("F2")</strong> to: <strong id="merchantNumber">01XXXXXXXXX</strong></li>
                        <li>Enter the transaction ID below</li>
                    </ol>
                </div>

                <!-- Amount -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Payment Amount (৳)</label>
                    <input type="number" name="amount" class="form-control form-control-lg" 
                           value="@requiredAmount" min="@requiredAmount" step="0.01" required>
                </div>

                <!-- Transaction ID -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Transaction ID <span class="text-danger">*</span></label>
                    <input type="text" name="transactionId" class="form-control form-control-lg" 
                           placeholder="e.g. TXN8FG3K9..." required maxlength="100">
                    <small class="text-muted">Enter the 10-digit transaction ID from your payment confirmation SMS.</small>
                </div>

                <button type="submit" class="btn btn-success btn-lg w-100 rounded-3 fw-bold py-3">
                    <i class="fas fa-paper-plane me-2"></i>Submit Payment
                </button>
            </form>
        </div>
    </div>
</div>

<style>
.payment-method-card { border: 2px solid #dee2e6; cursor: pointer; transition: all .2s; }
.payment-method-card.selected { border-color: #198754 !important; background: #f0fff4; }
</style>

@section Scripts {
<script>
    // ── Countdown Timer ───────────────────────────────────────────────────────
    const lockExpires = new Date('@lockExpiresAt.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ssZ")');
    function updateCountdown() {
        const remaining = Math.max(0, lockExpires - new Date());
        const mins = Math.floor(remaining / 60000);
        const secs = Math.floor((remaining % 60000) / 1000);
        document.getElementById('countdown').textContent = `${mins}:${secs.toString().padStart(2,'0')}`;
        if (remaining <= 0) {
            document.getElementById('countdown').textContent = 'EXPIRED';
            alert('Your slot reservation has expired. You will be redirected to My Bookings.');
            window.location.href = '/Booking/MyBookings';
        }
    }
    setInterval(updateCountdown, 1000);
    updateCountdown();

    // ── Payment Method Cards ──────────────────────────────────────────────────
    const merchantNumbers = { Bkash: '01712-345678', Nagad: '01812-345678', Rocket: '01912-345678' };
    document.querySelectorAll('.payment-radio').forEach(radio => {
        radio.addEventListener('change', function() {
            document.querySelectorAll('.payment-method-card').forEach(c => c.classList.remove('selected'));
            this.parentElement.querySelector('.payment-method-card').classList.add('selected');
            document.getElementById('merchantNumber').textContent = merchantNumbers[this.value] || '01XXXXXXXXX';
        });
        if (radio.checked) {
            radio.parentElement.querySelector('.payment-method-card').classList.add('selected');
            document.getElementById('merchantNumber').textContent = merchantNumbers[radio.value] || '01XXXXXXXXX';
        }
    });

    document.querySelectorAll('.payment-method-card').forEach(card => {
        card.addEventListener('click', function() {
            const radio = this.closest('label').querySelector('input[type="radio"]');
            radio.checked = true;
            radio.dispatchEvent(new Event('change'));
        });
    });
</script>
}
