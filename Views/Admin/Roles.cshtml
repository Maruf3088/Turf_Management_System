@model turf_management_system.Models.ViewModels.RoleListVM
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Role Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Role Management</h2>
    <div class="d-flex gap-2">
        <form class="d-flex gap-2" method="get">
            <div class="input-group">
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search roles...">
                <button class="btn btn-success" type="submit"><i class="fas fa-search"></i></button>
            </div>
        </form>
        <a asp-action="CreateRole" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Add Role
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="bg-light">
                <tr>
                    <th style="width: 100px;">#</th>
                    <th>Role Name</th>
                    <th>Created At</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model.PagedRoles.Items)
                {
                    <tr>
                        <td>@role.RoleId</td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-2 text-primary">
                                    <i class="fas fa-user-tag"></i>
                                </div>
                                <strong>@role.RoleName</strong>
                            </div>
                        </td>
                        <td>@role.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td class="text-end">
                            <a asp-action="EditRole" asp-route-id="@role.RoleId" class="btn btn-sm btn-outline-primary" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form asp-action="DeleteRole" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this role?');">
                                <input type="hidden" name="roleId" value="@role.RoleId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.PagedRoles.Items.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">No roles found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    @if (Model.PagedRoles.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.PagedRoles.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Roles" 
                       asp-route-pageNumber="@(Model.PagedRoles.PageNumber - 1)" 
                       asp-route-searchTerm="@Model.SearchTerm">Previous</a>
                </li>
                
                @for (int i = 1; i <= Model.PagedRoles.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PagedRoles.PageNumber ? "active" : "")">
                        <a class="page-link @(i == Model.PagedRoles.PageNumber ? "bg-success border-success" : "")" 
                           asp-action="Roles" asp-route-pageNumber="@i" 
                           asp-route-searchTerm="@Model.SearchTerm">@i</a>
                    </li>
                }

                <li class="page-item @(Model.PagedRoles.PageNumber == Model.PagedRoles.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Roles" 
                       asp-route-pageNumber="@(Model.PagedRoles.PageNumber + 1)" 
                       asp-route-searchTerm="@Model.SearchTerm">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
