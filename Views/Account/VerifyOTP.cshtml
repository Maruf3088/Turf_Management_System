@model turf_management_system.Models.ViewModels.VerifyOtpVM
@{
    ViewData["Title"] = "Verify OTP";
}

<div class="split-layout-wrapper d-flex min-vh-100">
    <!-- Left Side: Visual/Branding (Hidden on mobile) -->
    <div class="brand-side d-none d-lg-flex flex-column justify-content-between position-relative overflow-hidden w-50">
        <div class="brand-bg-image"></div>
        <div class="brand-overlay"></div>
        
        <div class="position-relative z-3 p-5">
            <h3 class="text-white fw-bold display-font">
                <i class="fas fa-leaf text-success me-2"></i> Turf Management
            </h3>
        </div>
        
        <div class="position-relative z-3 p-5 text-white animate-up-slow">
            <div class="glass-badge mb-4 d-inline-block px-3 py-1 rounded-pill small fw-bold tracking-widest text-uppercase">
                Verify Identity
            </div>
            <h1 class="display-4 fw-extrabold mb-4 display-font">Check Your <br/>Inbox.</h1>
            <p class="lead text-white-50 mb-0" style="max-width: 400px;">
                Enter the 6-digit OTP we sent you to prove your identity before creating a new password.
            </p>
        </div>
    </div>

    <!-- Right Side: Form -->
    <div class="form-side w-100 w-lg-50 d-flex align-items-center justify-content-center bg-white position-relative">
        
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>

        <div class="form-container px-4 px-md-5 w-100 position-relative z-3" style="max-width: 500px;">
            <div class="text-center mb-5 animate-up">
                <div class="icon-circle mx-auto mb-4 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center rounded-circle">
                    <i class="fas fa-key fa-2x"></i>
                </div>
                <h2 class="fw-bold mb-2 text-dark display-font">Verify OTP</h2>
                <p class="text-muted">Enter the 6-digit code sent to your email.</p>
            </div>

            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert custom-alert-success border-0 text-success mb-4 rounded-4 p-4 shadow-sm animate-in">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-check-circle fa-2x"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="mb-1 fw-bold">Success</h6>
                            <p class="mb-0 small opacity-75">@ViewBag.SuccessMessage</p>
                        </div>
                    </div>
                </div>
            }

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert custom-alert-danger border-0 text-danger mb-4 rounded-4 p-4 shadow-sm animate-in">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-exclamation-triangle fa-2x"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="mb-1 fw-bold">Verification Failed</h6>
                            <p class="mb-0 small opacity-75">@ViewBag.ErrorMessage</p>
                        </div>
                    </div>
                </div>
            }

            <form asp-action="VerifyOTP" method="post" class="animate-up" style="animation-delay: 0.1s;">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-4 p-3 bg-danger bg-opacity-10 rounded-3"></div>

                <input type="hidden" asp-for="Email" />

                <div class="form-floating mb-4 custom-floating-input">
                    <input asp-for="Email" class="form-control" disabled />
                    <label asp-for="Email"><i class="fas fa-envelope me-2 text-muted"></i>Email</label>
                </div>

                <div class="form-floating mb-4 custom-floating-input">
                    <input asp-for="OTP" type="text" class="form-control" placeholder="123456" autofocus maxlength="6" />
                    <label asp-for="OTP"><i class="fas fa-key me-2 text-muted"></i>6-Digit OTP</label>
                    <span asp-validation-for="OTP" class="text-danger small mt-2 d-block ms-1"></span>
                </div>

                <div class="d-grid mb-4">
                    <button type="submit" class="btn btn-modern-primary btn-lg py-3 fw-bold rounded-4 shadow-sm">
                        Verify OTP <i class="fas fa-arrow-right ms-2 transition-icon"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        header, footer { display: none !important; }
        main[role="main"] { padding: 0 !important; margin: 0 !important; max-width: 100% !important; }
        .container { max-width: 100% !important; padding: 0 !important; }
        .split-layout-wrapper { margin: 0; padding: 0; width: 100vw; overflow-x: hidden; }
        .brand-bg-image { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: url('https://images.unsplash.com/photo-1575361204480-aadea25e6e68?auto=format&fit=crop&q=80&w=1920'); background-size: cover; background-position: center; transform: scale(1.05); transition: transform 10s ease; }
        .brand-side:hover .brand-bg-image { transform: scale(1); }
        .brand-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(135deg, rgba(15,23,42,0.95) 0%, rgba(59,130,246,0.85) 100%); }
        .glass-badge { background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.2); letter-spacing: 2px; }
        .form-side { min-height: 100vh; }
        .icon-circle { width: 72px; height: 72px; transition: transform 0.3s ease, box-shadow 0.3s ease; }
        .icon-circle:hover { transform: translateY(-5px) scale(1.05); box-shadow: 0 10px 25px rgba(13, 110, 253, 0.2); }
        .custom-floating-input .form-control { border: 2px solid #e2e8f0; border-radius: 12px; padding: 1rem 1.25rem; height: auto; font-size: 1rem; font-weight: 500; color: #1e293b; background-color: #f8fafc; transition: all 0.3s ease; }
        .custom-floating-input .form-control:focus { background-color: #fff; border-color: #3b82f6; box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1); }
        .custom-floating-input label { padding: 1rem 1.25rem; color: #64748b; font-weight: 500; }
        .btn-modern-primary { background: #3b82f6; color: white; border: none; transition: all 0.3s ease; }
        .btn-modern-primary:hover { background: #2563eb; transform: translateY(-2px); box-shadow: 0 10px 20px rgba(59, 130, 246, 0.2) !important; color: white; }
        .btn-modern-primary:hover .transition-icon { transform: translateX(5px); }
        .shape { position: absolute; filter: blur(60px); z-index: 1; opacity: 0.5; border-radius: 50%; animation: float 10s infinite ease-in-out alternate; }
        .shape-1 { width: 300px; height: 300px; background: #dbeafe; top: -100px; right: -100px; }
        .shape-2 { width: 400px; height: 400px; background: #f1f5f9; bottom: -150px; left: -150px; animation-delay: -5s; }
        .custom-alert-success { background: #eff6ff; border: 1px solid #bfdbfe !important; }
        .custom-alert-danger { background: #fef2f2; border: 1px solid #fecaca !important; }
        .animate-up { opacity: 0; transform: translateY(20px); animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        .animate-up-slow { opacity: 0; transform: translateY(30px); animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        .animate-in { animation: fadeInScale 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        .transition-icon { transition: transform 0.3s ease; }
        @@keyframes fadeInUp { to { opacity: 1; transform: translateY(0); } }
        @@keyframes fadeInScale { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
        @@keyframes float { 0% { transform: translate(0, 0); } 100% { transform: translate(30px, 30px); } }
        @@media (min-width: 992px) { .w-lg-50 { width: 50% !important; } }
    </style>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
