@model turf_management_system.Models.ViewModels.TurfOwnerDashboardVM
@{
    Layout = "_TurfOwnerLayout";
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4">
    <!-- Success/Error Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4 animate__animated animate__fadeIn">
            <i class="fas fa-check-circle me-2 text-success"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4 animate__animated animate__fadeIn">
            <i class="fas fa-exclamation-circle me-2 text-danger"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Hero Card -->
    <div class="row mb-4 animate__animated animate__fadeIn">
        <div class="col-12">
            <div class="premium-hero p-5 rounded-4 shadow-sm position-relative overflow-hidden mb-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
                <div class="position-relative z-index-1">
                    <span class="badge bg-success text-white px-3 py-2 rounded-pill mb-3 shadow-sm fw-bold">
                        <i class="fas fa-crown text-warning me-2"></i> Turf Owner Portal
                    </span>
                    <h1 class="display-5 fw-bold text-white mb-2">Welcome back, @Model.FullName!</h1>
                    <p class="lead text-white-50 mb-0">Your turf business at a glance. Manage slots, verify payments, and grow your empire.</p>
                </div>
                <div class="hero-decoration" style="position: absolute; top: -50px; right: -50px; width: 300px; height: 300px; background: rgba(255, 255, 255, 0.05); border-radius: 50%;"></div>
            </div>
        </div>
    </div>

    <!-- KYC Banner -->
    @if (Model.VerificationStatus == turf_management_system.Models.Enums.VerificationStatus.Pending || Model.VerificationStatus == turf_management_system.Models.Enums.VerificationStatus.Rejected)
    {
        <div class="row mb-4 animate__animated animate__fadeInUp">
            <div class="col-12">
                <div class="alert alert-warning border-0 shadow-sm rounded-4 p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="fw-bold text-dark mb-1"><i class="fas fa-exclamation-circle text-warning me-2"></i> KYC Verification Required</h5>
                        <p class="mb-0 text-dark">You cannot add turfs or receive bookings until your identity and business are verified.</p>
                    </div>
                    <a asp-controller="TurfOwner" asp-action="KycVerification" class="btn btn-warning fw-bold px-4 rounded-pill">Complete KYC Now</a>
                </div>
            </div>
        </div>
    }
    else if (Model.VerificationStatus == turf_management_system.Models.Enums.VerificationStatus.Submitted)
    {
        <div class="row mb-4 animate__animated animate__fadeInUp">
            <div class="col-12">
                <div class="alert bg-primary-subtle border-0 shadow-sm rounded-4 p-4 d-flex align-items-center">
                    <i class="fas fa-clock text-primary fa-2x me-3"></i>
                    <div>
                        <h5 class="fw-bold text-primary mb-1">Documents Under Review</h5>
                        <p class="mb-0 text-dark">Your KYC documents have been submitted and are pending admin approval. We will notify you once verified.</p>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Financial Stats Row -->
    <div class="row g-4 mb-4">
        <!-- Verified Earnings -->
        <div class="col-xl-3 col-md-6">
            <div class="stats-card h-100 p-4 rounded-4 border-0 shadow-sm bg-white hover-up" style="border-left: 5px solid #10b981 !important;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="stats-icon bg-success-light text-success" style="width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; background-color: #ecfdf5;">
                        <i class="fas fa-wallet fa-lg"></i>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1">Verified</span>
                </div>
                <h6 class="text-secondary text-uppercase small ls-1 fw-bold mb-1">Total Earnings</h6>
                <h2 class="fw-extrabold mb-0 text-success">৳@Model.TotalRevenue.ToString("N0")</h2>
            </div>
        </div>

        <!-- Pending Verifications -->
        <div class="col-xl-3 col-md-6">
            <div class="stats-card h-100 p-4 rounded-4 border-0 shadow-sm bg-white hover-up" style="border-left: 5px solid #f59e0b !important;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="stats-icon bg-warning-light text-warning" style="width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; background-color: #fffbeb;">
                        <i class="fas fa-hourglass-half fa-lg"></i>
                    </div>
                    <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-1">Pending</span>
                </div>
                <h6 class="text-secondary text-uppercase small ls-1 fw-bold mb-1">Pending Validation</h6>
                <h2 class="fw-extrabold mb-0 text-warning">৳@Model.PendingRevenue.ToString("N0")</h2>
            </div>
        </div>

        <!-- Today's Bookings -->
        <div class="col-xl-3 col-md-6">
            <div class="stats-card h-100 p-4 rounded-4 border-0 shadow-sm bg-white hover-up" style="border-left: 5px solid #3b82f6 !important;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="stats-icon bg-primary-light text-primary" style="width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; background-color: #eff6ff;">
                        <i class="fas fa-calendar-day fa-lg"></i>
                    </div>
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1">Today</span>
                </div>
                <h6 class="text-secondary text-uppercase small ls-1 fw-bold mb-1">Today's Bookings</h6>
                <h2 class="fw-extrabold mb-0 text-primary">@Model.TodaysBookings</h2>
            </div>
        </div>

        <!-- Total Bookings -->
        <div class="col-xl-3 col-md-6">
            <div class="stats-card h-100 p-4 rounded-4 border-0 shadow-sm bg-white hover-up" style="border-left: 5px solid #8b5cf6 !important;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="stats-icon bg-purple-light text-purple" style="width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; background-color: #faf5ff; color: #8b5cf6;">
                        <i class="fas fa-history fa-lg"></i>
                    </div>
                    <span class="badge bg-purple bg-opacity-10 text-purple rounded-pill px-3 py-1" style="background-color: #f3e8ff; color: #6b21a8;">Total</span>
                </div>
                <h6 class="text-secondary text-uppercase small ls-1 fw-bold mb-1">Lifetime Bookings</h6>
                <h2 class="fw-extrabold mb-0" style="color: #6b21a8;">@Model.TotalBookings</h2>
            </div>
        </div>
    </div>

    <!-- Main Layout Container -->
    <div class="row">
        <!-- Left Column: Pending Payments & Recent Bookings -->
        <div class="col-lg-8 mb-4">
            <!-- Pending Payment Verifications Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                <div class="card-header bg-white py-3 border-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-coins me-2 text-warning"></i>Pending Payment Verifications</h5>
                        <a asp-controller="TurfOwnerBooking" asp-action="PendingPayments" class="btn btn-sm btn-light rounded-pill px-3 fw-bold">View Queue</a>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentPayments == null || !Model.RecentPayments.Any())
                    {
                        <div class="p-5 text-center text-muted">
                            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                <i class="fas fa-check fa-lg text-success"></i>
                            </div>
                            <h6 class="fw-bold text-dark">Queue is Clear!</h6>
                            <p class="small mb-0">No booking payments are currently awaiting verification.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr class="small text-uppercase text-secondary font-monospace" style="font-size: 0.75rem;">
                                        <th class="ps-4">Customer</th>
                                        <th>Gateway</th>
                                        <th>Transaction ID</th>
                                        <th>Amount</th>
                                        <th class="text-end pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var payment in Model.RecentPayments)
                                    {
                                        var gatewayBadge = payment.PaymentMethod switch
                                        {
                                            turf_management_system.Models.Domain.PaymentMethod.Bkash => "bg-danger bg-opacity-10 text-danger",
                                            turf_management_system.Models.Domain.PaymentMethod.Nagad => "bg-warning bg-opacity-10 text-warning",
                                            turf_management_system.Models.Domain.PaymentMethod.Rocket => "bg-purple bg-opacity-10 text-purple",
                                            _ => "bg-secondary bg-opacity-10 text-secondary"
                                        };
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold text-dark">@payment.User?.FullName</div>
                                                <small class="text-secondary small">@payment.SubmittedAt.ToString("dd MMM, hh:mm tt")</small>
                                            </td>
                                            <td>
                                                <span class="badge rounded-pill @gatewayBadge px-3 py-1 fw-bold">@payment.PaymentMethod.ToString()</span>
                                            </td>
                                            <td>
                                                <span class="font-monospace text-secondary fw-bold">@payment.TransactionId</span>
                                            </td>
                                            <td>
                                                <strong class="text-success">৳@payment.Amount.ToString("F0")</strong>
                                            </td>
                                            <td class="text-end pe-4">
                                                <div class="d-flex justify-content-end gap-2">
                                                    <a asp-controller="TurfOwnerBooking" asp-action="VerifyPayment" asp-route-paymentId="@payment.Id" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold">
                                                        <i class="fas fa-check-double me-1"></i>Verify
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- Recent Booking History Card -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white py-3 border-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-history me-2 text-primary"></i>Recent Activity</h5>
                        <a asp-controller="TurfOwnerBooking" asp-action="Bookings" class="btn btn-sm btn-light rounded-pill px-3 fw-bold">View History</a>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentBookings == null || !Model.RecentBookings.Any())
                    {
                        <div class="p-5 text-center text-muted">
                            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                <i class="fas fa-calendar-alt fa-lg"></i>
                            </div>
                            <h6 class="fw-bold text-dark">No Activity Yet</h6>
                            <p class="small mb-0">Bookings history will list here as soon as reservations occur.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr class="small text-uppercase text-secondary font-monospace" style="font-size: 0.75rem;">
                                        <th class="ps-4">Booking Details</th>
                                        <th>Customer</th>
                                        <th>Schedule</th>
                                        <th>Status</th>
                                        <th class="text-end pe-4">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var booking in Model.RecentBookings)
                                    {
                                        var statusBadge = booking.Status switch
                                        {
                                            turf_management_system.Models.Domain.BookingStatus.Confirmed => "bg-success bg-opacity-10 text-success",
                                            turf_management_system.Models.Domain.BookingStatus.PendingPayment => "bg-warning bg-opacity-10 text-warning",
                                            turf_management_system.Models.Domain.BookingStatus.Cancelled => "bg-danger bg-opacity-10 text-danger",
                                            _ => "bg-secondary bg-opacity-10 text-secondary"
                                        };
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold text-dark">@booking.Turf?.Name</div>
                                                <small class="text-muted">#@booking.Id.ToString()[..8].ToUpper()</small>
                                            </td>
                                            <td>
                                                <div class="fw-bold">@booking.User?.FullName</div>
                                                <small class="text-secondary small">@booking.User?.PhoneNumber</small>
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark">@booking.BookingDate.ToString("dd MMM yyyy")</div>
                                                <small class="text-secondary small">@booking.StartTime.ToString(@"hh\:mm") – @booking.EndTime.ToString(@"hh\:mm")</small>
                                            </td>
                                            <td>
                                                <span class="badge rounded-pill @statusBadge px-3 py-1 fw-bold">@booking.Status</span>
                                            </td>
                                            <td class="text-end pe-4">
                                                <a asp-controller="Booking" asp-action="Confirmation" asp-route-bookingId="@booking.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Details</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: Upcoming Booking Slots / Calendar details -->
        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                <div class="card-header bg-dark py-3 border-0 text-white">
                    <h5 class="fw-bold mb-0 d-flex align-items-center">
                        <i class="fas fa-calendar-check text-success me-2"></i>Upcoming Bookings
                    </h5>
                </div>
                <div class="card-body p-4 bg-light">
                    @if (Model.UpcomingBookings == null || !Model.UpcomingBookings.Any())
                    {
                        <div class="p-5 text-center text-muted h-100 d-flex flex-column align-items-center justify-content-center">
                            <div class="bg-white shadow-sm rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                <i class="far fa-calendar-times fa-lg text-secondary"></i>
                            </div>
                            <h6 class="fw-bold text-dark">No Bookings Booked</h6>
                            <p class="small mb-0 text-secondary">There are no confirmed upcoming matches scheduled.</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var booking in Model.UpcomingBookings)
                            {
                                <div class="upcoming-item bg-white p-3 rounded-4 shadow-sm border-0 d-flex flex-column position-relative overflow-hidden" style="border-left: 4px solid #10b981 !important;">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="badge bg-success bg-opacity-10 text-success fw-bold">Match Day</span>
                                        <small class="text-secondary fw-bold font-monospace">#@booking.Id.ToString()[..8].ToUpper()</small>
                                    </div>
                                    <h6 class="fw-bold mb-1 text-dark">@booking.Turf?.Name</h6>
                                    <p class="text-secondary small mb-2 d-flex align-items-center">
                                        <i class="far fa-calendar-alt text-primary me-2"></i>
                                        <span>@booking.BookingDate.ToString("dd MMMM, yyyy")</span>
                                    </p>
                                    <p class="text-secondary small mb-2 d-flex align-items-center">
                                        <i class="far fa-clock text-primary me-2"></i>
                                        <strong>@booking.StartTime.ToString(@"hh\:mm") – @booking.EndTime.ToString(@"hh\:mm")</strong>
                                    </p>
                                    <div class="d-flex align-items-center mt-2 border-top pt-2 gap-2">
                                        <div class="avatar bg-secondary rounded-circle text-white d-flex align-items-center justify-content-center font-bold" style="width: 28px; height: 28px; font-size: 0.8rem; background-color: #64748b !important;">
                                            @booking.User?.FullName[0]
                                        </div>
                                        <span class="small fw-bold text-dark">@booking.User?.FullName</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .premium-hero {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            border: none;
        }

        .stats-card {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .stats-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 20px rgba(0,0,0,0.08) !important;
        }

        .fw-extrabold { font-weight: 800; }
        .ls-1 { letter-spacing: 1px; }

        .upcoming-item {
            transition: all 0.2s ease-in-out;
        }
        .upcoming-item:hover {
            transform: scale(1.02);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.05) !important;
        }
        
        .z-index-1 { z-index: 1; }
    </style>
}


