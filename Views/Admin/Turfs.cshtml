@using turf_management_system.DTOs.Common
@using turf_management_system.DTOs.Turf
@model PagedResultDto<TurfListItemDto>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Turfs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Manage Turfs</h2>
</div>

<div class="card border-0 shadow-sm p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="bg-light">
                <tr>
                    <th>Turf Name</th>
                    <th>City</th>
                    <th>Sport</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                @if (!string.IsNullOrEmpty(item.MainImageUrl))
                                {
                                    <img src="@item.MainImageUrl" class="rounded me-2" style="width: 40px; height: 40px; object-fit: cover;" />
                                }
                                <span>@item.Name</span>
                            </div>
                        </td>
                        <td>@item.City</td>
                        <td>@item.SportType</td>
                        <td>@item.PricePerHour.ToString("C")</td>
                        <td>
                            @if (item.IsApproved)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                @if (!item.IsApproved)
                                {
                                    <form asp-action="ApproveTurf" method="post">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                    </form>
                                }
                                <form asp-action="RejectTurf" method="post" onsubmit="return confirm('Are you sure you want to reject/delete this turf?')">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center mt-4">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="Turfs" asp-route-pageNumber="@(Model.PageNumber - 1)">Previous</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Turfs" asp-route-pageNumber="@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="Turfs" asp-route-pageNumber="@(Model.PageNumber + 1)">Next</a>
            </li>
        </ul>
    </nav>
</div>
