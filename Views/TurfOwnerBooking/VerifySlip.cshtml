@model turf_management_system.Models.Domain.Booking
@using turf_management_system.Models.Domain
@{
    ViewData["Title"] = "Verify Booking Slip";
    Layout = "_AdminLayout"; // Assuming TurfOwner/TurfManager use this layout
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-dark text-white rounded-top-4 p-4 text-center">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-qrcode me-2"></i>Verify Booking Slip</h4>
                </div>
                <div class="card-body p-5">
                    
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger rounded-3"><i class="fas fa-exclamation-circle me-2"></i>@ViewBag.Error</div>
                    }

                    <form method="get" class="mb-5">
                        <div class="input-group input-group-lg shadow-sm" style="border-radius: 12px; overflow: hidden;">
                            <span class="input-group-text bg-white border-0 text-muted"><i class="fas fa-search"></i></span>
                            <input type="text" name="bookingId" class="form-control border-0 shadow-none" placeholder="Enter Booking ID (e.g. 8f4d92a1-...)" required>
                            <button class="btn btn-success fw-bold px-4" type="submit">Verify</button>
                        </div>
                    </form>

                    @if (Model != null)
                    {
                        <div class="border rounded-4 p-4 bg-light">
                            <div class="text-center mb-4">
                                @if (Model.Status == BookingStatus.Confirmed)
                                {
                                    <div class="mb-3"><i class="fas fa-check-circle fa-4x text-success"></i></div>
                                    <h3 class="fw-bold text-success">VALID BOOKING</h3>
                                    <p class="text-muted">This booking is confirmed and valid for entry.</p>
                                }
                                else if (Model.Status == BookingStatus.PendingPayment)
                                {
                                    <div class="mb-3"><i class="fas fa-exclamation-triangle fa-4x text-warning"></i></div>
                                    <h3 class="fw-bold text-warning">PENDING PAYMENT</h3>
                                    <p class="text-muted">This booking has not been fully verified or paid yet.</p>
                                }
                                else
                                {
                                    <div class="mb-3"><i class="fas fa-times-circle fa-4x text-danger"></i></div>
                                    <h3 class="fw-bold text-danger">INVALID / CANCELLED</h3>
                                    <p class="text-muted">This booking is @Model.Status.ToString().</p>
                                }
                            </div>

                            <div class="row g-3">
                                <div class="col-6">
                                    <div class="text-muted small">Booking ID</div>
                                    <div class="fw-bold text-primary">#@Model.Id.ToString()[..8].ToUpper()</div>
                                </div>
                                <div class="col-6">
                                    <div class="text-muted small">Turf</div>
                                    <div class="fw-bold">@Model.Turf?.Name</div>
                                </div>
                                <div class="col-6">
                                    <div class="text-muted small">Date</div>
                                    <div class="fw-bold">@Model.BookingDate.ToString("dd MMM yyyy")</div>
                                </div>
                                <div class="col-6">
                                    <div class="text-muted small">Time</div>
                                    <div class="fw-bold">@Model.StartTime.ToString(@"hh\:mm") – @Model.EndTime.ToString(@"hh\:mm")</div>
                                </div>
                                <div class="col-6">
                                    <div class="text-muted small">Customer Name</div>
                                    <div class="fw-bold">@Model.User?.FullName</div>
                                </div>
                                <div class="col-6">
                                    <div class="text-muted small">Phone</div>
                                    <div class="fw-bold">@Model.User?.PhoneNumber</div>
                                </div>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>
