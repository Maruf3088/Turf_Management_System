@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center align-items-center min-vh-100 animate-up">
    <div class="col-md-6 text-center">
        <div class="card p-5 shadow-2xl border-0">
            <div class="text-danger mb-4">
                <i class="fas fa-user-shield fa-5x"></i>
            </div>
            <h1 class="display-font display-4 mb-3">Access Denied</h1>
            <p class="fs-5 text-muted mb-5 px-5">You've reached a restricted area. Your current account permissions do not allow viewing this page.</p>
            
            <div class="d-flex flex-column gap-3 align-items-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-5 py-3 rounded-pill w-75 fw-bold">
                    Go Back Home <i class="fas fa-home ms-2"></i>
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="w-75">
                    <button type="submit" class="btn btn-outline-danger px-5 py-3 rounded-pill w-100">
                        Sign Out & Switch Account
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .shadow-2xl { box-shadow: 0 25px 50px -12px rgba(220,38,38,0.1); }
    </style>
}
