@model turf_management_system.Models.Pagination.PagedResult<turf_management_system.Models.Domain.TurfOwner>
@{
    ViewData["Title"] = "KYC Verification Queue";
    Layout = "_AdminLayout";
}

<div class="container-fluid animate-up">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-0 text-gray-800 fw-bold">KYC Verification Queue</h2>
            <p class="text-muted mb-0">Review pending document submissions from Turf Owners</p>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Owner Name</th>
                            <th>Business Name</th>
                            <th>NID</th>
                            <th>Submitted At</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Items.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fas fa-check-circle fa-3x mb-3 text-success opacity-50"></i>
                                        <h5 class="fw-bold">All caught up!</h5>
                                        <p>There are no pending KYC applications to review.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar bg-primary-subtle text-primary fw-bold rounded-circle p-2 me-3">
                                                @(item.User?.FullName?.Substring(0, 1).ToUpper() ?? "U")
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold">@item.User?.FullName</h6>
                                                <small class="text-muted">@item.User?.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="fw-medium">@item.BusinessName</span></td>
                                    <td><span class="badge bg-light text-dark border">@item.NationalIdNumber</span></td>
                                    <td>@item.SubmittedAt?.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td class="text-end pe-4">
                                        <a asp-action="ReviewKyc" asp-route-id="@item.UserId" class="btn btn-sm btn-primary">
                                            Review Documents <i class="fas fa-arrow-right ms-1"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-top-0 py-3">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                            <a class="page-link border-0 text-dark fw-bold" asp-action="KycQueue" asp-route-pageNumber="@(Model.PageNumber - 1)">Previous</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link @(i == Model.PageNumber ? "bg-primary border-primary rounded-3" : "border-0 text-dark")" 
                                   asp-action="KycQueue" asp-route-pageNumber="@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link border-0 text-dark fw-bold" asp-action="KycQueue" asp-route-pageNumber="@(Model.PageNumber + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
