@using turf_management_system.Models.Domain
@using turf_management_system.Models.Pagination
@model PagedResult<TurfOwner>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Turf Owners";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Manage Turf Owners</h2>
</div>

<div class="card border-0 shadow-sm p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="bg-light">
                <tr>
                    <th>Business Name</th>
                    <th>Owner Name</th>
                    <th>Contact</th>
                    <th>Verified</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.BusinessName</td>
                        <td>@item.User.FullName</td>
                        <td>@item.ContactNumber</td>
                        <td>
                            @if (item.VerificationStatus == turf_management_system.Models.Enums.VerificationStatus.Approved)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else if (item.VerificationStatus == turf_management_system.Models.Enums.VerificationStatus.Pending)
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                            else if (item.VerificationStatus == turf_management_system.Models.Enums.VerificationStatus.Rejected)
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.VerificationStatus.ToString()</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="UserDetails" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-primary" title="View Details">
                                    <i class="fas fa-eye me-1"></i>View
                                </a>
                                <form asp-action="DeleteTurfOwner" method="post" onsubmit="return confirm('Are you sure you want to remove this owner? This will also deactivate their user account and disable their listings to maintain integrity.')" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.UserId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove Owner">
                                        <i class="fas fa-trash-alt me-1"></i>Remove
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center mt-4">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="TurfOwners" asp-route-pageNumber="@(Model.PageNumber - 1)">Previous</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="TurfOwners" asp-route-pageNumber="@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="TurfOwners" asp-route-pageNumber="@(Model.PageNumber + 1)">Next</a>
            </li>
        </ul>
    </nav>
</div>
