@model turf_management_system.DTOs.Turf.TurfResponseDto
@{
    Layout = "_TurfOwnerLayout";
    ViewData["Title"] = "Manage Time Slots - " + Model.Name;
}

<div class="row animate__animated animate__fadeInUp">
    <div class="col-md-12 mb-4">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a asp-action="MyTurfs">My Turfs</a></li>
                        <li class="breadcrumb-item active">Slots</li>
                    </ol>
                </nav>
                <h2 class="display-font fw-bold">@Model.Name - <span class="text-muted">Manage Time Slots</span></h2>
            </div>
            <a asp-action="MyTurfs" class="btn btn-outline-secondary btn-sm rounded-pill px-3"><i class="fas fa-arrow-left me-2"></i>Back to My Turfs</a>
        </div>
    </div>

    <!-- Left Form: Add Slot -->
    <div class="col-lg-4 mb-4">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white">
            <h4 class="display-font mb-4 fw-bold text-dark"><i class="fas fa-plus-circle text-primary me-2"></i>Add New Slot</h4>
            <form id="add-slot-form">
                <input type="hidden" name="TurfId" value="@Model.Id" />
                
                <div class="mb-3">
                    <label class="form-label fw-bold text-secondary small text-uppercase">Day of Week</label>
                    <select name="DayOfWeek" class="form-select border-2 shadow-none" id="day-selector" style="border-radius: 12px; height: 50px;">
                        <option value="">Every Day (Mon-Sun)</option>
                        <option value="1">Monday</option>
                        <option value="2">Tuesday</option>
                        <option value="3">Wednesday</option>
                        <option value="4">Thursday</option>
                        <option value="5">Friday</option>
                        <option value="6">Saturday</option>
                        <option value="0">Sunday</option>
                    </select>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Start Time</label>
                        <input type="time" name="StartTime" class="form-control border-2 shadow-none" required style="border-radius: 12px; height: 50px;" />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-bold text-secondary small text-uppercase">End Time</label>
                        <input type="time" name="EndTime" class="form-control border-2 shadow-none" required style="border-radius: 12px; height: 50px;" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-secondary small text-uppercase">Pricing Variant</label>
                    <select name="PricingVariant" class="form-select border-2 shadow-none" required style="border-radius: 12px; height: 50px;">
                        <option value="Morning">Morning Variant (৳@Model.MorningPricePerHour.ToString("F0")/hr)</option>
                        <option value="Evening">Evening Variant (৳@Model.EveningPricePerHour.ToString("F0")/hr)</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 mt-auto fw-bold" style="border-radius: 12px; background: #2563eb; border: none;">
                    <i class="fas fa-plus me-2"></i>Add Time Slot
                </button>
            </form>

            <div class="mt-4 p-4 bg-light rounded-4 border-0">
                <h6 class="fw-bold mb-2 small text-uppercase text-dark"><i class="far fa-lightbulb text-warning me-2"></i>Pro Tip</h6>
                <p class="small text-muted mb-0">Adding a slot with "Every Day" will create it for all 7 days of the week automatically.</p>
            </div>
        </div>
    </div>

    <!-- Right List/Grid: Existing Slots -->
    <div class="col-lg-8 mb-4">
        <div class="card h-100 overflow-hidden border-0 shadow-sm rounded-4 bg-white">
            <div class="card-header bg-white p-4 border-bottom d-flex justify-content-between align-items-center">
                <h4 class="display-font mb-0 fw-bold text-dark"><i class="fas fa-list text-primary me-2"></i>Existing Slots</h4>
                <div class="btn-group rounded-pill overflow-hidden border p-1" style="background-color: #f1f5f9;">
                    <button class="btn btn-sm btn-outline-secondary border-0 active rounded-pill px-3" onclick="setView('table')">Table</button>
                    <button class="btn btn-sm btn-outline-secondary border-0 rounded-pill px-3" onclick="setView('calendar')">Calendar</button>
                </div>
            </div>
            
            <div class="card-body p-0" id="slots-table-view">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr class="small text-uppercase text-muted">
                                <th class="ps-4">Day</th>
                                <th>Time Range</th>
                                <th>Pricing Model</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="slots-tbody">
                            <!-- Slots will be injected here -->
                            <tr><td colspan="5" class="text-center py-5"><span class="spinner-border text-primary"></span></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-body p-4" id="slots-calendar-view" style="display: none;">
                <div class="calendar-grid">
                    <div class="calendar-header">Mon</div>
                    <div class="calendar-header">Tue</div>
                    <div class="calendar-header">Wed</div>
                    <div class="calendar-header">Thu</div>
                    <div class="calendar-header">Fri</div>
                    <div class="calendar-header">Sat</div>
                    <div class="calendar-header">Sun</div>
                    
                    @for (int i = 0; i < 7; i++)
                    {
                        var dayNum = (i + 1) % 7;
                        <div class="calendar-day" id="day-col-@dayNum">
                            <!-- Slots for this day -->
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Slot Modal -->
<div class="modal fade" id="editSlotModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark"><i class="fas fa-edit text-primary me-2"></i>Modify Time Slot</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="edit-slot-form">
                <input type="hidden" id="edit-slot-id" name="Id" />
                <div class="modal-body p-4 bg-white">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Day of Week</label>
                        <select id="edit-day-selector" name="DayOfWeek" class="form-select border-2 shadow-none" style="border-radius: 12px; height: 50px;">
                            <option value="">Every Day (Mon-Sun)</option>
                            <option value="1">Monday</option>
                            <option value="2">Tuesday</option>
                            <option value="3">Wednesday</option>
                            <option value="4">Thursday</option>
                            <option value="5">Friday</option>
                            <option value="6">Saturday</option>
                            <option value="0">Sunday</option>
                        </select>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Start Time</label>
                            <input type="time" id="edit-start-time" name="StartTime" class="form-control border-2 shadow-none" required style="border-radius: 12px; height: 50px;" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold text-secondary small text-uppercase">End Time</label>
                            <input type="time" id="edit-end-time" name="EndTime" class="form-control border-2 shadow-none" required style="border-radius: 12px; height: 50px;" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Pricing Variant</label>
                        <select id="edit-pricing-variant" name="PricingVariant" class="form-select border-2 shadow-none" required style="border-radius: 12px; height: 50px;">
                            <option value="Morning">Morning Variant (৳@Model.MorningPricePerHour.ToString("F0")/hr)</option>
                            <option value="Evening">Evening Variant (৳@Model.EveningPricePerHour.ToString("F0")/hr)</option>
                        </select>
                    </div>
                    <div class="form-check form-switch mt-4">
                        <input class="form-check-input" type="checkbox" id="edit-is-available" name="IsAvailable" style="width: 48px; height: 24px;">
                        <label class="form-check-label fw-bold text-dark ms-2 pt-1" for="edit-is-available">Available for Customer Bookings</label>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-white pt-0 pb-4">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold" style="background: #2563eb; border: none;">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .ls-1 { letter-spacing: 0.1em; }
        
        .status-pill {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
        }
        .status-available { background: #DCFCE7; color: #166534; }
        .status-unavailable { background: #FEE2E2; color: #991B1B; }

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 12px;
            min-height: 400px;
        }
        .calendar-header {
            text-align: center;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 12px;
            color: var(--color-text-muted);
            padding-bottom: 8px;
            border-bottom: 1px solid var(--color-border);
        }
        .calendar-day {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .calendar-slot {
            background: var(--color-bg);
            border: 1px solid var(--color-border);
            border-radius: 8px;
            padding: 8px;
            font-size: 11px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
        }
        .calendar-slot:hover {
            transform: scale(1.02);
            border-color: var(--color-primary);
        }
        .calendar-slot.available { border-left: 3px solid var(--color-success); }
        .calendar-slot.unavailable { border-left: 3px solid var(--color-danger); }
    </style>
}

@section Scripts {
    <script>
        const turfId = '@Model.Id';
        let currentSlots = [];
        let editModalObj = null;

        async function loadSlots() {
            const response = await fetch(`/api/turfs/${turfId}`);
            const result = await response.json();
            
            if (result.success) {
                currentSlots = result.data.slots;
                renderTable();
                renderCalendar();
            }
        }

        function getDayName(dayNum) {
            const days = {
                1: 'Monday', 2: 'Tuesday', 3: 'Wednesday', 4: 'Thursday', 
                5: 'Friday', 6: 'Saturday', 0: 'Sunday', null: 'Every Day'
            };
            return days[dayNum] !== undefined ? days[dayNum] : 'Every Day';
        }

        function renderTable() {
            const tbody = document.getElementById('slots-tbody');
            if (currentSlots.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center py-5">No slots added yet.</td></tr>';
                return;
            }

            tbody.innerHTML = currentSlots.map(slot => {
                const dayOfWeek = slot.dayOfWeek !== undefined ? slot.dayOfWeek : slot.DayOfWeek;
                const startTime = slot.startTime || slot.StartTime;
                const endTime = slot.endTime || slot.EndTime;
                const isAvailable = slot.isAvailable !== undefined ? slot.isAvailable : slot.IsAvailable;
                const pricingVariant = slot.pricingVariant || slot.PricingVariant || 'Morning';
                const slotId = slot.id || slot.Id;

                const variantBadge = pricingVariant === 'Evening' ? 'bg-indigo text-white' : 'bg-warning text-dark';

                return `
                <tr>
                    <td class="ps-4 fw-medium">${getDayName(dayOfWeek)}</td>
                    <td class="fw-bold text-dark">${formatTime(startTime)} - ${formatTime(endTime)}</td>
                    <td>
                        <span class="badge ${variantBadge} rounded-pill px-3 py-1 font-monospace" style="${pricingVariant === 'Evening' ? 'background-color: #4f46e5; color: white;' : ''}">
                            ${pricingVariant}
                        </span>
                    </td>
                    <td>
                        <span class="status-pill ${isAvailable ? 'status-available' : 'status-unavailable'}">
                            ${isAvailable ? 'Available' : 'Unavailable'}
                        </span>
                    </td>
                    <td class="text-end pe-4">
                        <div class="d-flex justify-content-end gap-2">
                            <button class="btn btn-sm btn-outline-primary rounded-circle" onclick="openEditModal('${slotId}')" style="width: 32px; height: 32px; padding: 0;">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger rounded-circle" onclick="deleteSlot('${slotId}')" style="width: 32px; height: 32px; padding: 0;">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `;}).join('');
        }

        function renderCalendar() {
            // Clear all day columns
            for (let i = 0; i < 7; i++) {
                document.getElementById(`day-col-${i}`).innerHTML = '';
            }

            currentSlots.forEach(slot => {
                const dayOfWeek = slot.dayOfWeek !== undefined ? slot.dayOfWeek : slot.DayOfWeek;
                const daysToRender = dayOfWeek === null || dayOfWeek === undefined ? [0,1,2,3,4,5,6] : [dayOfWeek];
                
                daysToRender.forEach(day => {
                    const slotDiv = document.createElement('div');
                    const isAvailable = slot.isAvailable !== undefined ? slot.isAvailable : slot.IsAvailable;
                    const startTime = slot.startTime || slot.StartTime;
                    const endTime = slot.endTime || slot.EndTime;
                    const slotId = slot.id || slot.Id;
                    
                    slotDiv.className = `calendar-slot ${isAvailable ? 'available' : 'unavailable'}`;
                    slotDiv.innerHTML = `${formatTime(startTime)}`;
                    slotDiv.title = `${formatTime(startTime)} - ${formatTime(endTime)} (${slot.pricingVariant || slot.PricingVariant || 'Morning'})`;
                    slotDiv.onclick = () => openEditModal(slotId);
                    document.getElementById(`day-col-${day}`).appendChild(slotDiv);
                });
            });
        }

        function formatTime(timeStr) {
            const [h, m] = timeStr.split(':');
            const hour = parseInt(h);
            const ampm = hour >= 12 ? 'PM' : 'AM';
            const h12 = hour % 12 || 12;
            return `${h12}:${m} ${ampm}`;
        }

        function setView(view) {
            document.getElementById('slots-table-view').style.display = view === 'table' ? 'block' : 'none';
            document.getElementById('slots-calendar-view').style.display = view === 'calendar' ? 'block' : 'none';
            
            // Update buttons
            const btns = document.querySelectorAll('.btn-group .btn');
            btns[0].classList.toggle('active', view === 'table');
            btns[1].classList.toggle('active', view === 'calendar');
        }

        // Add Slot
        document.getElementById('add-slot-form').addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = this.querySelector('button[type="submit"]');
            btn.disabled = true;

            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());
            
            // Convert empty DayOfWeek to null
            if (data.DayOfWeek === "") data.DayOfWeek = null;
            else data.DayOfWeek = parseInt(data.DayOfWeek);

            try {
                const response = await fetch(`/api/turfs/${turfId}/slots`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();
                if (result.success) {
                    loadSlots();
                    this.reset();
                } else {
                    alert(result.message);
                }
            } catch (error) {
                alert('Error adding slot');
            } finally {
                btn.disabled = false;
            }
        });

        // Edit Slot
        function openEditModal(slotId) {
            const slot = currentSlots.find(s => (s.id || s.Id) === slotId);
            if (!slot) return;
            
            document.getElementById('edit-slot-id').value = slotId;
            
            const day = slot.dayOfWeek !== undefined ? slot.dayOfWeek : slot.DayOfWeek;
            document.getElementById('edit-day-selector').value = (day === null || day === undefined) ? "" : day;
            
            const start = slot.startTime || slot.StartTime;
            document.getElementById('edit-start-time').value = start.substring(0, 5);
            
            const end = slot.endTime || slot.EndTime;
            document.getElementById('edit-end-time').value = end.substring(0, 5);
            
            document.getElementById('edit-pricing-variant').value = slot.pricingVariant || slot.PricingVariant || 'Morning';
            
            const available = slot.isAvailable !== undefined ? slot.isAvailable : slot.IsAvailable;
            document.getElementById('edit-is-available').checked = available;
            
            editModalObj = new bootstrap.Modal(document.getElementById('editSlotModal'));
            editModalObj.show();
        }

        document.getElementById('edit-slot-form').addEventListener('submit', async function(e) {
            e.preventDefault();
            const slotId = document.getElementById('edit-slot-id').value;
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());
            
            if (data.DayOfWeek === "") data.DayOfWeek = null;
            else data.DayOfWeek = parseInt(data.DayOfWeek);
            
            data.IsAvailable = document.getElementById('edit-is-available').checked;

            try {
                const response = await fetch(`/api/turfs/slots/${slotId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();
                if (result.success) {
                    editModalObj.hide();
                    loadSlots();
                } else {
                    alert(result.message);
                }
            } catch (error) {
                alert('Error updating slot');
            }
        });

        async function deleteSlot(slotId) {
            if (!confirm('Delete this slot?')) return;
            const response = await fetch(`/api/turfs/slots/${slotId}`, { method: 'DELETE' });
            const result = await response.json();
            if (result.success) loadSlots();
        }

        // Initial Load
        loadSlots();
    </script>
}
