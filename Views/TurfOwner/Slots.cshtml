@model turf_management_system.DTOs.Turf.TurfResponseDto
@{
    Layout = "_TurfOwnerLayout";
    ViewData["Title"] = "Manage Time Slots - " + Model.Name;
    var config = ViewBag.BookingConfig as turf_management_system.Models.Domain.TurfBookingConfig;
    string openingTime = config?.OpeningTime.ToString(@"hh\:mm") ?? "06:00";
    string closingTime = config?.ClosingTime.ToString(@"hh\:mm") ?? "22:00";
    int slotDuration = config?.SlotDurationMinutes > 0 ? config.SlotDurationMinutes : 60;
    int availableDaysMask = config?.AvailableDaysMask ?? 127;
}

<div class="row animate__animated animate__fadeInUp">
    <div class="col-md-12 mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a asp-action="MyTurfs">My Turfs</a></li>
                        <li class="breadcrumb-item active">Slots</li>
                    </ol>
                </nav>
                <h2 class="display-font fw-bold">@Model.Name - <span class="text-muted">Visual Slot Manager</span></h2>
                <p class="text-secondary small mb-0">Click any box to instantly create or delete a time slot.</p>
            </div>
            <a asp-action="MyTurfs" class="btn btn-outline-secondary rounded-pill px-4 fw-bold shadow-sm"><i class="fas fa-arrow-left me-2"></i>Back</a>
        </div>
    </div>

    <!-- Visual Grid -->
    <div class="col-12 mb-4">
        <div class="card overflow-hidden border-0 shadow-sm rounded-4 bg-white">
            <div class="card-header bg-white p-4 border-bottom d-flex justify-content-between align-items-center">
                <h4 class="display-font mb-0 fw-bold text-dark"><i class="fas fa-calendar-alt text-primary me-2"></i>Weekly Slot Matrix</h4>
                <div class="d-flex gap-3 align-items-center">
                    <div class="d-flex align-items-center gap-1 small fw-bold"><span class="badge" style="background:#22c55e; width:16px; height:16px;">&nbsp;</span> Available</div>
                    <div class="d-flex align-items-center gap-1 small fw-bold"><span class="badge" style="background:#ef4444; width:16px; height:16px;">&nbsp;</span> Booked/Locked</div>
                    <div class="d-flex align-items-center gap-1 small fw-bold"><span class="badge" style="background:#f1f5f9; width:16px; height:16px; border:1px solid #cbd5e1;">&nbsp;</span> Not Created</div>
                </div>
            </div>
            
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered slot-matrix mb-0">
                        <thead>
                            <tr>
                                <th class="time-col bg-light text-center align-middle"><i class="far fa-clock"></i> Time</th>
                                @if ((availableDaysMask & 2) != 0) { <th class="text-center align-middle py-3">Monday</th> }
                                @if ((availableDaysMask & 4) != 0) { <th class="text-center align-middle py-3">Tuesday</th> }
                                @if ((availableDaysMask & 8) != 0) { <th class="text-center align-middle py-3">Wednesday</th> }
                                @if ((availableDaysMask & 16) != 0) { <th class="text-center align-middle py-3">Thursday</th> }
                                @if ((availableDaysMask & 32) != 0) { <th class="text-center align-middle py-3">Friday</th> }
                                @if ((availableDaysMask & 64) != 0) { <th class="text-center align-middle py-3">Saturday</th> }
                                @if ((availableDaysMask & 1) != 0) { <th class="text-center align-middle py-3">Sunday</th> }
                            </tr>
                        </thead>
                        <tbody id="matrix-tbody">
                            <tr><td colspan="@(Convert.ToString(availableDaysMask, 2).ToCharArray().Count(c => c == '1') + 1)" class="text-center py-5"><div class="spinner-border text-primary"></div></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .slot-matrix th {
            text-transform: uppercase;
            font-size: 0.8rem;
            font-weight: 700;
            color: #475569;
            letter-spacing: 0.05em;
        }
        .time-col {
            width: 140px;
            font-family: monospace;
            font-size: 0.9rem;
            font-weight: 600;
            color: #334155;
            white-space: nowrap;
        }
        .matrix-cell {
            padding: 0 !important;
            height: 48px;
            vertical-align: middle;
        }
        .slot-box {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.15s ease-in-out;
            background: #f8fafc; /* Not created */
            color: #94a3b8;
            font-size: 0.75rem;
            font-weight: bold;
        }
        .slot-box:hover {
            filter: brightness(0.95);
        }
        
        /* Available / Created */
        .slot-box.available {
            background: #dcfce7;
            color: #166534;
            border: 2px solid #22c55e;
        }
        .slot-box.available:hover {
            background: #bbf7d0;
            color: #15803d;
        }

        /* Booked / Red */
        .slot-box.booked {
            background: #fee2e2;
            color: #991b1b;
            border: 2px solid #ef4444;
            cursor: not-allowed;
        }
        
        .slot-box.loading {
            opacity: 0.5;
            pointer-events: none;
        }
    </style>
}

@section Scripts {
    <script>
        const turfId = '@Model.Id';
        const opTimeStr = '@openingTime';
        const clTimeStr = '@closingTime';
        const slotDuration = @slotDuration;
        const availableDaysMask = @availableDaysMask;
        
        let currentSlots = [];
        let bookedSlotIds = new Set(); // We will try to prevent deletion if booked

        // Days mapping: 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat, 0=Sun
        let daysOrder = [];
        if ((availableDaysMask & 2) !== 0) daysOrder.push(1); // Mon
        if ((availableDaysMask & 4) !== 0) daysOrder.push(2); // Tue
        if ((availableDaysMask & 8) !== 0) daysOrder.push(3); // Wed
        if ((availableDaysMask & 16) !== 0) daysOrder.push(4); // Thu
        if ((availableDaysMask & 32) !== 0) daysOrder.push(5); // Fri
        if ((availableDaysMask & 64) !== 0) daysOrder.push(6); // Sat
        if ((availableDaysMask & 1) !== 0) daysOrder.push(0); // Sun

        async function loadSlots() {
            try {
                const response = await fetch(`/api/turfs/${turfId}`);
                const result = await response.json();
                if (result.success) {
                    currentSlots = result.data.slots;
                    renderMatrix();
                }
            } catch (e) {
                console.error("Error loading slots", e);
            }
        }

        function parseTime(timeStr) {
            const [h, m] = timeStr.split(':').map(Number);
            return h * 60 + m;
        }

        function formatTimeSpan(minutes) {
            const h = Math.floor(minutes / 60);
            const m = minutes % 60;
            return `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}`;
        }
        
        function formatAmPm(timeStr) {
            const [h, m] = timeStr.split(':');
            const hour = parseInt(h);
            const ampm = hour >= 12 ? 'PM' : 'AM';
            const h12 = hour % 12 || 12;
            return `${h12}:${m} ${ampm}`;
        }

        function getPricingVariant(startTimeMins) {
            return startTimeMins >= (16 * 60) ? 'Evening' : 'Morning'; // After 4 PM is Evening
        }

        function renderMatrix() {
            const tbody = document.getElementById('matrix-tbody');
            tbody.innerHTML = '';

            const startMins = parseTime(opTimeStr);
            const endMins = parseTime(clTimeStr);
            
            let currentMins = startMins;

            while (currentMins + slotDuration <= endMins) {
                const tr = document.createElement('tr');
                const nextMins = currentMins + slotDuration;
                
                const startStr = formatTimeSpan(currentMins);
                const endStr = formatTimeSpan(nextMins);
                
                // Time column
                const tdTime = document.createElement('td');
                tdTime.className = 'time-col bg-light text-center align-middle';
                tdTime.innerHTML = `${formatAmPm(startStr)} - ${formatAmPm(endStr)}`;
                tr.appendChild(tdTime);

                // Day columns
                for (const dayNum of daysOrder) {
                    const td = document.createElement('td');
                    td.className = 'matrix-cell';
                    
                    // Find if slot exists
                    // Note: If DB has DayOfWeek == null, it applies to ALL days.
                    const existingSlot = currentSlots.find(s => {
                        const sStart = s.startTime || s.StartTime;
                        const sDay = s.dayOfWeek !== undefined ? s.dayOfWeek : s.DayOfWeek;
                        
                        // Handle time format matching "HH:mm:ss" vs "HH:mm"
                        const isTimeMatch = sStart.substring(0, 5) === startStr;
                        const isDayMatch = (sDay === dayNum || sDay === null);
                        
                        return isTimeMatch && isDayMatch;
                    });

                    const box = document.createElement('div');
                    
                    if (existingSlot) {
                        const slotId = existingSlot.id || existingSlot.Id;
                        box.className = 'slot-box available';
                        box.innerHTML = '<i class="fas fa-check-circle"></i>';
                        box.onclick = () => toggleSlot(box, slotId, null, null, null);
                    } else {
                        box.className = 'slot-box';
                        box.innerHTML = '<i class="fas fa-plus text-muted" style="opacity:0.3"></i>';
                        box.onclick = () => toggleSlot(box, null, dayNum, startStr, endStr);
                    }
                    
                    td.appendChild(box);
                    tr.appendChild(td);
                }

                tbody.appendChild(tr);
                currentMins = nextMins;
            }
        }

        async function toggleSlot(boxElement, slotId, dayNum, startStr, endStr) {
            // Visual loading state
            boxElement.classList.add('loading');
            boxElement.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

            if (slotId) {
                // DELETE SLOT
                try {
                    const response = await fetch(`/api/turfs/slots/${slotId}`, { method: 'DELETE' });
                    const result = await response.json();
                    if (result.success) {
                        // Success, reload all slots to reflect change immediately
                        await loadSlots();
                    } else {
                        alert(result.message || "Failed to delete slot. It might be booked.");
                        boxElement.classList.remove('loading');
                        boxElement.innerHTML = '<i class="fas fa-check-circle"></i>'; // restore
                    }
                } catch (e) {
                    console.error(e);
                    alert("Network error.");
                    await loadSlots();
                }
            } else {
                // CREATE SLOT
                const startMins = parseTime(startStr);
                const pricing = getPricingVariant(startMins);
                
                const data = {
                    StartTime: startStr + ":00",
                    EndTime: endStr + ":00",
                    DayOfWeek: dayNum,
                    PricingVariant: pricing
                };

                try {
                    const response = await fetch(`/api/turfs/${turfId}/slots`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const result = await response.json();
                    if (result.success) {
                        await loadSlots();
                    } else {
                        alert(result.message || "Failed to create slot.");
                        boxElement.classList.remove('loading');
                        boxElement.innerHTML = '<i class="fas fa-plus text-muted" style="opacity:0.3"></i>';
                    }
                } catch (e) {
                    console.error(e);
                    alert("Network error.");
                    await loadSlots();
                }
            }
        }

        // Init
        loadSlots();
    </script>
}
