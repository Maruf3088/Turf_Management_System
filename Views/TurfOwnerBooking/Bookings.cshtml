@model IEnumerable<turf_management_system.Models.Domain.Booking>
@using turf_management_system.Models.Domain
@{
    ViewData["Title"] = "All Bookings";
    Layout = "_TurfOwnerLayout";
    var selectedStatus = ViewBag.SelectedStatus as BookingStatus?;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">
            <i class="fas fa-calendar-alt me-2 text-success"></i>Turf Bookings
        </h4>
        <div class="d-flex gap-2">
            <a asp-action="PendingPayments" class="btn btn-warning btn-sm rounded-pill px-3">
                <i class="fas fa-clock me-1"></i>Pending Verifications
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3 shadow-sm border-0">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-3 shadow-sm border-0">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        </div>
    }

    <!-- Status Filter Bar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="Bookings" class="btn btn-sm @(selectedStatus == null ? "btn-success" : "btn-outline-secondary") rounded-pill px-3">All</a>
                @foreach (var status in Enum.GetValues<BookingStatus>())
                {
                    <a asp-action="Bookings" asp-route-status="@((int)status)"
                       class="btn btn-sm @(selectedStatus == status ? "btn-success" : "btn-outline-secondary") rounded-pill px-3">
                        @status
                    </a>
                }
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <div class="py-4">
                <i class="fas fa-calendar-times fa-4x text-muted mb-3"></i>
                <h5 class="text-muted">No bookings found for the selected status.</h5>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive bg-white rounded-4 shadow-sm">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Booking ID</th>
                        <th>Customer</th>
                        <th>Turf</th>
                        <th>Schedule</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        var statusColor = booking.Status switch
                        {
                            BookingStatus.Confirmed => "success",
                            BookingStatus.PendingPayment => "warning",
                            BookingStatus.Cancelled => "danger",
                            BookingStatus.Completed => "primary",
                            _ => "secondary"
                        };

                        <tr>
                            <td class="ps-4">
                                <span class="fw-bold text-primary">#@booking.Id.ToString()[..8].ToUpper()</span>
                                <div class="small text-muted">@booking.CreatedAt.ToString("dd MMM, hh:mm tt")</div>
                            </td>
                            <td>
                                <div class="fw-bold">@booking.User?.FullName</div>
                                <div class="small text-muted">@booking.User?.Email</div>
                            </td>
                            <td>
                                <div class="fw-bold">@booking.Turf?.Name</div>
                                <div class="small text-muted">@booking.Turf?.City</div>
                            </td>
                            <td>
                                <div class="fw-bold">@booking.BookingDate.ToString("dd MMM yyyy")</div>
                                <div class="small text-muted">@booking.StartTime.ToString(@"hh\:mm") – @booking.EndTime.ToString(@"hh\:mm") (@booking.TotalHours hrs)</div>
                            </td>
                            <td>
                                <div class="fw-bold">৳@booking.TotalAmount.ToString("F2")</div>
                                <div class="small @(booking.PaymentStatus == PaymentStatus.FullyPaid ? "text-success" : "text-warning")">
                                    @booking.PaymentStatus
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-@statusColor">@booking.Status</span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="dropdown">
                                    <button class="btn btn-light btn-sm rounded-pill" type="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-3">
                                        <li><a class="dropdown-item" asp-controller="Booking" asp-action="Confirmation" asp-route-bookingId="@booking.Id"><i class="fas fa-eye me-2 text-primary"></i>Details</a></li>
                                        @if (booking.Status == BookingStatus.Confirmed || booking.Status == BookingStatus.PendingPayment)
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form asp-action="CancelBooking" method="post" onsubmit="return confirm('Cancel this booking? This will notify the customer.')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="bookingId" value="@booking.Id">
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <i class="fas fa-times me-2"></i>Cancel Booking
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
