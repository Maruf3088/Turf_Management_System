@model (turf_management_system.Models.Domain.Turf Turf, IEnumerable<turf_management_system.Models.ViewModels.SlotAvailabilityVM> Slots)
@using turf_management_system.Models.ViewModels
@{
    ViewData["Title"] = $"Select Slot — {Model.Turf.Name}";
    var bookingDate = (DateOnly)ViewBag.BookingDate;
    var config = ViewBag.Config as turf_management_system.Models.Domain.TurfBookingConfig;
    var maxDays = config?.MaxAdvanceBookingDays ?? 30;
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Browse" class="btn btn-outline-secondary me-3 rounded-pill">
            <i class="fas fa-arrow-left"></i>
        </a>
        <div>
            <h2 class="fw-bold mb-0">@Model.Turf.Name</h2>
            <p class="text-muted mb-0"><i class="fas fa-map-marker-alt me-1 text-danger"></i>@Model.Turf.Location, @Model.Turf.City</p>
        </div>
        <div class="ms-auto text-end">
            <h4 class="fw-bold text-success mb-0">৳@Model.Turf.PricePerHour<small class="text-muted fs-6">/hr</small></h4>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Date Selector -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 p-4">
        <div class="row align-items-center g-3">
            <div class="col-md-auto">
                <label class="fw-bold mb-1 d-block text-secondary small text-uppercase tracking-wider">Select Date</label>
                <input type="date" id="datePicker"
                       class="form-control form-control-lg border-2 shadow-none"
                       value="@bookingDate.ToString("yyyy-MM-dd")"
                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                       max="@DateTime.Today.AddDays(maxDays).ToString("yyyy-MM-dd")"
                       style="border-radius: 12px; border-color: #e2e8f0; font-weight: 600;">
            </div>
            <div class="col-md-auto ms-md-4">
                <label class="fw-bold mb-1 d-block text-secondary small text-uppercase tracking-wider">Status Legends</label>
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge-slot-legend available">🟢 Available</span>
                    <span class="badge-slot-legend selected">⭐ Selected</span>
                    <span class="badge-slot-legend in-progress">⏳ In Progress</span>
                    <span class="badge-slot-legend booked">🔴 Booked</span>
                    <span class="badge-slot-legend unavailable">🚫 Unavailable</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Slots Grid -->
    <div id="slotsContainer" class="mb-5">
        @await Html.PartialAsync("_SlotGrid", Model.Slots)
    </div>
</div>

<!-- Floating Drawer for Checkout -->
<div id="checkoutDrawer" class="fixed-bottom bg-white border-top shadow-lg p-4" style="z-index: 1050; border-top: 4px solid #d97706; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); transform: translateY(100%); opacity: 0; box-shadow: 0 -10px 25px -5px rgba(0, 0, 0, 0.1);">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h5 class="fw-bold mb-1 text-dark d-flex align-items-center">
                    <span class="badge bg-warning text-dark me-2 d-flex align-items-center px-2 py-1 fs-6"><i class="fas fa-ticket-alt me-1"></i>Reserved</span>
                    <span>Greenfield Arena Selection</span>
                </h5>
                <p class="text-secondary mb-0 fs-6">
                    Slot: <strong id="drawerTime" class="text-dark"></strong> on <strong id="drawerDate" class="text-dark"></strong>.
                    Lock expires in <strong id="lockCountdown" class="text-danger fs-5 font-monospace">05:00</strong>.
                </p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="text-end me-3">
                    <span class="text-secondary small d-block">Total Price</span>
                    <h3 class="fw-extrabold text-success mb-0 fs-3" id="drawerAmount">৳0</h3>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-lg rounded-3 px-3 border-2" onclick="releaseSelectedSlot()" style="border-radius: 12px; font-weight: 600;">
                        <i class="fas fa-times me-1"></i> Cancel Selection
                    </button>
                    <a id="checkoutBtn" class="btn btn-success btn-lg rounded-3 px-4 fw-bold shadow-sm" href="#" style="border-radius: 12px; background: #059669; border: none; font-weight: 700; transition: all 0.2s;">
                        <i class="fas fa-credit-card me-2"></i> Confirm & Pay
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.slot-card {
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    border: 2px solid transparent;
}
.slot-card:hover.available {
    border-color: #059669;
    transform: translateY(-4px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1) !important;
}
.slot-card.available {
    background: #f0fdf4;
    border: 2px solid #b9f6ca;
}
.slot-card.selected {
    background: #fffbeb;
    border: 2px solid #fde047 !important;
    box-shadow: 0 4px 6px -1px rgba(217, 119, 6, 0.1) !important;
    animation: pulseGlow 2s infinite alternate;
}
.slot-card.in-progress {
    background: #f5f3ff;
    border: 2px solid #ddd6fe !important;
}
.slot-card.booked {
    background: #fef2f2;
    border: 2px solid #fecaca;
}
.slot-card.unavailable {
    background: #f8fafc;
    border: 2px solid #e2e8f0;
}
.badge-slot-legend {
    padding: 6px 14px;
    border-radius: 30px;
    font-size: 0.85rem;
    font-weight: 600;
    border: 1px solid #e2e8f0;
    display: inline-block;
}
.badge-slot-legend.available { background: #f0fdf4; color: #166534; border-color: #b9f6ca; }
.badge-slot-legend.selected { background: #fffbeb; color: #92400e; border-color: #fde047; }
.badge-slot-legend.in-progress { background: #f5f3ff; color: #5b21b6; border-color: #ddd6fe; }
.badge-slot-legend.booked { background: #fef2f2; color: #991b1b; border-color: #fecaca; }
.badge-slot-legend.unavailable { background: #f8fafc; color: #64748b; border-color: #e2e8f0; }

@@keyframes pulseGlow {
    0% { box-shadow: 0 0 0 0px rgba(217, 119, 6, 0.4); }
    100% { box-shadow: 0 0 12px 4px rgba(217, 119, 6, 0.15); }
}
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.7/signalr.min.js"></script>
    <script>
        const turfId = '@Model.Turf.Id';
        let currentDate = '@bookingDate.ToString("yyyy-MM-dd")';
        const currentUserId = @(User.Identity?.IsAuthenticated == true ? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value : "null");

        // UI State
        let activeBookingId = null;
        let activeSlotId = null;
        let countdownTimer = null;

        // ── SignalR Connection ─────────────────────────────────────────────────
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/booking")
            .withAutomaticReconnect()
            .build();

        connection.on("SlotLocked", (slotId, lockedUntil, lockedByUserId) => {
            const card = document.querySelector(`[data-slot-id="${slotId}"]`);
            if (card) {
                if (lockedByUserId === currentUserId) {
                    card.className = 'slot-card selected card border-0 shadow-sm rounded-3 p-3 text-center';
                    card.querySelector('.slot-status').textContent = '⭐ Selected';
                    card.querySelector('.slot-status').className = 'slot-status text-warning small fw-bold';
                    card.setAttribute('onclick', `handleSlotClick('${slotId}', '', '', 0, 'Selected')`);
                    card.style.cursor = 'pointer';
                    card.style.border = '2px solid #d97706';
                    card.style.backgroundColor = '#fffbeb';
                } else {
                    card.className = 'slot-card in-progress card border-0 shadow-sm rounded-3 p-3 text-center';
                    card.querySelector('.slot-status').textContent = '⏳ In Progress';
                    card.querySelector('.slot-status').className = 'slot-status text-primary small fw-bold';
                    card.onclick = null;
                    card.style.cursor = 'not-allowed';
                    card.style.opacity = '0.8';
                    card.style.border = '2px solid #6366f1';
                    card.style.backgroundColor = '#f5f3ff';
                }
            }
        });

        connection.on("SlotBooked", (slotId) => {
            const card = document.querySelector(`[data-slot-id="${slotId}"]`);
            if (card) {
                card.className = 'slot-card booked card border-0 shadow-sm rounded-3 p-3 text-center';
                card.querySelector('.slot-status').textContent = '🔴 Booked';
                card.querySelector('.slot-status').className = 'slot-status text-danger small fw-bold';
                card.onclick = null;
                card.style.cursor = 'not-allowed';
                card.style.opacity = '0.65';
                card.style.border = '2px solid #fecaca';
                card.style.backgroundColor = '#fef2f2';
            }
            if (activeSlotId === slotId) {
                hideCheckoutDrawer();
                alert("The slot you were selecting has been confirmed by someone else!");
            }
        });

        connection.on("SlotReleased", (slotId) => {
            refreshSlots();
        });

        connection.start().then(() => {
            connection.invoke("JoinTurfDateGroup", turfId, currentDate);
        });

        // ── Date Picker change ───────────────────────────────────────────────────
        document.getElementById('datePicker').addEventListener('change', function() {
            const newDate = this.value;
            connection.invoke("LeaveTurfDateGroup", turfId, currentDate);
            currentDate = newDate;
            refreshSlots(newDate);
            connection.invoke("JoinTurfDateGroup", turfId, currentDate);
            hideCheckoutDrawer();
        });

        function refreshSlots(date) {
            const d = date || currentDate;
            fetch(`/api/booking/slots/${turfId}?date=${d}`)
                .then(r => r.json())
                .then(slots => {
                    renderSlots(slots);
                });
        }

        function renderSlots(slots) {
            const container = document.getElementById('slotsContainer');
            if (!slots || slots.length === 0) {
                container.innerHTML = '<div class="text-center py-5 text-muted"><i class="fas fa-calendar-times fa-3x mb-3"></i><h5>No slots available on this day.</h5></div>';
                return;
            }
            let html = '<div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">';
            slots.forEach(slot => {
                let statusClass = '';
                let statusIcon = '';
                let statusColor = '';
                let clickable = '';

                if (slot.status === 0) { // Available
                    statusClass = 'available';
                    statusIcon = '🟢 Available';
                    statusColor = 'text-success';
                    clickable = `onclick="handleSlotClick('${slot.slotId}','${slot.startTimeDisplay}','${slot.endTimeDisplay}',${slot.price}, 'Available')" style="cursor: pointer;"`;
                } else if (slot.status === 1) { // Selected
                    statusClass = 'selected';
                    statusIcon = '⭐ Selected';
                    statusColor = 'text-warning fw-bold';
                    clickable = `onclick="handleSlotClick('${slot.slotId}','${slot.startTimeDisplay}','${slot.endTimeDisplay}',${slot.price}, 'Selected')" style="cursor: pointer; border: 2px solid #d97706; background-color: #fffbeb;"`;
                } else if (slot.status === 2) { // InProgress
                    statusClass = 'in-progress';
                    statusIcon = '⏳ In Progress';
                    statusColor = 'text-primary fw-bold';
                    clickable = `style="cursor: not-allowed; opacity: 0.8; border: 2px solid #6366f1; background-color: #f5f3ff;"`;
                } else if (slot.status === 3) { // Booked
                    statusClass = 'booked';
                    statusIcon = '🔴 Booked';
                    statusColor = 'text-danger';
                    clickable = `style="cursor: not-allowed; opacity: 0.65; border: 2px solid #fecaca; background-color: #fef2f2;"`;
                } else { // Unavailable
                    statusClass = 'unavailable';
                    statusIcon = '🚫 Unavailable';
                    statusColor = 'text-muted';
                    clickable = `style="cursor: not-allowed; opacity: 0.5;"`;
                }

                html += `<div class="col">
                    <div class="slot-card ${statusClass} card border-0 shadow-sm rounded-3 p-3 text-center" data-slot-id="${slot.slotId}" ${clickable}>
                        <div class="fw-bold fs-6 text-dark">${slot.startTimeDisplay} – ${slot.endTimeDisplay}</div>
                        <div class="text-secondary small mt-1">
                            <span class="badge bg-light text-dark border">${slot.pricingVariant}</span>
                        </div>
                        <div class="text-success fw-extrabold fs-5 mt-1">৳${slot.price.toFixed(0)}</div>
                        <div class="slot-status ${statusColor} small fw-bold mt-1">${statusIcon}</div>
                    </div>
                </div>`;
            });
            html += '</div>';
            container.innerHTML = html;
        }

        // ── Selection AJAX handlers ──────────────────────────────────────────────
        function handleSlotClick(slotId, start, end, price, currentState) {
            if (!currentUserId) {
                window.location.href = '/Account/Login?ReturnUrl=' + encodeURIComponent(window.location.pathname + window.location.search);
                return;
            }

            if (currentState === 'Available') {
                if (activeSlotId) {
                    alert("Please release your current slot selection before locking another one!");
                    return;
                }
                
                // Call SelectSlot API
                fetch('/api/booking/select-slot', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        turfId: turfId,
                        slotId: slotId,
                        bookingDate: currentDate,
                        specialRequest: ""
                    })
                })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        activeBookingId = res.bookingId;
                        activeSlotId = slotId;
                        showCheckoutDrawer(start, end, price, res.lockedUntil);
                    } else {
                        alert(res.message || "Failed to reserve the slot.");
                    }
                });
            } else if (currentState === 'Selected') {
                releaseSelectedSlot();
            }
        }

        function releaseSelectedSlot() {
            if (!activeBookingId) return;

            fetch('/api/booking/release-slot', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    bookingId: activeBookingId,
                    turfId: turfId,
                    slotId: activeSlotId,
                    bookingDate: currentDate
                })
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    hideCheckoutDrawer();
                } else {
                    alert(res.message || "Failed to release the slot.");
                }
            });
        }

        // ── Drawer Animations and State ──────────────────────────────────────────
        function showCheckoutDrawer(start, end, price, lockedUntil) {
            document.getElementById('drawerTime').textContent = `${start} – ${end}`;
            document.getElementById('drawerDate').textContent = new Date(currentDate + 'T00:00:00').toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric' });
            document.getElementById('drawerAmount').textContent = `৳${price.toFixed(0)}`;
            document.getElementById('checkoutBtn').href = `/Booking/Payment?bookingId=${activeBookingId}`;

            const drawer = document.getElementById('checkoutDrawer');
            drawer.style.transform = 'translateY(0)';
            drawer.style.opacity = '1';

            // Start countdown timer
            startLockCountdown(lockedUntil);
        }

        function hideCheckoutDrawer() {
            const drawer = document.getElementById('checkoutDrawer');
            drawer.style.transform = 'translateY(100%)';
            drawer.style.opacity = '0';

            // Reset state
            activeBookingId = null;
            activeSlotId = null;
            if (countdownTimer) clearInterval(countdownTimer);
        }

        function startLockCountdown(lockedUntilStr) {
            if (countdownTimer) clearInterval(countdownTimer);
            const expiryTime = new Date(lockedUntilStr).getTime();

            countdownTimer = setInterval(() => {
                const now = new Date().getTime();
                // SignalR/DB dates are UTC. Let's calculate difference correctly:
                // Since JavaScript Date parsed the UTC timestamp directly, this is fully timezone safe.
                const diff = expiryTime - now;

                if (diff <= 0) {
                    clearInterval(countdownTimer);
                    hideCheckoutDrawer();
                    alert("Your 5-minute reservation timer has expired. The slot has been released.");
                    refreshSlots();
                    return;
                }

                const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((diff % (1000 * 60)) / 1000);
                document.getElementById('lockCountdown').textContent = 
                    `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
            }, 1000);
        }
    </script>
}

