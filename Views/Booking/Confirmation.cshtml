@model turf_management_system.Models.Domain.Booking
@using turf_management_system.Models.Domain
@{
    ViewData["Title"] = "Booking Confirmed!";
}

<!-- Hero Section Breakout Container -->
<div class="full-width-breakout hero-wrapper position-relative overflow-hidden mb-5">
    <div class="stadium-lights-backdrop"></div>
    <div class="hero-dark-overlay"></div>
    
    <div class="container position-relative h-100 z-3 text-white">
        <div class="row justify-content-center text-center py-5">
            <div class="col-lg-8 animate-up">
                @if (Model.Status == BookingStatus.Confirmed)
                {
                    <div class="success-icon mx-auto mb-4 bg-success-gradient rounded-circle d-flex align-items-center justify-content-center shadow-lg" style="width: 100px; height: 100px;">
                        <i class="fas fa-check fa-3x text-white"></i>
                    </div>
                    <span class="badge bg-success text-white px-3 py-2 mb-3 fw-bold text-uppercase tracking-wider rounded-pill shadow-sm">
                        Booking Successful
                    </span>
                    <h1 class="display-4 fw-extrabold mb-3 tracking-tight display-font text-white">
                        You're All Set!
                    </h1>
                    <p class="fs-5 text-light-gray mb-4 fw-light">
                        Your turf has been successfully booked. Get ready for the game!
                    </p>
                }
                else if (Model.Status == BookingStatus.PendingPayment)
                {
                    <div class="mx-auto mb-4 bg-warning-gradient rounded-circle d-flex align-items-center justify-content-center shadow-lg" style="width: 100px; height: 100px;">
                        <i class="fas fa-clock fa-3x text-dark"></i>
                    </div>
                    <span class="badge bg-warning text-dark px-3 py-2 mb-3 fw-bold text-uppercase tracking-wider rounded-pill shadow-sm">
                        Payment Under Review
                    </span>
                    <h1 class="display-4 fw-extrabold mb-3 tracking-tight display-font text-white">
                        Almost There
                    </h1>
                    <p class="fs-5 text-light-gray mb-4 fw-light">
                        Your payment has been submitted and is awaiting owner verification.
                    </p>
                }
                else
                {
                    <div class="mx-auto mb-4 bg-info-gradient rounded-circle d-flex align-items-center justify-content-center shadow-lg" style="width: 100px; height: 100px;">
                        <i class="fas fa-info fa-3x text-white"></i>
                    </div>
                    <span class="badge bg-info text-white px-3 py-2 mb-3 fw-bold text-uppercase tracking-wider rounded-pill shadow-sm">
                        Status Update
                    </span>
                    <h1 class="display-4 fw-extrabold mb-3 tracking-tight display-font text-white">
                        Booking #@Model.Id.ToString()[..8].ToUpper()
                    </h1>
                    <p class="fs-5 text-light-gray mb-4 fw-light">
                        Current Status: @Model.Status
                    </p>
                }
            </div>
        </div>
    </div>
</div>

<div class="container mb-5" style="max-width: 800px; margin-top: -80px; position: relative; z-index: 10;">
    <!-- Booking Card -->
    <div class="card border-0 shadow-2xl rounded-4 mb-4 bg-white overflow-hidden animate-up" style="animation-delay: 0.1s;">
        <div class="card-header bg-dark text-white border-0 px-4 py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold"><i class="fas fa-receipt text-gold me-2"></i>Booking Details</h5>
            <span class="badge bg-@(Model.Status == BookingStatus.Confirmed ? "success" : "warning") text-@(Model.Status == BookingStatus.Confirmed ? "white" : "dark") fs-6 rounded-pill px-3">
                @Model.Status
            </span>
        </div>
        <div class="card-body p-4 p-md-5">
            @if (ViewBag.Bookings != null)
            {
                var bookingsList = ViewBag.Bookings as List<Booking>;
                @for (int i = 0; i < bookingsList.Count; i++)
                {
                    var b = bookingsList[i];
                    <div class="row g-4 @(i > 0 ? "mt-4 pt-4 border-top" : "")">
                        <div class="col-sm-6">
                            <div class="text-muted small text-uppercase fw-bold ls-1 mb-1">Booking ID</div>
                            <div class="fw-bold text-primary fs-5">#@b.Id.ToString()[..8].ToUpper()</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small text-uppercase fw-bold ls-1 mb-1">Turf</div>
                            <div class="fw-bold fs-5">@b.Turf?.Name</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small text-uppercase fw-bold ls-1 mb-1">Date</div>
                            <div class="fw-bold fs-5"><i class="far fa-calendar-alt text-gold me-2"></i>@b.BookingDate.ToString("dd MMM yyyy")</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small text-uppercase fw-bold ls-1 mb-1">Time</div>
                            <div class="fw-bold fs-5"><i class="far fa-clock text-gold me-2"></i>@b.StartTime.ToString(@"hh\:mm") – @b.EndTime.ToString(@"hh\:mm")</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small text-uppercase fw-bold ls-1 mb-1">Location</div>
                            <div class="fw-bold"><i class="fas fa-map-marker-alt text-danger me-2"></i>@b.Turf?.City</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small text-uppercase fw-bold ls-1 mb-1">Duration</div>
                            <div class="fw-bold">@b.TotalHours hrs</div>
                        </div>
                    </div>
                }
                
                <div class="bg-light rounded-4 p-4 mt-4 border border-light">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted fw-bold">Total Amount</span>
                        <span class="fw-bold fs-5">৳@bookingsList.Sum(b => b.TotalAmount).ToString("F2")</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted fw-bold">Amount Paid</span>
                        <span class="fw-bold text-success fs-5">৳@bookingsList.Sum(b => b.AmountPaid).ToString("F2")</span>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-4">
                    <div class="col-sm-6">
                        <div class="text-muted small text-uppercase fw-bold ls-1 mb-1">Booking ID</div>
                        <div class="fw-bold text-primary fs-5">#@Model.Id.ToString()[..8].ToUpper()</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small text-uppercase fw-bold ls-1 mb-1">Turf</div>
                        <div class="fw-bold fs-5">@Model.Turf?.Name</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small text-uppercase fw-bold ls-1 mb-1">Date</div>
                        <div class="fw-bold fs-5"><i class="far fa-calendar-alt text-gold me-2"></i>@Model.BookingDate.ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small text-uppercase fw-bold ls-1 mb-1">Time</div>
                        <div class="fw-bold fs-5"><i class="far fa-clock text-gold me-2"></i>@Model.StartTime.ToString(@"hh\:mm") – @Model.EndTime.ToString(@"hh\:mm")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small text-uppercase fw-bold ls-1 mb-1">Location</div>
                        <div class="fw-bold"><i class="fas fa-map-marker-alt text-danger me-2"></i>@Model.Turf?.City</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small text-uppercase fw-bold ls-1 mb-1">Duration</div>
                        <div class="fw-bold">@Model.TotalHours hrs</div>
                    </div>
                </div>
                
                <div class="bg-light rounded-4 p-4 mt-4 border border-light">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted fw-bold">Total Amount</span>
                        <span class="fw-bold fs-5">৳@Model.TotalAmount.ToString("F2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted fw-bold">Amount Paid</span>
                        <span class="fw-bold text-success fs-5">৳@Model.AmountPaid.ToString("F2")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted fw-bold">Payment Status</span>
                        <span class="badge bg-@(Model.PaymentStatus == PaymentStatus.FullyPaid ? "success" : "warning") text-@(Model.PaymentStatus == PaymentStatus.FullyPaid ? "white" : "dark") px-3 py-1 rounded-pill">
                            @Model.PaymentStatus
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Payment History -->
    @if (ViewBag.Bookings != null)
    {
        var bookingsList = ViewBag.Bookings as List<Booking>;
        var payments = bookingsList.SelectMany(b => b.Payments).ToList();
        if (payments.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 mb-5 animate-up" style="animation-delay: 0.2s;">
                <div class="card-header bg-white border-bottom px-4 py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-history text-muted me-2"></i>Payment History</h5>
                </div>
                <div class="list-group list-group-flush rounded-bottom-4">
                    @foreach (var payment in payments)
                    {
                        <div class="list-group-item px-4 py-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold fs-6">@payment.PaymentMethod</div>
                                    <small class="text-muted font-monospace bg-light px-2 py-1 rounded">TX: @payment.TransactionId</small>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold fs-5">৳@payment.Amount.ToString("F2")</div>
                                    <span class="badge bg-@(payment.Status == PaymentVerificationStatus.Verified ? "success" : payment.Status == PaymentVerificationStatus.Pending ? "warning" : "danger") rounded-pill">
                                        @payment.Status
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else if (Model.Payments.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 mb-5 animate-up" style="animation-delay: 0.2s;">
            <div class="card-header bg-white border-bottom px-4 py-3">
                <h5 class="mb-0 fw-bold"><i class="fas fa-history text-muted me-2"></i>Payment History</h5>
            </div>
            <div class="list-group list-group-flush rounded-bottom-4">
                @foreach (var payment in Model.Payments)
                {
                    <div class="list-group-item px-4 py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold fs-6">@payment.PaymentMethod</div>
                                <small class="text-muted font-monospace bg-light px-2 py-1 rounded">TX: @payment.TransactionId</small>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold fs-5">৳@payment.Amount.ToString("F2")</div>
                                <span class="badge bg-@(payment.Status == PaymentVerificationStatus.Verified ? "success" : payment.Status == PaymentVerificationStatus.Pending ? "warning" : "danger") rounded-pill text-@(payment.Status == PaymentVerificationStatus.Verified ? "white" : "dark")">
                                    @payment.Status
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Action Buttons -->
    <div class="d-flex gap-3 justify-content-center flex-wrap animate-up" style="animation-delay: 0.3s;">
        @if (Model.Status == BookingStatus.Confirmed)
        {
            <a asp-action="DownloadSlip" asp-route-bookingId="@Model.Id" class="btn btn-gold btn-lg rounded-pill px-4 shadow-md fw-bold" target="_blank">
                <i class="fas fa-download me-2"></i>Download Slip
            </a>
        }
        <a asp-action="MyBookings" class="btn btn-outline-dark btn-lg rounded-pill px-4 fw-bold">
            <i class="fas fa-list me-2"></i>My Bookings
        </a>
        <a asp-action="Browse" class="btn btn-dark btn-lg rounded-pill px-4 shadow-sm fw-bold">
            <i class="fas fa-search me-2"></i>Book Another Turf
        </a>
    </div>
</div>

@section Styles {
    <style>
        /* Breakout CSS */
        .full-width-breakout {
            width: 100vw;
            position: relative;
            left: 50%;
            right: 50%;
            margin-left: -50vw;
            margin-right: -50vw;
        }

        .hero-wrapper {
            background: #0f1c18;
            padding: 60px 0 140px;
        }

        .stadium-lights-backdrop {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(135deg, rgba(26,60,52,0.95), rgba(15,28,24,0.98)), 
                        url('https://images.unsplash.com/photo-1508098682722-e99c43a406b2?auto=format&fit=crop&q=80&w=1920');
            background-size: cover;
            background-position: center;
            opacity: 0.9;
        }

        .hero-dark-overlay {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: radial-gradient(circle at center, rgba(201,168,76,0.15), transparent 70%);
            pointer-events: none;
        }

        .text-gold {
            color: #C9A84C;
        }

        .bg-success-gradient {
            background: linear-gradient(135deg, #10b981, #059669);
        }
        
        .bg-warning-gradient {
            background: linear-gradient(135deg, #f59e0b, #d97706);
        }
        
        .bg-info-gradient {
            background: linear-gradient(135deg, #3b82f6, #2563eb);
        }

        .btn-gold {
            background: linear-gradient(135deg, #E5BA44, #C9A84C);
            border: none;
            color: #0f1c18 !important;
            transition: all 0.3s;
        }

        .btn-gold:hover {
            background: linear-gradient(135deg, #F0CC5F, #B8952F);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(201,168,76,0.4) !important;
        }

        .shadow-2xl {
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
        }

        .ls-1 {
            letter-spacing: 1px;
        }
        
        .animate-up {
            animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            opacity: 0;
            transform: translateY(20px);
        }
        
        @@keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
}
