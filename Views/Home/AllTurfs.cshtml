@using turf_management_system.DTOs.Common
@using turf_management_system.DTOs.Turf
@model PagedResultDto<TurfListItemDto>
@{
    ViewData["Title"] = "All Turfs";
}

<div class="container py-5">
    <div class="row mb-5 align-items-center">
        <div class="col-md-6">
            <h1 class="display-5 fw-bold mb-0" style="color: var(--primary-green);">All Available Turfs</h1>
            <div class="bg-success mt-2" style="width: 60px; height: 4px;"></div>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <p class="text-muted mb-0">Showing @Model.TotalCount results</p>
        </div>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm p-4 mb-5 bg-white rounded-4">
        <form asp-action="AllTurfs" method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-bold small text-uppercase">Search</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control bg-light border-0" placeholder="Turf name..." value="@ViewContext.HttpContext.Request.Query["search"]">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-uppercase">City</label>
                <select name="city" class="form-select bg-light border-0">
                    <option value="">All Cities</option>
                    <option value="Dhaka">Dhaka</option>
                    <option value="Chittagong">Chittagong</option>
                    <option value="Sylhet">Sylhet</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-uppercase">Sport</label>
                <select name="sportType" class="form-select bg-light border-0">
                    <option value="">All Sports</option>
                    <option value="Football">Football</option>
                    <option value="Cricket">Cricket</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-success w-100 rounded-pill py-2 fw-bold">Apply Filters</button>
            </div>
        </form>
    </div>

    <div class="row g-4">
        @if (Model.Items != null && Model.Items.Any())
        {
            @foreach (var turf in Model.Items)
            {
                <div class="col-md-4 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm overflow-hidden hover-up rounded-4">
                        <div class="position-relative">
                            @if (!string.IsNullOrEmpty(turf.MainImageUrl))
                            {
                                <img src="@turf.MainImageUrl" class="card-img-top" style="height: 180px; object-fit: cover;" alt="@turf.Name">
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center" style="height: 180px;">
                                    <i class="fas fa-image fa-2x text-muted opacity-25"></i>
                                </div>
                            }
                            <div class="position-absolute bottom-0 start-0 m-3">
                                <span class="badge bg-white text-dark rounded-pill px-3 py-2 shadow-sm fw-bold">@turf.PricePerHour.ToString("C")/hr</span>
                            </div>
                        </div>
                        <div class="card-body p-3">
                            <h5 class="card-title fw-bold mb-1">@turf.Name</h5>
                            <p class="text-muted small mb-2"><i class="fas fa-map-marker-alt me-1 text-success"></i> @turf.City</p>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="badge bg-light text-success border border-success border-opacity-25 px-2 py-1">@turf.SportType</span>
                                <a href="#" class="btn btn-outline-success btn-sm rounded-pill px-3">Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="py-5">
                    <i class="fas fa-search fa-4x text-muted mb-4 opacity-25"></i>
                    <h3 class="fw-bold">No turfs found</h3>
                    <p class="text-muted">Try adjusting your filters or search terms.</p>
                    <a asp-action="AllTurfs" class="btn btn-success rounded-pill px-4 mt-3">Clear Filters</a>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-5">
            <ul class="pagination justify-content-center">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link border-0 shadow-sm rounded-circle mx-1" asp-action="AllTurfs" asp-route-pageNumber="@(Model.PageNumber - 1)">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link border-0 shadow-sm rounded-circle mx-1 @(i == Model.PageNumber ? "bg-success" : "")" asp-action="AllTurfs" asp-route-pageNumber="@i">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link border-0 shadow-sm rounded-circle mx-1" asp-action="AllTurfs" asp-route-pageNumber="@(Model.PageNumber + 1)">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
