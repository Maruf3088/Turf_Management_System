@model turf_management_system.Models.ViewModels.UserListVM
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">User Management</h2>
    <div class="d-flex gap-2">
        <form class="d-flex" method="get">
            <div class="input-group">
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search users...">
                <button class="btn btn-success" type="submit"><i class="fas fa-search"></i></button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="bg-light">
                <tr>
                    <th>#</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.PagedUsers.Items)
                {
                    <tr>
                        <td>@user.UserId</td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded-circle p-2 me-2">
                                    <i class="fas fa-user text-muted"></i>
                                </div>
                                <strong>@user.FullName</strong>
                            </div>
                        </td>
                        <td>@user.Email</td>
                        <td>@user.PhoneNumber</td>
                        <td>
                            <span class="badge @(user.Role.RoleName == "Admin" ? "bg-warning text-dark" : "bg-info text-white")">
                                @user.Role.RoleName
                            </span>
                        </td>
                        <td>
                            <span class="badge @(user.IsActive ? "badge-active" : "badge-inactive")">
                                @(user.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-end">
                            <form asp-action="ToggleStatus" method="post" style="display:inline;">
                                <input type="hidden" name="userId" value="@user.UserId" />
                                <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")" 
                                        title="@(user.IsActive ? "Deactivate" : "Activate")">
                                    <i class="fas @(user.IsActive ? "fa-user-slash" : "fa-user-check")"></i>
                                </button>
                            </form>
                            <button class="btn btn-sm btn-outline-primary"><i class="fas fa-eye"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    @if (Model.PagedUsers.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.PagedUsers.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Users" 
                       asp-route-pageNumber="@(Model.PagedUsers.PageNumber - 1)" 
                       asp-route-searchTerm="@Model.SearchTerm">Previous</a>
                </li>
                
                @for (int i = 1; i <= Model.PagedUsers.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PagedUsers.PageNumber ? "active" : "")">
                        <a class="page-link @(i == Model.PagedUsers.PageNumber ? "bg-success border-success" : "")" 
                           asp-action="Users" asp-route-pageNumber="@i" 
                           asp-route-searchTerm="@Model.SearchTerm">@i</a>
                    </li>
                }

                <li class="page-item @(Model.PagedUsers.PageNumber == Model.PagedUsers.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Users" 
                       asp-route-pageNumber="@(Model.PagedUsers.PageNumber + 1)" 
                       asp-route-searchTerm="@Model.SearchTerm">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
